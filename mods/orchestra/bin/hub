    src.add_argument("--repo")
    mc.set_defaults(fn=cmd_memory)
    rb = sub.add_parser("rebase")
    rb.add_argument("id")
    rb.set_defaults(fn=cmd_rebase)
    vf = sub.add_parser("verify")
    vf.add_argument("id")
    vf.add_argument("--or-command", metavar="CMD", help="falls .herdr/verify.sh fehlt (vor dem Ticket-Feld verify)")
    vf.set_defaults(fn=cmd_verify)
    gt = sub.add_parser("gate")
    gt.add_argument("id")
    gt.add_argument("--json", action="store_true")
    gt.set_defaults(fn=cmd_gate)
    gts = sub.add_parser("gates")
    gts.add_argument("--json", action="store_true", help="JSON (Standard)")
    gts.add_argument("--all", action="store_true", help="auch fremde Spaces")
    gts.add_argument("--space", metavar="ID|NAME")
    gts.set_defaults(fn=cmd_gates)
    ls = sub.add_parser("lesson").add_subparsers(dest="lcmd", required=True)
    la = ls.add_parser("add")
    la.add_argument("target", metavar="repo|ticket")
    la.add_argument("--from", dest="source", required=True, choices=LESSON_SOURCES)
    la.add_argument("--ticket")
    la.add_argument("--on")
    la.add_argument("text", nargs="+", metavar="TEXT")
    la.set_defaults(fn=cmd_lesson_add)
    ll = ls.add_parser("list")
    ll.add_argument("target", metavar="repo|ticket")
    ll.add_argument("--on")
    ll.add_argument("--last", type=int)
    ll.add_argument("--pending", action="store_true", help="die Vorschläge statt der Lehren zeigen")
    ll.add_argument("--json", action="store_true")
    ll.set_defaults(fn=cmd_lesson_list)
    lp = ls.add_parser("propose")
    lp.add_argument("id")
    lp.add_argument("text", nargs="+", metavar="TEXT")
    lp.set_defaults(fn=cmd_lesson_propose)
    lc = ls.add_parser("confirm")
    lc.add_argument("id")
    lc.set_defaults(fn=cmd_lesson_confirm)
    rs = sub.add_parser("review-start")
    rs.add_argument("id")
    rs.add_argument("--agent", default=None,
                    help="Reviewer; Standard ist ein anderes Programm als der Umsetzer")
    rs.add_argument("--restart", action="store_true",
                    help="eine offene Prüfstation beenden und einen neuen Reviewer starten")
    rs.set_defaults(fn=cmd_review_start)
    rvd = sub.add_parser("review-verdict")
    rvd.add_argument("id")
    rvd.add_argument("--verdict", required=True, choices=["pass", "fail"])
    rvd.add_argument("--summary", required=True)
    rvd.set_defaults(fn=cmd_review_verdict)

    rv = sub.add_parser("review")
    rv.add_argument("id")
    rv.add_argument("--summary", required=True)
    rv.add_argument("--evidence", action="append", default=[], metavar="PATH")
    rv.add_argument("--force", action="store_true")
    rv.add_argument("--reason", default="", metavar="TEXT")
    rv.set_defaults(fn=cmd_review)
    dn = sub.add_parser("done")
    dn.add_argument("id")
    dn.add_argument("--keep-worktree", action="store_true", help="den sauberen Worktree stehen lassen")
    dn.add_argument("--keep-space", action="store_true", help="Space und Tab des Tickets offen lassen")
    dn.set_defaults(fn=cmd_done)
    ld = sub.add_parser("land")
    ld.add_argument("id")
    how = ld.add_mutually_exclusive_group(required=True)
    how.add_argument("--merge", action="store_true")
    how.add_argument("--pr", action="store_true")
    ld.add_argument("--wait-ci", action="store_true")
    ld.add_argument("--keep-worktree", action="store_true", help="den sauberen Worktree stehen lassen")
    ld.add_argument("--keep-space", action="store_true", help="Space und Tab des Tickets offen lassen")
    ld.add_argument("--lesson", action="append", metavar="TEXT",
                    help="Lehre für dieses Repo schreiben und im Verlauf nennen (mehrfach möglich)")
    ld.add_argument("--force", action="store_true", help="CI-Gate beim --merge überfahren (verlangt --reason)")
    ld.add_argument("--reason", default="", metavar="TEXT")
    ld.set_defaults(fn=cmd_land)
    ci = sub.add_parser("ci")
    ci.add_argument("id")
    ci.set_defaults(fn=cmd_ci)
    cl = sub.add_parser("cleanup")
    cl.add_argument("--yes", action="store_true", help="wirklich löschen; ohne --yes nur Dry-Run")
    cl.add_argument("--root", metavar="PATH", help="Worktree-Wurzel (Standard $HOME/.herdr/worktrees)")
    cl.add_argument("--all", action="store_true", help="auch fremde Spaces")
    cl.add_argument("--space", metavar="ID|NAME")
    cl.set_defaults(fn=cmd_cleanup)
    st = sub.add_parser("status", help="offene Tickets; Standard sind die eigenen")
    st.add_argument("--all", action="store_true", help="auch fremde Spaces")
    st.add_argument("--space", metavar="ID|NAME")
    st.add_argument("--json", action="store_true", help="alle Tickets als JSON (defekte Dateien als invalid)")
    st.set_defaults(fn=cmd_status)
    stt = sub.add_parser("stats")
    stt.add_argument("--json", action="store_true")
    stt.add_argument("--days", type=int, default=14, metavar="N")
    stt.add_argument("--all", action="store_true", help="auch fremde Spaces")
    stt.add_argument("--space", metavar="ID|NAME")
    stt.set_defaults(fn=cmd_stats)
    tml = sub.add_parser("timeline")
    tml.add_argument("--json", action="store_true")
    tml.add_argument("--since", default="all", metavar="24h|7d|all")
    tml.add_argument("--ticket", default="", metavar="ID")
    tml.add_argument("--all", action="store_true", help="auch fremde Spaces")
    tml.add_argument("--space", metavar="ID|NAME")
    tml.add_argument("--write", action="store_true", help="auch data/orchestra/timeline.html schreiben")
    tml.set_defaults(fn=cmd_timeline)
    a = p.parse_args()
    a.fn(a)


main()
