#!/usr/bin/env python3
"""hub: the orchestrator's toolkit. Tickets live as Quests' local tickets
(~/.config/herdr-app/data/quests/tickets/<id>.md, `---` frontmatter + markdown body);
team agents run in their own git worktree and Herdr space, started with `hc run`
from the orchestrator's terminal, so they are its children (hc types their
reports into it) and show in the Team-Panel under it.

  hub ticket new --title T --repo PATH [--on MACHINE] [--labels a,b] [--source URL] [--body TEXT | --body-file F | -]
  hub ticket list [--all] [--json] [--agent NAME]   open tickets (--all: done too)
  hub ticket show ID                        including the ## Verlauf section
  hub ticket set ID key=value ...           e.g. status=todo, repo=/path
  hub ticket comment ID --from ROLE "text"  append to ## Verlauf (ROLE: orchestrator, agent name,
                                            mensch); @name in text becomes a tag
  hub ticket assign ID AGENT                who is to work on it
  hub ticket link ID --blocked-by ID ...    dependencies; dispatch refuses while one is not done
  hub ticket next AGENT                     the next startable ticket (todo, assigned, unblocked)
  hub ticket inbox AGENT [--json]           tickets naming (@), assigning or waiting on AGENT
  hub ticket watch ID --on AGENT            "waiting for an answer from @AGENT"
  hub agent list [--json]                   the roster: named agents with role, program, model, repo
  hub agent show NAME [--json]              every field: harness, prompt, skills, MCP, sandbox, WIP, permissions
  hub agent add NAME [--name N] [--role R] [--program omp|claude|codex|pi] [--model M] [--repo PATH]
                [--branch-prefix P] [--labels a,b] [--notes T] [--color c1..c6]
                [--prompt-file PATH | --prompt TEXT] [--smol M] [--slow M] [--models a,b]
                [--approval-mode always-ask|always-ask-cached|write|yolo] [--max-cost USD]
                [--no-lsp|--lsp] [--skills a,b] [--mcp a,b] [--sandbox worktree|repo]
                [--wip N] [--push|--no-push] [--delete-branches|--no-delete-branches]
  hub agent edit NAME [--name NEW] [same options]     unset fields stay as they are
  hub agent rm NAME
  hub agent command NAME                    the exact start command: program + harness flags
  hub agent prompt NAME                     the agent's prompt text (agents/prompts/<slug>.md)
  hub dispatch ID [--agent omp|claude|codex|<roster name>|"cmd args"] [--no-worktree] [--branch B] [--no-lessons]
                                            [--force --reason TEXT]
                                            with a roster name: its programmed command (harness flags
                                            the program knows), its repo and branch prefix, the prompt
                                            as "## Deine Rolle", skills/MCP/permissions as "## Umgebung",
                                            and the agent's WIP gate (tickets in doing). Writes base and
                                            base_head (the base's commit at the start); appends the repo's
                                            last 8 lessons (## Was hier schon schiefging) unless --no-lessons.
                                            Refuses a ticket without an acceptance criterion (see hub spec)
                                            and while the In-Arbeit stage holds its WIP limit (hub wip);
                                            --force needs --reason and writes it to the Verlauf
  hub whoami                                this terminal's orchestrator, its space, its open
                                            tickets and its WIP counts (JSON)
  hub spaces [--json] [--agents] [--adopt [--to ID|NAME] [--yes]]
                                            one factory per Herdr space: id, name, folder, machine,
                                            its orchestrator and whether it lives, open tickets per
                                            stage, cost. Agent-Spaces of tickets are hidden unless
                                            --agents (then with the ticket's workspace). --adopt
                                            writes `space`/`space_name` on old
                                            tickets by their repo's folder (dry run without --yes);
                                            --to also assigns what no folder explains
  hub orchestrator start [--space ID|NAME] [--agent PROGRAMM] [--restart]
                                            start an orchestrator terminal in that space (cwd
                                            ~/.herdr/orchestrator, labels hub.role=orchestrator and
                                            hub.space=<id>); refuses while one runs there, --restart
                                            replaces it. hub orchestrator list [--json] shows all
  hub wip [--json] [--all] [--space ID] [--mine]
                                            the WIP limits for In Arbeit and Prüfung (default 3/2,
                                            data/orchestra/wip.json); `hub wip arbeit=4 pruefung=2` sets
                                            the default for new spaces, `--mine` only this one
                                            (mine: {<space>: {...}}, old terminal keys still read);
                                            counted per space, --all is the global sum
  hub spec ID                               complete the ticket's ## Ziel, ## Abnahmekriterien and
                                            ## Grenzen as a template (existing sections stay) and show them
  hub triage ID [--apply] [--json]          type (bug/feature/chore), size (S/M/L) and priority
                                            (p1/p2/p3) from title and text; --apply writes the fields
                                            and labels, completes missing spec sections and stamps
                                            `triaged`. Dispatch requires it for tickets with `source`.
  hub preflight ID [--json]                 checkout base/base_head in a throwaway worktree, run
                                            .herdr/verify.sh (or the ticket's verify) there, drop the
                                            worktree and record pass|fail, at, head, duration and the
                                            last 10 lines under ## Preflight. Dispatch refuses a red
                                            base and runs a missing preflight
  hub stalls [--json] [--all] [--doing MIN] [--review MIN] [--todo MIN]
                                            tickets older than the threshold (default 45/120/1440
                                            minutes) in In Arbeit, Prüfung and Geplant, grouped
  hub nudge ID [--text TEXT] [--force]      ask the ticket's live agent for its state (hc send) and
                                            write "Stand abgefragt" as an orchestrator comment;
                                            another orchestrator's ticket needs --force
  hub night [--until HH:MM] [--for MIN] [--max N] [--dry-run] [--all]
                                            dispatch startable tickets one at a time (priority first),
                                            respecting blocked_by, spec, stage and agent WIP; stops at
                                            the deadline, --max or when nothing starts; writes
                                            ## Nachtschicht into the started tickets
  hub memory add --agent NAME|--repo PATH [--ticket ID] "text"
                                            append "- date · ticket · text" to agents/memory/<name>.md
                                            or <repo>/.herdr/memory.md (at most 60 lines, oldest drop)
  hub memory list [--agent NAME|--repo PATH] [--json]
  hub memory clear [--agent NAME|--repo PATH]
                                            dispatch appends the agent's last 5 entries as
                                            "## Was du hier gelernt hast"
  hub rebase ID                             rebase the ticket's branch in its worktree onto its base;
                                            a conflict stops with exit 1, names the files and leaves
                                            the worktree in the rebase for the agent to resolve
  hub lesson add <repo|ticket> --from review|human|ci "text"
                                            append to <repo>/.herdr/lessons.md (at most 40 lines, oldest drop)
  hub lesson list <repo|ticket> [--json] [--last N]
  hub lesson propose ID "text"              the orchestrator's suggestion after feedback (waits for the human)
  hub lesson confirm ID                     the human's OK in the Review window: writes it as a lesson
  hub verify ID [--or-command CMD]     run the repo's check in the ticket's worktree, on its machine:
                                            .herdr/verify.sh (else the ticket's `verify` command, --or-command);
                                            records checks pass|fail, exit code, duration, checks_head
                                            and the last 20 lines under ## Prüfung
  hub gate ID [--json]                 do the recorded check and the reviewer's verdict still count?
                                            checks pass on checks_head = HEAD, verdict pass on review_head = HEAD
  hub gates [--json]                   the same for every open ticket (Team panel)
  hub review-start ID [--agent ...] [--restart]
                                            Prüfstation: startet einen zweiten Agent (Standard: anderes Modell
                                            als der Umsetzer) im Worktree review-<id> auf dessen Branch;
                                            er liest <base>...HEAD, prüft die Abnahmekriterien des Tickets
                                            und schreibt Befunde als Kommentar (--from review) sowie sein
                                            Urteil (`hub review-verdict`). Eine offene Runde (gestartet,
                                            kein Urteil) verweigert einen zweiten Start; --restart beendet
                                            den laufenden Reviewer und startet einen neuen. Nach einem
                                            Urteil beginnt ein neuer Lauf eine neue Runde
  hub review-verdict ID --verdict pass|fail --summary TEXT
                                            das Urteil des Reviewers, gültig für den HEAD des Worktrees;
                                            ein neuer Commit macht es ungültig; fail setzt das Ticket auf
                                            doing, schickt den Hinweis an den Umsetzer und zählt
                                            review_rounds
  hub review ID --summary TEXT [--evidence PATH]... [--force --reason TEXT]
                                            ready for the human: status review + summary; refuses unless
                                            `hub verify` passed and the reviewer's verdict is pass on the
                                            worktree's HEAD and the Definition of Done holds (criteria,
                                            checks, station, CI, evidence, a closing Verlauf report);
                                            --force needs --reason and writes it to the
                                            Verlauf; --evidence replaces the files
  hub land ID --merge | --pr [--wait-ci] [--lesson "text"]... [--force --reason TEXT]
                                            after acceptance: merge into its base branch, or push and open a
                                            pull request (gh); then end its agent and remove its worktree.
                                            --merge refuses when `ci` is red or its recorded `ci_head` is
                                            not the worktree's HEAD; --force needs --reason and writes it
                                            to the Verlauf. --wait-ci polls the PR's checks (30 s, max
                                            20 min) and only finishes a green ticket; --lesson writes the
                                            lesson and names it in the ticket's Verlauf
  hub ci ID                                 gh pr checks for the ticket's PR: pass|fail|running|unknown in
                                            the ticket, bound to the worktree's HEAD as `ci_head`;
                                            failures as a Verlauf comment (--from ci) and back to the agent
  hub done ID [--keep-worktree] [--keep-space]
                                            accepted without landing; ends the agent, removes the
                                            clean worktree and closes the ticket's space/tab (branch
                                            stays); the flags keep one of them
  hub cleanup [--yes] [--root PATH] [--all] remove this home's leftovers: worktrees it derived from
                                            its tickets' repo+branch, review checkouts, spaces without
                                            live terminals, finished agents older than an hour; without
                                            --yes only a dry run. --root defaults to
                                            $HOME/.herdr/worktrees and is never searched beyond the
                                            tickets' own paths
  hub status [--all] [--space ID|NAME] [--json]
                                            tickets with their spaces, agents' live status, owner, CI,
                                            age (since the last status change) and cost so far;
                                            standard are this factory's tickets (--space: that one,
                                            --space ""|none: only tickets without a workspace,
                                            --all: every space); done tickets are listed only while
                                            something is left, and a footer names the tickets without
                                            a workspace. Files without frontmatter are skipped and
                                            named once on stderr; --json carries them as
                                            {"id": …, "invalid": true}
  hub stats [--json] [--days 14] [--all] [--space ID|NAME]
                                            throughput per space, ticket, station and repo: lead time
                                            (todo→done), review rounds, rework (back to doing after
                                            review) and cost, with today's numbers and the last 7 days
  hub timeline [--json] [--space ID|NAME] [--all] [--since 1h|30m|7d|all] [--ticket ID] [--write]
                                            the workflow as lanes: one per terminal (agent, reviewer)
                                            plus each space's orchestrator, with start/end (live = now),
                                            parent, ticket, space, status, cost, its events and
                                            subagents, built from data/orchestra/events.jsonl, the
                                            tickets' status_log and one `hc ls --all` snapshot per
                                            call (no `hc get` per ticket). --since
                                            takes a positive window (1h, 30m, 7d) or all; 0h/0m is
                                            rejected; --write also writes the self-contained
                                            data/orchestra/timeline.html and prints its path
Python 3, standard library only.
"""
import argparse, contextlib, datetime, fcntl, html, json, os, pwd, re, secrets, shlex, subprocess, sys, time, unicodedata

APP = os.environ.get("HERDR_APP_HOME") or os.path.expanduser("~/.config/herdr-app")
TICKETS = os.path.join(APP, "data", "quests", "tickets")
FIELDS = ["title", "status", "repo", "labels", "due", "machine", "owner", "agent", "agent_cmd", "harness", "branch", "base", "base_head", "worktree", "terminal",
          "space", "space_name", "agent_space", "tab", "source", "type", "size", "priority", "triaged",
          "preflight", "preflight_at", "preflight_head", "preflight_duration",
          "checks", "checks_head", "checks_at", "checks_duration", "checks_exit", "checks_cmd", "verify",
          "evidence", "merged", "pr", "ci", "ci_head", "ci_at", "ci_url", "ci_details",
          "review", "review_head", "review_at", "review_summary", "review_rounds", "reviewer", "reviewer_name", "review_terminal",
          "assignee", "blocked_by", "tags", "waiting", "by", "updated", "created", "status_at", "status_log"]
# The stages the rest of the app knows (board, team panel, inbox, tiers). A ticket in any
# other state disappears from every view, so `hub ticket set` refuses it up front.
STATUSES = ("todo", "doing", "review", "done", "blocked")
COSTS = os.path.join(APP, "data", "orchestra", "costs.json")  # written by the Team panel's watcher
# WIP limits: hub is the only writer, so they live in a file next to costs.json, not in
# the UI's shared state. The Board reads them through `hub wip --json`.
WIP = os.path.join(APP, "data", "orchestra", "wip.json")
WIP_STAGES = {"arbeit": "doing", "pruefung": "review"}
WIP_DEFAULTS = {"arbeit": 3, "pruefung": 2}
AGENTS = {"omp": ["omp"], "claude": ["claude"], "codex": ["codex", "--no-daemon"], "pi": ["pi"]}
AGENT_NAMES = {"omp": "Oh My Pi", "claude": "Claude", "codex": "Codex", "pi": "Pi"}
# The roster: agents the person named once (role, program, model, repo, branch prefix,
# labels, notes, colour) and dispatches again and again by name. Versioned with the
# config, so it lives in agents/roster.json under APP, not in data/.
ROSTER = os.path.join(APP, "agents", "roster.json")
ROSTER_FIELDS = ["name", "role", "program", "model", "repo", "branch_prefix", "labels", "notes", "color",
                 "prompt", "harness", "skills", "mcp", "sandbox", "wip", "permissions"]
ROSTER_DEFAULTS = {"name": "", "role": "", "program": "omp", "model": "", "repo": "",
                   "branch_prefix": "feat/", "labels": [], "notes": "", "color": "c1",
                   "prompt": "", "sandbox": "worktree", "wip": 1}
ROSTER_COLORS = ["c1", "c2", "c3", "c4", "c5", "c6"]
# Harness: what the program starts with. Every field is optional; empty means the
# program's own default, so an entry only carries the flags the person set.
HARNESS_FIELDS = ["smol", "slow", "approval_mode", "max_cost", "models", "no_lsp"]
HARNESS_DEFAULTS = {"smol": "", "slow": "", "approval_mode": "", "max_cost": 0, "models": [], "no_lsp": False}
APPROVAL_MODES = ["always-ask", "always-ask-cached", "write", "yolo"]
SANDBOXES = ["worktree", "repo"]
PERMISSION_FIELDS = ["push", "delete_branches"]
PERMISSION_DEFAULTS = {"push": False, "delete_branches": False}
# Claude Code's permission modes, for the approval mode's equivalent. Every other
# program takes the model only, so a flag it does not know is never passed on.
CLAUDE_PERMISSION = {"always-ask": "default", "always-ask-cached": "default",
                     "write": "acceptEdits", "yolo": "bypassPermissions"}
HARNESS_KEYS = {
    "omp": ["model", "smol", "slow", "models", "approval_mode", "max_cost", "no_lsp"],
    "claude": ["model", "approval_mode"],
    "codex": ["model"],
    "pi": ["model"],
}


def as_list(value):
    if isinstance(value, str):
        return [x.strip() for x in value.split(",") if x.strip()]
    return [str(x).strip() for x in (value or []) if str(x).strip()]


def norm_harness(value):
    h = dict(HARNESS_DEFAULTS)
    if isinstance(value, dict):
        for k in HARNESS_FIELDS:
            if value.get(k) is not None:
                h[k] = value[k]
    for k in ("smol", "slow", "approval_mode"):
        h[k] = str(h.get(k) or "").strip()
    h["models"] = as_list(h.get("models"))
    try:
        h["max_cost"] = float(h.get("max_cost") or 0)
    except (TypeError, ValueError):
        h["max_cost"] = 0
    h["no_lsp"] = bool(h.get("no_lsp"))
    return h


def norm_permissions(value):
    p = dict(PERMISSION_DEFAULTS)
    if isinstance(value, dict):
        for k in PERMISSION_FIELDS:
            if value.get(k) is not None:
                p[k] = bool(value[k])
    return p


def default_prompt(name):
    return f"agents/prompts/{slug(name, 40) or 'agent'}.md"


def norm_agent(entry):
    """One roster entry with every field present. Lists are always lists; old files
    without the v2 fields read as their defaults."""
    a = dict(ROSTER_DEFAULTS)
    for k in ROSTER_FIELDS:
        if entry.get(k) is not None:
            a[k] = entry[k]
    a["harness"] = norm_harness(entry.get("harness"))
    a["permissions"] = norm_permissions(entry.get("permissions"))
    for k in ("labels", "skills", "mcp"):
        a[k] = as_list(a.get(k))
    for k in ("name", "role", "program", "model", "repo", "branch_prefix", "notes", "color", "prompt", "sandbox"):
        a[k] = str(a.get(k) or "").strip()
    a["program"] = a["program"] or "omp"
    a["branch_prefix"] = a["branch_prefix"] or ""
    a["color"] = a["color"] or "c1"
    a["sandbox"] = a["sandbox"] or "worktree"
    try:
        a["wip"] = int(a["wip"])
    except (TypeError, ValueError):
        a["wip"] = 1
    a["prompt"] = a["prompt"] or default_prompt(a["name"])
    return a


def read_roster(required=False):
    try:
        with open(ROSTER, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        if required:
            die(f"keine Roster-Datei ({ROSTER}); hub agent add legt sie an")
        return []
    except (OSError, ValueError) as e:
        die(f"Roster-Datei {ROSTER} nicht lesbar: {e}")
    if not isinstance(data, list):
        die(f"Roster-Datei {ROSTER}: eine Liste von Agents erwartet")
    return [norm_agent(x) for x in data if isinstance(x, dict) and str(x.get("name") or "").strip()]


def write_roster(rows):
    os.makedirs(os.path.dirname(ROSTER), exist_ok=True)
    tmp = ROSTER + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump([norm_agent(r) for r in rows], f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, ROSTER)


def find_agent(rows, name):
    """(index, entry) for a name, case-insensitively; (None, None) when unknown."""
    key = (name or "").strip().casefold()
    for i, r in enumerate(rows):
        if r["name"].casefold() == key:
            return i, r
    return None, None


def roster_of(name):
    _, found = find_agent(read_roster(), name)
    return found


def agent_display(value):
    """An agent field as a person reads it: a roster name, else the command's first word.

    Tickets written before `agent` and `agent_cmd` were split kept the whole start
    command (`omp --model=…`) in `agent`; reading them shows the program, never the
    command line."""
    key = (value or "").strip()
    if not key:
        return ""
    if " " in key and "--" in key:
        try:
            key = shlex.split(key)[0]
        except ValueError:
            key = key.split()[0]
    return os.path.basename(key) or key


def program_of(name):
    """The program behind a ticket's agent: a roster entry's program, else the key itself."""
    found = roster_of(name)
    return found["program"] if found else agent_display(name)


def roster_program(value):
    p = (value or "").strip() or "omp"
    if p not in AGENTS:
        die(f"unbekanntes Programm {p!r} (bekannt: {', '.join(AGENTS)})")
    return p


def roster_color(value):
    c = (value or "").strip() or "c1"
    if c not in ROSTER_COLORS:
        die(f"unbekannte Farbe {c!r} (bekannt: {', '.join(ROSTER_COLORS)})")
    return c


def prompt_path(entry, repo=""):
    """The agent's prompt file: absolute, or relative to its repo (the config home when
    the agent has none yet, so `hub agent add` works before the repo is set)."""
    p = (entry.get("prompt") or "").strip() or default_prompt(entry.get("name") or "")
    if os.path.isabs(p):
        return p
    base = os.path.expanduser((repo or entry.get("repo") or "").strip()) or APP
    return os.path.join(base, p)


def read_prompt(entry, repo=""):
    """(text, path) of the agent's prompt; a missing file is a plain error naming both.
    When the agent's repo has no such file, the config home's copy counts: a preview
    home or a fresh checkout carries agents/prompts/ before the repo is deployed."""
    path = prompt_path(entry, repo)
    try:
        with open(path, encoding="utf-8") as f:
            return f.read().strip(), path
    except OSError:
        pass
    rel = (entry.get("prompt") or "").strip() or default_prompt(entry.get("name") or "")
    fallback = None if os.path.isabs(rel) else os.path.join(APP, rel)
    if fallback and fallback != path:
        try:
            with open(fallback, encoding="utf-8") as f:
                return f.read().strip(), fallback
        except OSError:
            pass
    die(f"Prompt-Datei fehlt: {path} (Agent {entry.get('name')}); "
        f"hub agent edit {entry.get('name')} --prompt \"…\" legt sie an")


def write_prompt(entry, text, repo=""):
    path = prompt_path(entry, repo)
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text.strip() + "\n")
    return path


def harness_flags(entry):
    """The harness flags this program knows, in the order the command shows them.
    The CLI only accepts the four known programs; a hand-edited entry (a no-op command
    in a throwaway home, say) gets the omp vocabulary."""
    prog = (entry.get("program") or "omp").strip()
    keys = HARNESS_KEYS.get(prog, HARNESS_KEYS["omp"])
    h = norm_harness(entry.get("harness"))
    out = []
    if entry.get("model") and "model" in keys:
        out.append(f"--model={entry['model']}")
    if h["smol"] and "smol" in keys:
        out.append(f"--smol={h['smol']}")
    if h["slow"] and "slow" in keys:
        out.append(f"--slow={h['slow']}")
    if h["models"] and "models" in keys:
        out.append("--models=" + ",".join(h["models"]))
    if h["approval_mode"] and "approval_mode" in keys:
        mode = h["approval_mode"]
        if mode not in APPROVAL_MODES:
            die(f"unbekannter Approval-Modus {mode!r} (erlaubt: {', '.join(APPROVAL_MODES)})")
        out.append(f"--permission-mode={CLAUDE_PERMISSION[mode]}" if prog == "claude"
                   else f"--approval-mode={mode}")
    if h["max_cost"] and "max_cost" in keys:
        out.append(f"--max-cost={h['max_cost']:g}")
    if h["no_lsp"] and "no_lsp" in keys:
        out.append("--no-lsp")
    return out


def command_argv(entry):
    """The exact start command: the program's argv plus the harness flags it knows."""
    prog = (entry.get("program") or "omp").strip()
    return [*(AGENTS.get(prog) or shlex.split(prog)), *harness_flags(entry)]


def short_harness(entry):
    return " ".join([(entry.get("program") or "omp"), *harness_flags(entry)])


def merge_agent(cur, changes):
    entry = norm_agent(cur)
    for k, v in changes.items():
        if k in ("harness", "permissions"):
            entry[k] = {**entry[k], **v}
        else:
            entry[k] = v
    return norm_agent(entry)


def validate_agent(entry):
    """add/edit only: a hand-edited file stays readable, a bad command line does not."""
    entry["program"] = roster_program(entry["program"])
    entry["color"] = roster_color(entry["color"])
    if entry["sandbox"] not in SANDBOXES:
        die(f"unbekannte Sandbox {entry['sandbox']!r} (erlaubt: {', '.join(SANDBOXES)})")
    h = entry["harness"]
    if h["approval_mode"] and h["approval_mode"] not in APPROVAL_MODES:
        die(f"unbekannter Approval-Modus {h['approval_mode']!r} (erlaubt: {', '.join(APPROVAL_MODES)})")
    if h["max_cost"] < 0:
        die("Kostenlimit darf nicht negativ sein")
    if int(entry["wip"]) < 0:
        die("WIP-Limit darf nicht negativ sein")
    return entry


def agent_name(key):
    """The reviewer as a person reads it: known agents by name, else the program's basename."""
    k = (key or "").strip()
    if not k:
        return ""
    if k in AGENT_NAMES:
        return AGENT_NAMES[k]
    try:
        first = shlex.split(k)[0]
    except ValueError:
        first = k
    return os.path.basename(first) or "Prüfer"
LESSON_MAX = 40   # the file never grows past this; the oldest lines fall out
LESSON_TAIL = 8   # hub dispatch carries this many into the next order
LESSON_SOURCES = ["review", "human", "ci"]

# CI wait: 30 s poll, 20 min at most. Overridable for the mock-gh test, not for everyday use.
def env_int(name, default):
    try:
        return int(os.environ.get(name, default))
    except (TypeError, ValueError):
        return default


CI_POLL = max(0, env_int("HUB_CI_POLL", 30))
CI_TIMEOUT = max(0, env_int("HUB_CI_TIMEOUT", 1200))
CI_MARK = {"pass": "✓", "fail": "✗", "running": "…", "unknown": "?"}


def die(msg):
    sys.stderr.write(f"hub: {msg}\n")
    sys.exit(1)


# ---- Ein Home, mehrere Orchestratoren: eine Sperre, eine Identität, klare Besitzer

LOCK = os.path.join(APP, "data", "orchestra", ".hub.lock")
LOCK_TIMEOUT = max(1, env_int("HUB_LOCK_TIMEOUT", 10))
_lock_depth = 0


class hub_lock:
    """One writer at a time for a read-modify-write on data/orchestra.

    Reentrant in-process, so a command can wrap its file work once and still call
    `event()` or `write()` inside. The lock never covers an agent start, a network call
    or a long git command: a second hub command waits at most a moment by design."""

    def __enter__(self):
        global _lock_depth
        if _lock_depth:
            _lock_depth += 1
            return self
        os.makedirs(os.path.dirname(LOCK), exist_ok=True)
        self.fd = os.open(LOCK, os.O_RDWR | os.O_CREAT, 0o644)
        end = time.time() + LOCK_TIMEOUT
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.time() >= end:
                    os.close(self.fd)
                    die(f"Schreibsperre {LOCK} ist seit {LOCK_TIMEOUT} s belegt "
                        f"(eine andere hub-Änderung läuft noch); bitte gleich erneut versuchen")
                time.sleep(0.02)
        _lock_depth = 1
        return self

    def __exit__(self, *exc):
        global _lock_depth
        _lock_depth -= 1
        if _lock_depth:
            return False
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)
        return False


# ---- Spaces: one factory per Herdr space. The space id is the key of every view;
# `owner` (a terminal) only records who opened the ticket and survives no restart.

_spaces, _spaces_read = [], False
_my_space, _orch_id = None, None
_terminals, _terminals_read = {}, False
_term_values, _repo_spaces = {}, {}
_orch_of = {}
NO_SPACE = {"id": "", "name": "", "folder": "", "machine": ""}


def spaces_of_window():
    """The window's spaces, read once per command; [] when herdr-app cannot answer."""
    global _spaces, _spaces_read
    if not _spaces_read:
        _spaces, _spaces_read = app_spaces() or [], True
    return _spaces


def terminals_all():
    """Every terminal `hc ls --all` knows, read once per command (address → row).

    The panels call status/timeline in a loop; one list call must feed every lane,
    every event and every identity, or 50 tickets cost 50 subprocesses."""
    global _terminals, _terminals_read
    if not _terminals_read:
        try:
            out = json.loads(subprocess.run(["hc", "ls", "--all", "--json"],
                                            capture_output=True, text=True).stdout)
            rows = out.get("terminals") or []
        except (OSError, ValueError):
            rows = []
        _terminals = {x.get("address"): x for x in rows if isinstance(x, dict) and x.get("address")}
        _terminals_read = True
    return _terminals


def norm_space(s):
    sid = (s or {}).get("id") or ""
    return {"id": sid, "name": (s or {}).get("name") or sid,
            "folder": (s or {}).get("folder") or "", "machine": (s or {}).get("machine") or ""}


def space_ref(value, spaces=None):
    """One space from its id or name. A typo dies instead of picking a wrong factory."""
    value = (value or "").strip()
    if not value:
        return None
    rows = [norm_space(s) for s in (spaces_of_window() if spaces is None else spaces)]
    for s in rows:
        if s["id"] == value:
            return s
    hits = [s for s in rows if s["name"].casefold() == value.casefold()]
    if not hits:
        hits = [s for s in rows if s["id"].rsplit("/", 1)[-1] == value]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        die(f"Space {value!r} ist nicht eindeutig: {', '.join(s['id'] for s in hits)}")
    if re.fullmatch(r"(?:[a-z0-9._-]+/)?sp[0-9a-z]+", value):
        # An id the window did not list (a remote space, a closed one): keep it as given.
        return {"id": value, "name": value.rsplit("/", 1)[-1], "folder": "",
                "machine": value.split("/", 1)[0] if "/" in value else ""}
    die(f"kein Space {value!r} (bekannt: {', '.join(s['name'] for s in rows) or 'keiner'})")


def space_id_of_terminal(addr, spaces=None):
    """The space a terminal lives in: its labels first, else the window's space list."""
    if not addr:
        return ""
    labels = hc_term(addr).get("labels") or {}
    sid = labels.get("herdr.space") or labels.get("hub.space") or ""
    if sid:
        return sid
    for s in (spaces_of_window() if spaces is None else spaces):
        if addr in space_terminals(s):
            return s.get("id") or ""
    return ""


def my_space():
    """This command's space: HERDR_SPACE, its terminal's factory, then the cwd's folder.

    An agent terminal inherits its ticket's space (its own herdr space is the throwaway
    one its worktree lives in), so `hub status`/`wip`/`inbox` inside an agent see the
    factory that dispatched it."""
    global _my_space
    if _my_space is not None:
        return _my_space
    spaces = spaces_of_window()
    # A team agent (a terminal carrying `hub.ticket`) belongs to its ticket's workspace;
    # its own Herdr space is the throwaway one dispatch made for the worktree, and even
    # an inherited HERDR_SPACE must not turn a ticket it creates into an agent space.
    labels = hc_term(os.environ.get("HC_TERMINAL_ID") or "").get("labels") or {}
    sid, sname = stored_space(labels.get("hub.ticket") or "")
    ref = next((norm_space(s) for s in spaces if s.get("id") == sid), None)
    if ref is None and sid:
        ref = {"id": sid, "name": sname or sid.rsplit("/", 1)[-1], "folder": "", "machine": ""}
    if not ref:
        env = os.environ.get("HERDR_SPACE") or ""
        ref = space_ref(env, spaces) if env else None
    if not ref:
        sid = space_id_of_terminal(os.environ.get("HC_TERMINAL_ID") or "", spaces)
        ref = next((norm_space(s) for s in spaces if s.get("id") == sid), None)
        if ref is None and sid:
            ref = {"id": sid, "name": sid.rsplit("/", 1)[-1], "folder": "", "machine": ""}
    if not ref:
        cwd = os.path.realpath(os.getcwd())
        hits = [norm_space(s) for s in spaces if s.get("folder") and inside(cwd, s["folder"])]
        ref = max(hits, key=lambda s: len(s["folder"]), default=None)
    _my_space = ref or dict(NO_SPACE)
    return _my_space


ORCH_NAME = "orchestrator"
_orch_terms, _orch_terms_read = None, False


def is_orchestrator(info):
    """Whether one terminal row is an orchestrator: its label or its name (`orchestrator`,
    `orchestrator-<space>`). The name covers `hc ls`, whose rows carry no labels."""
    labels = (info or {}).get("labels") or {}
    if labels.get("hub.role") == "orchestrator":
        return True
    name = (info or {}).get("name") or ""
    return name == ORCH_NAME or name.startswith(ORCH_NAME + "-")


def orchestrator_terminals():
    """Every orchestrator terminal (address → info), read once per command.

    `hc ls` rows carry no labels, so the name is the cheap witness (`orchestrator`,
    `orchestrator-<space>`); `hub spaces` and `hub orchestrator list` share this answer.
    A legacy home whose snapshot is empty falls back to `hc get` per listed terminal."""
    global _orch_terms, _orch_terms_read
    if _orch_terms_read:
        return _orch_terms
    _orch_terms = {addr: info for addr, info in terminals_all().items() if is_orchestrator(info)}
    _orch_terms_read = True
    return _orch_terms


def orchestrator_of(space):
    """(terminal, info) of the orchestrator running in one space; ("", {}) when none does.

    Works from the one orchestrator snapshot (`orchestrator_terminals`); a terminal the
    space lists is accepted by its name even when `hc get` answers {} (legacy stub)."""
    sid = (space or {}).get("id") or ""
    if not sid:
        return "", {}
    if sid in _orch_of:
        return _orch_of[sid]
    found = []
    for addr, info in orchestrator_terminals().items():
        labels = info.get("labels") or {}
        if labels.get("hub.space") == sid or labels.get("herdr.space") == sid:
            found.append((addr, info))
    listed = {addr for addr, _ in found}
    for s in spaces_of_window():
        if s.get("id") != sid:
            continue
        for addr in space_terminals(s):
            if addr in listed:
                continue
            info = orchestrator_terminals().get(addr) or terminals_all().get(addr) or hc_term(addr)
            if is_orchestrator(info):
                found.append((addr, info))
    live = [x for x in found if x[1].get("state") == "live"]
    _orch_of[sid] = (live or found or [("", {})])[0]
    return _orch_of[sid]


def orchestrator_id():
    """This terminal when it is an orchestrator, else the orchestrator of its own space.

    Never a foreign space's orchestrator: a shell outside a factory has no orchestrator
    (legacy homes without space labels keep the old single-orchestrator fallback)."""
    global _orch_id
    if _orch_id is not None:
        return _orch_id
    me = os.environ.get("HC_TERMINAL_ID") or ""
    if me:
        info = hc_term(me)
        if is_orchestrator(info):
            _orch_id = me
            return me
    mine = my_space()
    if mine["id"]:
        _orch_id = orchestrator_of(mine)[0]
        return _orch_id
    try:
        out = json.loads(subprocess.run(["hc", "ls", "--json"], capture_output=True, text=True).stdout)
    except (OSError, ValueError):
        out = {}
    for x in out.get("terminals") or []:
        if (x.get("labels") or {}).get("hub.role") == "orchestrator":
            _orch_id = x.get("address") or ""
            return _orch_id
    for x in out.get("terminals") or []:
        if x.get("name") == "orchestrator":
            _orch_id = x.get("address") or ""
            return _orch_id
    _orch_id = ""
    return _orch_id


def ticket_space(t, spaces=None):
    """The ticket's factory: its `space`, else the space whose folder holds its repo.

    A ticket without either stays `""` and is visible in every space, like the old
    ownerless ones. That is the only case a ticket crosses a factory boundary.

    Tickets from before this model carry the *agent's* throwaway space in `space` and
    no `space_name`; they are read as if they had no space at all and assigned by
    their repo. Every write from now on sets both fields."""
    sid = (t.get("space") or "").strip()
    if sid and (t.get("space_name") or "").strip():
        return sid
    repo = (t.get("repo") or "").strip()
    if not repo:
        return ""
    key = (repo, t.get("machine") or "")
    if key in _repo_spaces:
        return _repo_spaces[key]
    hits = []
    for s in (spaces_of_window() if spaces is None else spaces):
        folder = s.get("folder") or ""
        if not folder:
            continue
        if t.get("machine"):
            if not s.get("machine") or s.get("machine") != t["machine"]:
                continue
        if inside(repo, folder):
            hits.append(s)
    _repo_spaces[key] = (max(hits, key=lambda s: len(s.get("folder") or "")).get("id") or "") if hits else ""
    return _repo_spaces[key]


def space_name_of(sid, spaces=None):
    if not sid:
        return ""
    for s in (spaces_of_window() if spaces is None else spaces):
        if s.get("id") == sid:
            return s.get("name") or sid
    return sid.rsplit("/", 1)[-1]


def ticket_space_name(t, spaces=None):
    sid = ticket_space(t, spaces)
    if not sid:
        return ""
    if (t.get("space") or "") == sid and t.get("space_name"):
        return t["space_name"]
    return space_name_of(sid, spaces)


def owns(t, me, space=None):
    """True when the ticket belongs to this factory.

    A ticket with a space belongs to that space alone (a restarted orchestrator with a
    new terminal keeps its tickets). A ticket without one — no `space`, and no space
    folder holds its repo — is "ohne Workspace": visible only with `--all` or
    `--space ""`/`none`, never in a project factory. A home without the space model
    keeps the old owner rule."""
    sid = ticket_space(t)
    if space is not None:
        return sid == space
    mine = my_space()["id"]
    if mine:
        return sid == mine
    if spaces_of_window():
        return False  # no own factory here: only the unassigned group is addressable
    owner = (t.get("owner") or "").strip()
    return not owner or not me or owner == me


def my_tickets(rows=None, everyone=False, me=None, space=None):
    """The tickets this factory handles; `space=""` is the "ohne Workspace" group."""
    rows = all_tickets() if rows is None else rows
    if everyone:
        return rows
    me = orchestrator_id() if me is None else me
    if space is not None:
        return [t for t in rows if ticket_space(t) == space]
    mine = my_space()["id"]
    if mine:
        return [t for t in rows if ticket_space(t) == mine]
    if spaces_of_window():
        return []
    return [t for t in rows if owns(t, me)]


def space_arg(a, name="space"):
    """The space a command's `--space` names: None absent, "" for `--space ""`/`none`."""
    value = getattr(a, name, None)
    if value is None:
        return None
    value = value.strip()
    if value.casefold() in ("", "none", "-"):
        return ""
    return space_ref(value)["id"]


def update_ticket(tid, fn):
    """Locked read-modify-write of one ticket; returns what was saved.

    The fresh read inside the lock is what keeps a concurrent comment from being lost:
    the caller's changes are applied to the current file, not to a stale copy."""
    with hub_lock():
        t = load(tid)
        fn(t)
        write(t)
        return t


def slug(s, n=40):
    s = unicodedata.normalize("NFKD", str(s)).encode("ascii", "ignore").decode().lower().replace("ß", "ss")
    return re.sub(r"[^a-z0-9]+", "-", s).strip("-")[:n].rstrip("-")


# ---- tickets, in the format Quests reads and writes

def path_of(tid):
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", tid or ""):
        die(f"bad ticket id {tid!r}")
    return os.path.join(TICKETS, tid + ".md")


def read(tid):
    """One ticket, or None when the file carries no `---` frontmatter.

    A broken file must not take a whole command down: `all_tickets` skips it and
    `hub status` counts it, while single-ticket commands use `load`, which dies with
    a readable message instead of a traceback."""
    p = path_of(tid)
    try:
        text = open(p, encoding="utf-8").read()
    except OSError:
        die(f"no ticket {tid} ({p})")
    m = re.match(r"^---\r?\n(.*?)\r?\n---\r?\n?", text, re.S)
    if not m:
        return None
    meta = {}
    for line in m.group(1).splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            meta[k.strip()] = v.strip()
    meta["id"] = tid
    meta["body"] = text[m.end():]
    meta.setdefault("status", "todo")
    meta.setdefault("title", tid)
    return meta


def load(tid):
    """One ticket for a command that cannot continue without it."""
    t = read(tid)
    if t is None:
        die(f"{tid}: kein Ticket-Frontmatter (der --- Block fehlt); Datei übersprungen")
    return t


def write(t):
    os.makedirs(TICKETS, exist_ok=True)
    t["updated"] = time.strftime("%Y-%m-%d %H:%M")
    one = lambda v: re.sub(r"[\r\n]+", " ", str(v or "")).strip()
    head = [f"{k}: {one(t.get(k))}" for k in FIELDS if k in ("title", "status", "repo", "labels", "due") or t.get(k)]
    # One temp name per process: two writers of the same ticket (a locked command and a
    # long check that saves afterwards) must never share a scratch file.
    tmp = f"{path_of(t['id'])}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("---\n" + "\n".join(head) + "\n---\n" + (t.get("body") or ""))
    os.replace(tmp, path_of(t["id"]))


def all_tickets():
    try:
        names = sorted(n for n in os.listdir(TICKETS) if n.endswith(".md"))
    except OSError:
        return []
    return [t for t in (read(n[:-3]) for n in names) if t is not None]


def invalid_tickets():
    """Ids whose file has no frontmatter; `hub status` reports them instead of dying."""
    try:
        names = sorted(n for n in os.listdir(TICKETS) if n.endswith(".md"))
    except OSError:
        return []
    return [n[:-3] for n in names if read(n[:-3]) is None]


# ---- Chronik: one JSON line per action, so `hub timeline` knows what happened when
EVENTS = os.path.join(APP, "data", "orchestra", "events.jsonl")
EVENT_MAX, EVENT_KEEP = 5000, 2000
EVENT_KINDS = ["dispatch", "nudge", "review", "verdict", "land", "done", "verify", "ci", "night",
               "comment", "orchestrator"]


def now_ms():
    return int(time.time() * 1000)


def stored_space(tid):
    """The `space` a ticket file carries, read without `read()`'s die-on-missing."""
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", tid or ""):
        return "", ""
    try:
        with open(os.path.join(TICKETS, tid + ".md"), encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return "", ""
    m = re.match(r"^---\r?\n(.*?)\r?\n---", text, re.S)
    if not m:
        return "", ""
    sid = name = ""
    for line in m.group(1).splitlines():
        k, _sep, v = line.partition(":")
        if k.strip() == "space":
            sid = v.strip()
        elif k.strip() == "space_name":
            name = v.strip()
    return (sid, name) if sid and name else ("", "")


def event(kind, ticket="", agent="", terminal="", text="", space=""):
    """Append one log line; past EVENT_MAX lines the log keeps the last EVENT_KEEP.

    `at` is epoch milliseconds, so the timeline can sort and window entries without
    re-reading the tickets. Only EVENT_KINDS are written here; the timeline derives
    `status` entries from a ticket's status_log on its own. `space` names the factory
    the entry belongs to: the ticket's, else this command's own space."""
    if kind not in EVENT_KINDS:
        raise ValueError(f"unknown event kind {kind!r}")
    sid, sname = stored_space(ticket)
    if not space:
        space = sid or my_space()["id"]
    elif not sname or sid != space:
        sname = ""
    row = {"at": now_ms(), "kind": kind, "ticket": ticket or "", "agent": agent or "",
           "terminal": terminal or "", "text": one_line(text)[:500],
           "space": space or "", "space_name": sname or (space_name_of(space) if space else "")}
    os.makedirs(os.path.dirname(EVENTS), exist_ok=True)
    with hub_lock():
        with open(EVENTS, "a", encoding="utf-8") as f:
            f.write(json.dumps(row, ensure_ascii=False) + "\n")
        # Rotation is the only rewrite: the normal path is one append, so parallel hub
        # commands do not lose each other's lines. It runs under the same lock as the
        # append, so a rotation cannot eat a line another command just wrote.
        try:
            with open(EVENTS, encoding="utf-8") as f:
                lines = [line for line in f.read().splitlines() if line.strip()]
        except OSError:
            return row
        if len(lines) > EVENT_MAX:
            tmp = EVENTS + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write("\n".join(lines[-EVENT_KEEP:]) + "\n")
            os.replace(tmp, EVENTS)
    return row


def author_terminal(role):
    """The lane a comment-like event belongs to.

    `orchestrator` writes under this terminal's own id (HC_TERMINAL_ID); every other role
    writes without one. The ticket's `terminal` names the agent, not the author, so using
    it put orchestrator actions on the agent's lane."""
    return (os.environ.get("HC_TERMINAL_ID") or "").strip() if (role or "").strip().casefold() == "orchestrator" else ""


def read_events():
    """The log, oldest first; an unreadable line is skipped, never fatal."""
    rows = []
    try:
        with open(EVENTS, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return rows
    for line in text.splitlines():
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if not isinstance(row, dict):
            continue
        try:
            at = int(row["at"])
        except (KeyError, TypeError, ValueError):
            continue
        rows.append({"at": at, "kind": str(row.get("kind") or ""), "ticket": str(row.get("ticket") or ""),
                     "agent": str(row.get("agent") or ""), "terminal": str(row.get("terminal") or ""),
                     "text": str(row.get("text") or ""), "space": str(row.get("space") or ""),
                     "space_name": str(row.get("space_name") or "")})
    rows.sort(key=lambda r: r["at"])
    return rows


# ---- Messwerte: every move is recorded, so throughput and rework can be counted

STAMP = "%Y-%m-%d %H:%M"


def now_stamp():
    return time.strftime(STAMP)


def epoch(ts):
    """Local seconds for a ticket stamp ("JJJJ-MM-TT HH:MM"), None when unreadable."""
    try:
        return time.mktime(time.strptime(str(ts).strip(), STAMP))
    except (TypeError, ValueError):
        return None


def log_status(t, status, ts):
    """Append a move to `status_log` (`state@stamp|state@stamp`), never the same state twice in a row."""
    parts = [p for p in (t.get("status_log") or "").split("|") if p.strip()]
    if parts and parts[-1].rsplit("@", 1)[0].strip() == status:
        return
    parts.append(f"{status}@{ts}")
    t["status_log"] = "|".join(parts)


def check_status(value, tid=""):
    """Only the five known stages; anything else makes the ticket vanish from every view."""
    s = str(value or "").strip()
    if s not in STATUSES:
        where = f"{tid}: " if tid else ""
        die(f"{where}unbekannter Status {value!r} (erlaubt: {', '.join(STATUSES)})")
    return s


def set_status(t, status, ts=None):
    """The one place a status changes: `status`, `status_at` and the append-only log stay in step."""
    status = check_status(status, t.get("id") or "")
    ts = ts or now_stamp()
    if status == t.get("status") and t.get("status_log"):
        return
    t["status"] = status
    t["status_at"] = ts
    log_status(t, status, ts)


def timeline(t):
    """[(seconds, state)] oldest first, from the recorded status log only.

    A ticket from before the log has no path to measure: its next status change starts
    the log. Inventing stages from `updated` would put made-up minutes into the median."""
    ev = []
    for part in (t.get("status_log") or "").split("|"):
        if "@" not in part:
            continue
        state, ts = part.strip().rsplit("@", 1)
        at = epoch(ts)
        if at is not None and state.strip():
            ev.append((at, state.strip()))
    ev.sort(key=lambda e: e[0])
    return ev


# ---- verlauf: the ticket's comment history, the only channel between agents

VERLAUF = "## Verlauf"
ENTRY = re.compile(r"^- (\d{4}-\d{2}-\d{2} \d{2}:\d{2}) · ([^·]+?) · (.*)$")


def entries(t):
    """The ## Verlauf comments, oldest first: (timestamp, role, text)."""
    body = t.get("body") or ""
    m = re.search(r"(?m)^## Verlauf[ \t]*$", body)
    if not m:
        return []
    tail = body[m.end():]
    nxt = re.search(r"(?m)^## ", tail)
    if nxt:
        tail = tail[:nxt.start()]
    return [(e.group(1), e.group(2).strip(), e.group(3).strip())
            for e in (ENTRY.match(line.strip()) for line in tail.splitlines()) if e]


def split_verlauf(body):
    """(body without the ## Verlauf section, that section text)."""
    m = re.search(r"(?ms)^## Verlauf[ \t]*\n.*?(?=\n## |\Z)", body or "")
    if not m:
        return (body or "").rstrip("\n"), ""
    return ((body[:m.start()] + body[m.end():]).strip("\n"), m.group(0).rstrip("\n"))


def mentions(text):
    return sorted(set(re.findall(r"@([A-Za-z0-9][A-Za-z0-9_.-]*)", text or "")))


def names(v):
    return [x.strip() for x in (v or "").split(",") if x.strip()]


def add_comment(t, who, text):
    text = " ".join(str(text).split())
    if not text:
        die("leerer Kommentar")
    line = f"- {time.strftime('%Y-%m-%d %H:%M')} · {who} · {text}"
    rest, section = split_verlauf(t.get("body"))
    section = f"{section}\n{line}" if section else f"{VERLAUF}\n{line}"
    t["body"] = (rest + "\n\n" if rest else "") + section + "\n"
    t["tags"] = ", ".join(sorted(set(names(t.get("tags"))) | set(mentions(text))))
    return line


# ---- Prüfung: the repo's check runs in the worktree, the gate only trusts that run

PRUEFUNG = "## Prüfung"


def prufung(t):
    """The ## Prüfung section: its meta line and the captured output lines."""
    m = re.search(r"(?ms)^## Prüfung[ \t]*\n(.*?)(?=\n## |\Z)", t.get("body") or "")
    if not m:
        return {"meta": "", "tail": []}
    lines = m.group(1).strip("\n").splitlines()
    meta = lines[0][2:].strip() if lines and lines[0].startswith("- ") else ""
    tail, fenced = [], False
    for line in lines:
        if line.lstrip().startswith("```"):
            fenced = not fenced
            continue
        if fenced:
            tail.append(line)
    return {"meta": meta, "tail": tail}


def set_prufung(t, text):
    """Replace ## Prüfung in the body, keeping it just before ## Verlauf."""
    body = re.sub(r"(?ms)^## Prüfung[ \t]*\n.*?(?=\n## |\Z)", "", t.get("body") or "").strip("\n")
    block = f"{PRUEFUNG}\n{text}".rstrip("\n")
    m = re.search(r"(?m)^## Verlauf[ \t]*$", body)
    body = (body[:m.start()].rstrip("\n") + "\n\n" + block + "\n\n" + body[m.start():]) if m else \
        (body + "\n\n" + block if body else block)
    t["body"] = body.strip("\n") + "\n"


def meta_fields(meta):
    """The ## Prüfung head line, as fields — the record survives a Quests edit that drops
    the frontmatter fields (Quests keeps the body)."""
    parts = [p.strip() for p in (meta or "").split(" · ") if p.strip()]
    out = {}
    if parts and re.match(r"\d{4}-\d{2}-\d{2}", parts[0]):
        out["at"] = parts.pop(0)
    if parts and parts[0] in ("pass", "fail"):
        out["checks"] = parts.pop(0)
    if parts and re.fullmatch(r"\d+(?:\.\d+)?\s*s", parts[0]):
        out["duration"] = parts.pop(0)[:-1].strip()
    if parts and parts[0].startswith("exit "):
        out["exit"] = parts.pop(0)[5:].strip()
    if parts and parts[0].startswith("HEAD "):
        out["head"] = parts.pop(0)[5:].strip()
    if parts:
        out["cmd"] = " · ".join(parts)
    return out


# ---- Review: the station's verdict, valid only for the commit it judged

REVIEW = "## Review"


def review_section(t):
    """The ## Review section: its meta line and the reviewer's summary."""
    m = re.search(r"(?ms)^## Review[ \t]*\n(.*?)(?=\n## |\Z)", t.get("body") or "")
    if not m:
        return {"meta": "", "summary": ""}
    lines = m.group(1).strip("\n").splitlines()
    meta = lines[0][2:].strip() if lines and lines[0].startswith("- ") else ""
    return {"meta": meta, "summary": " ".join(" ".join(lines[1:]).split())}


def review_meta_fields(meta):
    """The ## Review head line, as fields — the record survives a Quests edit."""
    parts = [p.strip() for p in (meta or "").split(" · ") if p.strip()]
    out = {}
    if parts and re.match(r"\d{4}-\d{2}-\d{2}", parts[0]):
        out["at"] = parts.pop(0)
    if parts and parts[0] in ("pass", "fail"):
        out["verdict"] = parts.pop(0)
    if parts and parts[0].startswith("Runde "):
        out["rounds"] = parts.pop(0)[6:].strip()
    if parts and parts[0].startswith("HEAD "):
        out["head"] = parts.pop(0)[5:].strip()
    if parts:
        out["reviewer"] = " · ".join(parts)
    return out


def set_review(t, text):
    """Replace ## Review in the body, keeping it just before ## Verlauf."""
    body = re.sub(r"(?ms)^## Review[ \t]*\n.*?(?=\n## |\Z)", "", t.get("body") or "").strip("\n")
    block = f"{REVIEW}\n{text}".rstrip("\n")
    m = re.search(r"(?m)^## Verlauf[ \t]*$", body)
    body = (body[:m.start()].rstrip("\n") + "\n\n" + block + "\n\n" + body[m.start():]) if m else \
        (body + "\n\n" + block if body else block)
    t["body"] = body.strip("\n") + "\n"


def target_of(t, on=None):
    """The ticket's worktree, else its repo; None when neither exists here."""
    for p in (t.get("worktree"), t.get("repo")):
        if p and run(["test", "-d", p], on, check=False).returncode == 0:
            return p
    return None


def head_of(t, on=None):
    """(HEAD of the worktree, error). The checks must belong to this state."""
    folder = target_of(t, on)
    if not folder:
        return None, "Worktree und Repo fehlen"
    r = run(["git", "rev-parse", "HEAD"], on, folder, check=False)
    if r.returncode != 0:
        detail = (r.stderr or r.stdout).strip()
        if "not a git repository" in detail.lower():
            return None, f"kein Git-Repository in {folder}"
        return None, f"HEAD nicht lesbar in {folder}: {detail}"
    return r.stdout.strip(), None


def worktree_head(t, on=None):
    """HEAD of the ticket's own worktree, else None (no fallback to the repo)."""
    wt = t.get("worktree") or ""
    if not wt or run(["test", "-d", wt], on, check=False).returncode != 0:
        return None
    r = run(["git", "rev-parse", "HEAD"], on, wt, check=False)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def gate(t):
    """Whether the recorded check counts: pass, and run on the worktree's current HEAD.

    A landed ticket has no worktree left; its merge commit is not a new check state, so the
    recorded run and verdict stand (the panel shows them, not a stale red)."""
    on = t.get("machine") or None
    landed = t.get("status") == "done"
    head, err = (None, None) if landed else head_of(t, on)
    section = prufung(t)
    meta = meta_fields(section["meta"])
    checks = t.get("checks") or meta.get("checks")
    checked = t.get("checks_head") or meta.get("head") or ""
    g = {"id": t["id"], "checks": checks, "checked_head": checked or None,
         "head": head, "duration": t.get("checks_duration") or meta.get("duration"),
         "at": t.get("checks_at") or meta.get("at"), "exit": t.get("checks_exit") or meta.get("exit"),
         "cmd": t.get("checks_cmd") or meta.get("cmd"),
         "landed": landed, "stale": False,
         "meta": section["meta"], "tail": section["tail"]}
    if checks != "pass":
        why = (f"Checks rot (Exit {g['exit'] or '?'}): hub verify {t['id']} erneut ausführen"
               if checks == "fail" else f"Noch keine Prüfung: hub verify {t['id']} ausführen")
        g.update(ok=False, reason=why)
    elif landed:
        g.update(ok=True, reason="")
    elif err:
        g.update(ok=False, reason=f"{err}; hub verify {t['id']} prüft im Worktree")
    elif not checked:
        g.update(ok=False, reason=f"Prüfung ohne HEAD aufgezeichnet: hub verify {t['id']} erneut ausführen")
    elif head != checked and not (head and head.startswith(checked)):
        g.update(ok=False, stale=True, reason=(f"Checks älter als der letzte Commit (geprüft {checked[:7]}, "
                                               f"jetzt {head[:7]}): hub verify {t['id']} erneut ausführen"))
    else:
        g.update(ok=True, reason="")
    g["review"] = review_gate(t, head, err, landed)
    g["base"] = ({"base": t.get("base") or None, "base_head": t.get("base_head") or None, "ok": None,
                  "reason": "Ticket ist gelandet", "tip": None, "behind": None}
                 if landed else base_gate(t, head, err))
    g["dod"] = dod(t, g)
    g["dod_ok"] = all(x["ok"] for x in g["dod"])
    return g


# ---- Definition of Done: the six things a ticket must show before `hub review` accepts it

SYSTEM_ROLES = {"hub", "orchestrator", "review", "ci", "mensch"}
END_REPORT = re.compile(r"(?i)\b(fertig|blockiert|abgeschlossen|erledigt|done|blocked)\b")


def dod(t, g):
    """[{key,label,ok,why}]: the fixed list, each with the reason it is missing.

    The last point reads the ## Verlauf: the implementing agent (any role that is not
    hub, the orchestrator, the station, CI or the human) reported an end state there.
    """
    crit = criteria(t)
    items = [
        ("kriterien", "Abnahmekriterien vorhanden", bool(crit),
         f"kein Abnahmekriterium unter {ABNAHME}: hub spec {t['id']}"),
        ("verify", "hub verify grün auf dem HEAD", bool(g.get("ok")),
         g.get("reason") or f"hub verify {t['id']} im Worktree ausführen"),
        ("pruefung", "Prüfstation pass", bool((g.get("review") or {}).get("ok")),
         (g.get("review") or {}).get("reason") or f"hub review-start {t['id']}"),
        ("ci", "CI grün oder nicht nötig", (t.get("ci") or "") in ("", "pass"),
         f"CI {t.get('ci') or 'unbekannt'}: hub ci {t['id']}" + (f" · {t['ci_url']}" if t.get("ci_url") else "")),
        ("nachweise", "Nachweise (evidence) vorhanden", bool(names(t.get("evidence"))),
         f"keine Nachweise: hub review {t['id']} --evidence PATH"),
        ("abschluss", "Verlauf enthält einen Abschluss", bool(
            [e for e in entries(t) if e[1] not in SYSTEM_ROLES and END_REPORT.search(e[2])]),
         "der Agent hat im Verlauf noch keinen Abschluss gemeldet (fertig/blockiert)"),
    ]
    return [{"key": k, "label": label, "ok": ok, "why": "" if ok else why} for k, label, ok, why in items]


def review_gate(t, head=None, err=None, landed=False):
    """Whether the reviewer's verdict counts: pass, given on the worktree's current HEAD.

    For a landed ticket the recorded verdict is what counts; the merge commit on the base
    branch is not a new review state."""
    if head is None and err is None and not landed:
        head, err = head_of(t, t.get("machine") or None)
    section = review_section(t)
    meta = review_meta_fields(section["meta"])
    verdict = t.get("review") or meta.get("verdict") or None
    checked = t.get("review_head") or meta.get("head") or ""
    summary = t.get("review_summary") or section["summary"] or ""
    g = {"verdict": verdict, "ok": False, "reason": "", "head": head, "review_head": checked or None,
         "at": t.get("review_at") or meta.get("at"), "rounds": t.get("review_rounds") or meta.get("rounds"),
         "summary": summary, "reviewer": t.get("reviewer") or meta.get("reviewer") or "",
         "reviewer_name": t.get("reviewer_name") or "", "landed": landed, "stale": False}
    if verdict == "fail":
        g["reason"] = f"Review rot: {summary}; Befunde im Verlauf" if summary else "Review rot; Befunde im Verlauf"
    elif verdict != "pass":
        g["reason"] = f"Noch kein Reviewer-Urteil: hub review-start {t['id']}"
    elif landed:
        g["ok"] = True
    elif err:
        g["reason"] = f"{err}; hub review-start {t['id']} prüft im Worktree"
    elif not checked:
        g["reason"] = f"Review-Urteil ohne HEAD aufgezeichnet: hub review-verdict {t['id']} erneut ausführen"
    elif head != checked and not (head and head.startswith(checked)):
        g["stale"] = True
        g["reason"] = (f"Review-Urteil älter als der letzte Commit (geprüft {checked[:7]}, "
                       f"jetzt {(head or '?')[:7]}): hub review-start {t['id']}")
    else:
        g["ok"] = True
    return g


def base_gate(t, head=None, err=None):
    """Whether the branch sits on its base: the base's current tip must be an ancestor of HEAD.
    The recorded `base_head` is only the fallback when the base ref is gone (another machine,
    deleted branch); a base that moved on after dispatch therefore counts as stale."""
    on = t.get("machine") or None
    base = t.get("base") or ""
    g = {"base": base or None, "base_head": t.get("base_head") or None, "ok": None,
         "reason": "", "tip": None, "behind": None}
    if not base or not t.get("branch"):
        g["reason"] = "Keine Basis im Ticket: hub dispatch schreibt base und base_head"
        return g
    if head is None and err is None:
        head, err = head_of(t, on)
    if err:
        g.update(ok=False, reason=f"{err}; hub verify {t['id']} prüft im Worktree")
        return g
    folder = target_of(t, on)
    if not folder:
        g.update(ok=False, reason="Worktree und Repo fehlen")
        return g
    r = run(["git", "rev-parse", "--verify", "--quiet", f"{base}^{{commit}}"], on, folder, check=False)
    g["tip"] = r.stdout.strip() if r.returncode == 0 else g["base_head"]
    if not g["tip"]:
        g["reason"] = (f"Basis {base} nicht gefunden: git fetch im Repo oder "
                       f"hub ticket set {t['id']} base=<branch>")
        return g
    if run(["git", "merge-base", "--is-ancestor", g["tip"], "HEAD"], on, folder, check=False).returncode == 0:
        g["ok"] = True
        return g
    behind = run(["git", "rev-list", "--count", f"HEAD..{g['tip']}"], on, folder, check=False)
    g["ok"] = False
    g["behind"] = int(behind.stdout.strip() or 0) if behind.returncode == 0 else None
    n = f" ({g['behind']} Commit{'s' if g['behind'] != 1 else ''} hinter {base})" if g["behind"] else ""
    g["reason"] = (f"Basis veraltet: der Branch setzt nicht auf {base} auf{n}; im Worktree "
                   f"`git rebase {base}` (oder hub rebase {t['id']}), dann erneut prüfen")
    return g


def open_blockers(t):
    """(id, status) of predecessors that are not done yet; a missing one counts as open."""
    out = []
    for b in names(t.get("blocked_by")):
        p = path_of(b)
        out.append((b, (read(b) or {}).get("status") or "fehlt" if os.path.exists(p) else "fehlt"))
    return [b for b in out if b[1] != "done"]


def age(ts):
    try:
        d = max(0, int(time.time() - time.mktime(time.strptime(ts, "%Y-%m-%d %H:%M"))))
    except (TypeError, ValueError):
        return "?"
    if d < 60:
        return "gerade"
    if d < 3600:
        return f"{d // 60} min"
    if d < 86400:
        return f"{d // 3600} h"
    return f"{d // 86400} d"


# ---- lessons: what went wrong here, per repo, carried into every next order
#
# <repo>/.herdr/lessons.md holds one line per lesson, oldest first, never more than
# LESSON_MAX lines. The format is stable and parsed by bin/hub, mods/orchestra/tickets.js
# and the Review window:
#   - 2026-11-14 · <ticket|-> · review|human|ci · short, imperative text
# A suggestion the orchestrator made after feedback waits in lessons-pending.md until
# the human confirms it in the Review window (then source `review`).

LESSON_FMT = re.compile(r"^- (\d{4}-\d{2}-\d{2}) · ([^·]+?) · ([^·]+?) · (.*)$")


def lesson_dir(repo):
    return os.path.join(repo, ".herdr")


def lesson_line(l):
    return f"- {l['date']} · {l['ticket']} · {l['source']} · {l['text']}"


def parse_lessons(text):
    out = []
    for line in (text or "").splitlines():
        m = LESSON_FMT.match(line.strip())
        if m:
            out.append({"date": m.group(1), "ticket": m.group(2).strip(), "source": m.group(3).strip(),
                        "text": m.group(4).strip()})
    return [l for l in out if l["text"]]


def read_lessons(repo, on=None, name="lessons.md"):
    path = os.path.join(lesson_dir(repo), name)
    if on:
        text = run(["sh", "-c", f"cat {shlex.quote(path)} 2>/dev/null || true"], on, check=False).stdout
        return parse_lessons(text)
    try:
        return parse_lessons(open(path, encoding="utf-8").read())
    except OSError:
        return []


def lesson_guard(on=None):
    """One hub writer per lesson file: `hub_lock` for a local repo.

    A repo addressed with `--on` lives on another machine, where this home's lock
    serialises nothing; its ssh write therefore runs without it."""
    return contextlib.nullcontext() if on else hub_lock()


def write_lessons(repo, items, on=None, name="lessons.md"):
    d = lesson_dir(repo)
    path = os.path.join(d, name)
    body = "".join(lesson_line(l) + "\n" for l in items[-LESSON_MAX:])
    if not on:
        # Local writes stay in Python: a rename is atomic and the write cannot fail with
        # a shell message the person cannot act on.
        try:
            os.makedirs(d, exist_ok=True)
            tmp = f"{path}.{os.getpid()}.tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(body)
            os.replace(tmp, path)
        except OSError as e:
            die(f"Lehren nicht schreibbar: {path}: {e.strerror or e}")
        return
    sh = f"mkdir -p {shlex.quote(d)} && printf %s {shlex.quote(body)} > {shlex.quote(path)}"
    run(["sh", "-c", sh], on)


def one_line(text):
    return " ".join(str(text or "").split())


def add_lesson(repo, ticket, source, text, on=None):
    text = one_line(text)
    if not text:
        die("leere Lehre")
    with lesson_guard(on):
        items = read_lessons(repo, on)
        for l in items:  # the same lesson twice helps nobody
            if l["text"] == text:
                return l
        l = {"date": time.strftime("%Y-%m-%d"), "ticket": ticket or "-", "source": source, "text": text}
        items.append(l)
        write_lessons(repo, items, on)
    return l


def repo_of(target, on=None):
    """(repo, ticket id, machine) for a ticket id or a repo path; dies on neither."""
    tid = target if re.fullmatch(r"[a-z0-9][a-z0-9-]*", target or "") and os.path.exists(path_of(target)) else ""
    if tid:
        t = load(tid)
        repo = t.get("repo")
        if not repo:
            die(f"{tid} hat kein Repo; hub ticket set {tid} repo=/pfad")
        return repo, tid, t.get("machine") or None
    repo = os.path.abspath(target or "") if not on else (target or "")
    if not repo or (not on and not os.path.isdir(repo)):
        die(f"kein Repo: {target}")
    return repo, "", on


def lesson_section(repo, on=None):
    """The dispatch section with the last LESSON_TAIL lessons, or "" when there are none."""
    items = read_lessons(repo, on)[-LESSON_TAIL:]
    if not items:
        return ""
    return "## Was hier schon schiefging\n\n" + "\n".join(lesson_line(l) for l in items)


# ---- memory: what an agent learned for itself, carried into its next order
#
# agents/memory/<agent-slug>.md (versioned with APP, like the roster) or, for a repo,
# <repo>/.herdr/memory.md. One line per entry, oldest first, never more than MEMORY_MAX:
#   - 2026-11-15 · <ticket|-> · short text
# Unlike lessons (what went wrong here, from review), this is the agent's own knowledge.

MEMORY = os.path.join(APP, "agents", "memory")
MEMORY_MAX = 60   # the file never grows past this; the oldest lines fall out
MEMORY_TAIL = 5   # hub dispatch carries this many into the next order
MEMORY_TEXT_MAX = 240  # one entry stays one readable line; longer text is cut with "…"
MEMORY_FMT = re.compile(r"^- (\d{4}-\d{2}-\d{2}) · ([^·]+?) · (.*)$")


def memory_path_agent(name):
    return os.path.join(MEMORY, (slug(name) or "agent") + ".md")


def memory_path_repo(repo):
    return os.path.join(os.path.abspath(os.path.expanduser(repo)), ".herdr", "memory.md")


def memory_line(x):
    return f"- {x['date']} · {x['ticket'] or '-'} · {x['text']}"


def parse_memory(text):
    out = []
    for line in (text or "").splitlines():
        m = MEMORY_FMT.match(line.strip())
        if m:
            out.append({"date": m.group(1), "ticket": m.group(2).strip(),
                        "text": m.group(3).strip()})
    return [x for x in out if x["text"]]


def read_memory(path):
    try:
        return parse_memory(open(path, encoding="utf-8").read())
    except OSError:
        return []


def write_memory(path, items):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    body = "".join(memory_line(x) + "\n" for x in items[-MEMORY_MAX:])
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(body)
    os.replace(tmp, path)


def shorten_memory(text, limit=MEMORY_TEXT_MAX):
    """One line, at most `limit` characters; the marker counts toward the limit."""
    text = one_line(text)
    if len(text) <= limit:
        return text, False
    return text[:limit - 1].rstrip() + "…", True


def add_memory(path, ticket, text):
    text, cut = shorten_memory(text)
    if not text:
        die("leerer Gedächtniseintrag")
    items = read_memory(path)
    item = {"date": time.strftime("%Y-%m-%d"), "ticket": ticket or "-", "text": text}
    items.append(item)
    write_memory(path, items)
    return item, cut


def memory_section(name):
    """The dispatch section with the agent's last MEMORY_TAIL entries, or ""."""
    items = read_memory(memory_path_agent(name))[-MEMORY_TAIL:]
    if not items:
        return ""
    return "## Was du hier gelernt hast\n\n" + "\n".join(memory_line(x) for x in items)


def memory_selector(a, write=False):
    """(path, label) for `--agent`/`--repo`; a repo path must exist and, for a write, be writable.

    `hub memory add --repo /nope` used to reach `os.makedirs` and die with a traceback, so the
    check happens here, before the lock: the same clear line `hub lesson` prints."""
    if a.agent:
        return memory_path_agent(a.agent), f"Agent {a.agent}"
    if a.repo:
        repo = os.path.abspath(os.path.expanduser(a.repo))
        if not os.path.isdir(repo):
            die(f"kein Repo: {a.repo}")
        folder = os.path.join(repo, ".herdr")
        if write and not os.access(folder if os.path.isdir(folder) else repo, os.W_OK):
            die(f"kein Repo: {a.repo} (nicht schreibbar)")
        return os.path.join(folder, "memory.md"), f"Repo {a.repo}"
    return None, ""


def cmd_memory(a):
    path, label = memory_selector(a, write=a.mcmd in ("add", "clear"))
    if a.mcmd == "add":
        if not path:
            die("hub memory add braucht --agent NAME oder --repo PFAD")
        try:
            with hub_lock():
                item, cut = add_memory(path, a.ticket or "", " ".join(a.text))
        except OSError as e:
            die(f"Gedächtnis nicht schreibbar: {path}: {e.strerror or e}")
        print(f"{label}: {len(read_memory(path))}/{MEMORY_MAX} Einträge ({path})")
        if cut:
            print(f"Hinweis: Text auf {MEMORY_TEXT_MAX} Zeichen gekürzt (mit „…“).")
        return
    if a.mcmd == "clear":
        if path:
            try:
                with hub_lock():
                    write_memory(path, [])
            except OSError as e:
                die(f"Gedächtnis nicht schreibbar: {path}: {e.strerror or e}")
            print(f"{label}: geleert")
            return
        if os.path.isdir(MEMORY):
            with hub_lock():
                for f in sorted(os.listdir(MEMORY)):
                    if f.endswith(".md"):
                        write_memory(os.path.join(MEMORY, f), [])
        print("Gedächtnis geleert (alle Agenten)")
        return
    if path:
        items = read_memory(path)
        if a.json:
            print(json.dumps(items, ensure_ascii=False))
            return
        print(f"{label} ({path})")
        for x in items:
            print(memory_line(x))
        return
    everything = {}
    try:
        files = sorted(f for f in os.listdir(MEMORY) if f.endswith(".md"))
    except OSError:
        files = []
    for f in files:
        everything[f[:-3]] = read_memory(os.path.join(MEMORY, f))
    if a.json:
        print(json.dumps(everything, ensure_ascii=False))
        return
    if not everything:
        print("kein Gedächtnis")
        return
    for name, items in everything.items():
        print(f"{name}:")
        for x in items:
            print(memory_line(x))


# ---- machines: local commands, or through `hc exec --on`

def run(argv, on=None, cwd=None, check=True):
    try:
        if on:
            cmd = ["hc", "exec", "--on", on] + (["sh", "-c", f"cd {shlex.quote(cwd)} && exec \"$@\"", "sh"] if cwd else []) + argv
            r = subprocess.run(cmd, capture_output=True, text=True)
        else:
            r = subprocess.run(argv, capture_output=True, text=True, cwd=cwd)
    except FileNotFoundError:
        die(f"{argv[0]} ist nicht installiert")
    if check and r.returncode != 0:
        die(f"{' '.join(argv)}: {(r.stderr or r.stdout).strip()}")
    return r


def home_of(on):
    return run(["sh", "-c", 'printf %s "$HOME"'], on).stdout.strip() if on else os.path.expanduser("~")


def shell():
    return os.environ.get("SHELL") or pwd.getpwuid(os.getuid()).pw_shell or "/bin/sh"


# ---- WIP: how much work one stage may hold (data/orchestra/wip.json)

def read_wip(me=None, space=None):
    """The limits for one factory: global defaults, plus its `mine` overrides.

    `mine` is keyed by space id; entries from before the space model (keyed by the
    orchestrator's terminal) are still read, so an upgrade keeps the limits a person
    set. `per_orchestrator` defaults to true and is only written once the file carries
    `mine` entries, so a home with one orchestrator keeps the old two-key file."""
    w = dict(WIP_DEFAULTS)
    w["per_orchestrator"] = True
    w["mine"] = {}
    try:
        with open(WIP, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    if not isinstance(data, dict):
        data = {}
    for k in WIP_STAGES:
        v = data.get(k)
        if isinstance(v, int) and not isinstance(v, bool) and v >= 0:
            w[k] = v
    if isinstance(data.get("per_orchestrator"), bool):
        w["per_orchestrator"] = data["per_orchestrator"]
    if isinstance(data.get("mine"), dict):
        w["mine"] = {str(k): v for k, v in data["mine"].items() if isinstance(v, dict)}
    # The space's entry wins over the old terminal entry.
    for key in (me, space) if space else (me,):
        own = w["mine"].get(key) if key else None
        if isinstance(own, dict):
            for k in WIP_STAGES:
                v = own.get(k)
                if isinstance(v, int) and not isinstance(v, bool) and v >= 0:
                    w[k] = v
    return w


def write_wip(w):
    os.makedirs(os.path.dirname(WIP), exist_ok=True)
    data = {k: w[k] for k in WIP_STAGES}
    mine = {k: {s: int(v[s]) for s in WIP_STAGES if isinstance(v.get(s), int)}
            for k, v in (w.get("mine") or {}).items() if isinstance(v, dict) and v}
    if mine:
        data["per_orchestrator"] = True
        data["mine"] = mine
    elif w.get("per_orchestrator") is False:
        data["per_orchestrator"] = False
    tmp = WIP + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
        f.write("\n")
    os.replace(tmp, WIP)


def wip_usage(me=None, everyone=False, space=None):
    """{arbeit: {'stage','ids','count'}, pruefung: ...} over this factory's tickets.

    Tickets without a space (old ones without a folder match) count everywhere, like
    ownerless ones did, so old work does not silently drop out of the limits.
    `everyone=True` is the global sum (`hub wip --all`)."""
    rows = my_tickets(everyone=everyone, me=me, space=space)
    out = {}
    for key, stage in WIP_STAGES.items():
        ids = [t["id"] for t in rows if t["status"] == stage]
        out[key] = {"stage": stage, "ids": ids, "count": len(ids)}
    return out


def cmd_wip(a):
    me = orchestrator_id()
    mine = my_space()
    selected = space_arg(a)
    key = selected or mine["id"] or me
    if a.pairs:
        pairs = []
        for kv in a.pairs:
            if "=" not in kv:
                die(f"erwartet arbeit=N oder pruefung=M, nicht {kv!r}")
            k, v = kv.split("=", 1)
            if k not in WIP_STAGES:
                die(f"unbekannte Stufe {k!r} (bekannt: {', '.join(WIP_STAGES)})")
            v = v.strip()
            if not re.fullmatch(r"\d{1,2}", v):
                die(f"ungültiges Limit {v!r} für {k}: eine ganze Zahl 0–99")
            pairs.append((k, int(v)))
        if a.mine and not key:
            die("hub wip --mine braucht einen Space oder Orchestrator: ein Terminal mit Label "
                "hub.role=orchestrator, HERDR_SPACE oder ein Aufruf in einem Space-Ordner")
        with hub_lock():
            w = read_wip()  # the file's defaults, not this space's overrides
            if a.mine:
                own = dict(w["mine"].get(key) or {})
                own.update(dict(pairs))
                w["mine"][key] = own
                w["per_orchestrator"] = True
            else:
                for k, v in pairs:
                    w[k] = v
            write_wip(w)
    sid = selected or mine["id"]
    w = read_wip(None if a.all else me, None if a.all else sid)
    use = wip_usage(me, everyone=a.all, space=selected)
    if a.json:
        out = {k: w[k] for k in WIP_STAGES}
        if sid:
            out.update(space=sid, space_name=space_name_of(sid))
        print(json.dumps(out, ensure_ascii=False))
        return
    scope = " (alle Spaces)" if a.all else (f" ({space_name_of(sid) or me})" if (sid or me) else "")
    for key_, stage in WIP_STAGES.items():
        print(f"{key_} {use[key_]['count']}/{w[key_]} ({len(use[key_]['ids'])} in {stage}){scope}")


def cmd_whoami(_a):
    """Who am I here: this terminal's orchestrator, its space, its open tickets, its WIP."""
    me = orchestrator_id()
    info = hc_term(me) if me else {}
    mine_space = my_space()
    mine = [t for t in my_tickets(me=me) if t["status"] != "done"]
    w = read_wip(me, mine_space["id"] or None)
    use = wip_usage(me)
    print(json.dumps({"orchestrator": me, "name": info.get("name") or "",
                      "space": mine_space["id"], "space_name": mine_space["name"],
                      "space_folder": mine_space["folder"],
                      "tickets": len(mine),
                      "wip": {k: {"limit": w[k], "count": use[k]["count"]} for k in WIP_STAGES}},
                     ensure_ascii=False))


# ---- Spaces als Kommando: was liegt wo, und wer führt die Fabrik dort

def agent_space_owners(spaces=None):
    """Agent space id → the workspace of the ticket it belongs to.

    Two independent witnesses, as the ticket says: a ticket's `agent_space`, and a
    terminal carrying `hub.ticket` inside that Herdr space (older dispatches). A space
    that is also some ticket's workspace stays a workspace. Empty spaces need one
    `hc get` each; `hc ls` rows carry no labels."""
    tickets = all_tickets()
    by_id = {t.get("id"): t for t in tickets}
    out = {}
    for t in tickets:
        ag = (t.get("agent_space") or "").strip()
        ws = ticket_space(t)
        if ag and ws and ag != ws:
            out.setdefault(ag, ws)
    workspaces = {ticket_space(t) for t in tickets}
    for s in (spaces_of_window() if spaces is None else spaces):
        sid = s.get("id") or ""
        if not sid or sid in out or sid in workspaces:
            continue
        for addr in space_terminals(s):
            tid = terminal_labels(hc_term(addr)).get("hub.ticket") or ""
            t = by_id.get(tid)
            ws = ticket_space(t) if t else ""
            if ws and ws != sid:
                out[sid] = ws
                break
    return out


def space_rows():
    """One row per factory: identity, kind, its live orchestrator and the work it holds.

    `kind` is "workspace" for a factory and "agent" for the throwaway Herdr space a
    ticket's agent runs in (`workspace` then names the ticket's workspace). Spaces with
    neither tickets nor an orchestrator stay workspaces.

    `cost` is every ticket of the space; `cost_open` only those not done — the rule of
    the budget line in `hub status` (`teamCost`), so the two surfaces can agree."""
    empty = lambda: {"tickets": 0, "open": {s: 0 for s in ("todo", "doing", "review")},
                     "cost": 0.0, "cost_open": 0.0}
    per = costs().get("tickets") or {}
    counts, names, workspaces = {}, {}, set()
    for t in all_tickets():
        sid = ticket_space(t)
        workspaces.add(sid)
        row = counts.setdefault(sid, empty())
        row["tickets"] += 1
        if t.get("status") in row["open"]:
            row["open"][t["status"]] += 1
        row["cost"] += float(per.get(t["id"]) or 0)
        if t.get("status") != "done":
            row["cost_open"] += float(per.get(t["id"]) or 0)
        if sid and not names.get(sid):
            names[sid] = (t.get("space_name") or "") if (t.get("space") or "") == sid else ""
    owners = agent_space_owners()
    def kind_of(sid):
        if sid in owners and sid not in workspaces:
            return "agent", owners[sid]
        return "workspace", ""
    out = []
    for s in (norm_space(x) for x in spaces_of_window()):
        c = counts.pop(s["id"], None) or empty()
        addr, info = orchestrator_of(s)
        kind, workspace = kind_of(s["id"])
        out.append({**s, "kind": kind, "workspace": workspace,
                    "orchestrator": addr, "live": info.get("state") == "live",
                    "tickets": c["tickets"], "open": c["open"],
                    "cost": round(c["cost"], 2), "cost_open": round(c["cost_open"], 2)})
    # A space the window no longer lists (closed, another window) still has its work.
    for sid, c in counts.items():
        kind, workspace = kind_of(sid)
        out.append({"id": sid, "name": names.get(sid) or (space_name_of(sid) if sid else "ohne Workspace"),
                    "folder": "", "machine": sid.split("/", 1)[0] if "/" in sid else "",
                    "kind": kind, "workspace": workspace,
                    "orchestrator": "", "live": False, "tickets": c["tickets"],
                    "open": c["open"], "cost": round(c["cost"], 2),
                    "cost_open": round(c["cost_open"], 2)})
    return out


def adopt_rows(to_space=None):
    """Tickets without a workspace space, with the space their repo belongs to ("" = none).

    An old ticket's `space` is the agent's throwaway space (no `space_name`); it does
    not count as a workspace and is preserved as `agent_space` when the repo matches.
    `to_space` catches every ticket no folder explains."""
    out = []
    for t in all_tickets():
        if (t.get("space") or "").strip() and (t.get("space_name") or "").strip():
            continue
        sid = ticket_space(t)
        sname = space_name_of(sid) if sid else ""
        if not sid and to_space:
            sid, sname = to_space["id"], to_space["name"]
        out.append({"id": t["id"], "title": t.get("title") or "", "repo": t.get("repo") or "",
                    "space": sid, "space_name": sname,
                    "old_agent_space": "" if (t.get("agent_space") or "").strip() else (t.get("space") or "")})
    return out


def cmd_spaces(a):
    mine = my_space()
    if a.yes and not a.adopt:
        die("--yes gehört zu --adopt: hub spaces --adopt --yes")
    if a.to and not a.adopt:
        die("--to gehört zu --adopt: hub spaces --adopt --to <id|name>")
    if a.adopt:
        to_space = space_ref(a.to) if a.to else None
        rows = adopt_rows(to_space)
        if a.json:
            print(json.dumps({"dry_run": not a.yes, "adopt": rows}, ensure_ascii=False))
        else:
            for r in rows:
                target = f"{r['space_name'] or r['space']} ({r['space']})" if r["space"] else "ohne Workspace — bleibt"
                print(f"{r['id']:<40} → {target}")
            if not rows:
                print("keine Alt-Tickets ohne space")
        if a.yes:
            written = 0
            for r in rows:
                if not r["space"]:
                    continue  # no folder holds its repo: leave it visible everywhere
                with hub_lock():
                    update_ticket(r["id"], lambda fresh, r=r: fresh.update(
                        space=r["space"], space_name=r["space_name"],
                        **({"agent_space": r["old_agent_space"]} if r["old_agent_space"] else {})))
                written += 1
            if not a.json:
                print(f"{written} Ticket(s) übernommen")
        return
    rows = space_rows()
    if not getattr(a, "agents", False):
        rows = [r for r in rows if r.get("kind") != "agent"]
    if a.json:
        print(json.dumps({"space": mine["id"], "space_name": mine["name"], "spaces": rows},
                         ensure_ascii=False))
        return
    print(f"{'Space':<24} {'ID':<40} {'Ordner':<40} {'Orchestrator':<10} {'offen (todo/doing/review)':<24} {'offen':>7} {'gesamt':>7}")
    for r in rows:
        mine_mark = " *" if r["id"] == mine["id"] else ""
        open_ = f"{r['open']['todo']}/{r['open']['doing']}/{r['open']['review']}"
        label = r["name"] + (f" (Agent von {space_name_of(r['workspace'])})" if r.get("kind") == "agent" else "")
        print(f"{(label + mine_mark):<24} {r['id']:<40} {(r['folder'] or '—')[:40]:<40} "
              f"{(r['orchestrator'] or '—'):<10} {open_:<24} {r['cost_open']:>7.2f} {r['cost']:>7.2f}")


# ---- Orchestrator je Space: starten, ersetzen, anzeigen

def orchestrator_ws(on=None):
    return os.path.join(home_of(on), ".herdr", "orchestrator")


def write_orchestrator_rules(ws, on=None):
    """AGENTS.md/CLAUDE.md from the mod, on the machine the space lives on."""
    src = os.path.join(APP, "mods", "orchestra", "orchestrator.md")
    if not os.path.exists(src):
        src = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "orchestrator.md")
    try:
        with open(src, encoding="utf-8") as f:
            text = f.read()
    except OSError as e:
        die(f"Orchestrator-Regeln nicht lesbar: {e}")
    q = shlex.quote
    if run(["sh", "-c", f"mkdir -p {q(ws)}"], on, check=False).returncode != 0:
        die(f"Arbeitsordner {ws} nicht anlegbar" + (f" auf {on}" if on else ""))
    for name in ("AGENTS.md", "CLAUDE.md"):
        path = os.path.join(ws, name)
        if not on:
            with open(path, "w", encoding="utf-8") as f:
                f.write(text)
            continue
        r = subprocess.run(["hc", "file", "write", "--on", on, path], input=text,
                           capture_output=True, text=True)
        if r.returncode != 0:
            die(f"{path}: {(r.stderr or r.stdout).strip()}")


def end_orchestrator(addr):
    subprocess.run(["hc", "kill", addr], capture_output=True, text=True)
    subprocess.run(["hc", "wait", addr, "--timeout", "5"], capture_output=True, text=True)


def orchestrator_names():
    try:
        rows = json.loads(subprocess.run(["hc", "ls", "--json"], capture_output=True, text=True).stdout)
    except (OSError, ValueError):
        rows = {}
    return {x.get("name") or "" for x in rows.get("terminals") or [] if x.get("name")}


def orchestrator_prompt(space, ws):
    return (f"Du bist der Orchestrator für den Space {space['name']} "
            f"(ID {space['id']}, Ordner {space['folder'] or '—'}). "
            f"Dein Arbeitsordner ist {ws}, dessen AGENTS.md gilt. "
            "Alle Tickets, WIP-Zahlen und die Timeline dieses Space gehören dir; hub ohne --space "
            "filtert auf diesen Space. Warte auf Aufträge des Menschen.")


def cmd_orchestrator_start(a):
    sp = space_ref(a.space) if getattr(a, "space", None) else my_space()
    if not sp or not sp["id"]:
        die("kein Space: --space <id|name> angeben oder aus einem Space-Ordner starten "
            "(HERDR_SPACE, Terminal-Label herdr.space)")
    addr, info = orchestrator_of(sp)
    if addr and info.get("state") != "finished":
        if not a.restart:
            die(f"Im Space {sp['name']} läuft schon ein Orchestrator: {addr} "
                f"(hc send {addr} \"…\"); hub orchestrator start --space {sp['id']} --restart ersetzt ihn")
        end_orchestrator(addr)
    on = sp.get("machine") or None
    ws = orchestrator_ws(on)
    write_orchestrator_rules(ws, on)
    key = (a.agent or "omp").strip() or "omp"
    argv_prog = list(AGENTS[key]) if key in AGENTS else (shlex.split(key) or [key])
    taken = orchestrator_names() | {x["orchestrator"] for x in space_rows() if x["orchestrator"]}
    name = ORCH_NAME
    if name in taken:
        name = (f"{ORCH_NAME}-{slug(sp['name'] or sp['id'], 24) or 'space'}")[:32]
    while name in taken:
        name = f"{name[:26]}-{secrets.token_hex(2)}"
    prompt = orchestrator_prompt(sp, ws)
    if on:
        launch = ["sh", "-lc", '"$@"; exec "${SHELL:-sh}" -l', "sh", *argv_prog, prompt]
    else:
        sh = shell()
        launch = [sh, "-lic", '"$@"; exec "$0" -li', sh, *argv_prog, prompt]
    labels = ["--label", "hub.role=orchestrator", "--label", f"hub.space={sp['id']}",
              "--label", f"herdr.space={sp['id']}"]
    cmd = ["hc", "run", "--bg", "--json", "--keep", "--no-parent", "--name", name,
           "--cwd", ws, *labels]
    if on:
        cmd += ["--on", on]
    r = subprocess.run(cmd + ["--", *launch], capture_output=True, text=True)
    if r.returncode != 0:
        die(f"hc run: {(r.stderr or r.stdout).strip()}")
    out = json.loads(r.stdout)
    event("orchestrator", "", key, out.get("address") or "",
          f"Orchestrator für {sp['name']} gestartet", space=sp["id"])
    print(json.dumps({"space": sp["id"], "space_name": sp["name"], "folder": sp["folder"],
                      "terminal": out.get("address") or "", "name": name, "agent": key,
                      "cwd": ws}, ensure_ascii=False))


def cmd_orchestrator_list(a):
    rows, seen = [], set()
    for s in (norm_space(x) for x in spaces_of_window()):
        addr, info = orchestrator_of(s)
        if not addr:
            continue
        seen.add(addr)
        rows.append({"space": s["id"], "space_name": s["name"], "folder": s["folder"],
                     "terminal": addr, "name": info.get("name") or "",
                     "agent": (info.get("foreground") or {}).get("name") or "",
                     "live": info.get("state") == "live"})
    # Same snapshot as `hub spaces`: an orchestrator whose space the window no longer
    # lists still shows up (closed space, another window, a remote machine).
    for addr, info in orchestrator_terminals().items():
        if addr in seen:
            continue
        info = {**info, **(hc_term(addr) or {})}
        labels = info.get("labels") or {}
        seen.add(addr)
        sid = labels.get("hub.space") or labels.get("herdr.space") or ""
        rows.append({"space": sid, "space_name": space_name_of(sid) if sid else "", "folder": "",
                     "terminal": addr, "name": info.get("name") or "",
                     "agent": (info.get("foreground") or {}).get("name") or "",
                     "live": info.get("state") == "live"})
    if a.json:
        print(json.dumps({"orchestrators": rows}, ensure_ascii=False))
        return
    if not rows:
        print("kein Orchestrator läuft")
        return
    for r in rows:
        print(f"{r['space'] or '—':<40} {(r['space_name'] or '—'):<24} {r['terminal']:<12} "
              f"{(r['name'] or '—'):<24} {'läuft' if r['live'] else 'beendet'}")


ABNAHME = "## Abnahmekriterien"
SPEC_SECTIONS = ["## Ziel", ABNAHME, "## Grenzen"]
SPEC_TEMPLATE = {
    "## Ziel": "Was danach anders ist, in einem Satz.\n",
    ABNAHME: "- [ ] <was von außen prüfbar ist>\n",
    "## Grenzen": "- <was dieses Ticket nicht anfasst>\n",
}
CRITERION = re.compile(r"^\s*[-*]\s*\[([ xX])\]\s*(.*\S)\s*$")


def section_of(t, heading):
    """The body of one `##` section, or None when the heading is absent."""
    m = re.search(rf"(?ms)^{re.escape(heading)}[ \t]*\n(.*?)(?=^## |\Z)", t.get("body") or "")
    return m.group(1).strip("\n") if m else None


def criteria(t):
    """(text, checked) of the acceptance criteria; a `<…>` template line does not count."""
    text = section_of(t, ABNAHME)
    if text is None:
        return []
    out = []
    for line in text.splitlines():
        m = CRITERION.match(line)
        if not m:
            continue
        what = m.group(2).strip()
        if re.fullmatch(r"<.*>", what):
            continue
        out.append((what, m.group(1).lower() == "x"))
    return out


def add_spec_sections(t):
    """Insert the missing Ziel/Abnahme/Grenzen sections as a template; existing ones stay.

    They go in their own order at the end of the body, just before ## Verlauf when present.
    """
    body, verlauf = split_verlauf(t.get("body"))
    added = []
    for heading in SPEC_SECTIONS:
        if section_of(t, heading) is not None:
            continue
        body = (body.rstrip("\n") + "\n\n" if body else "") + f"{heading}\n\n{SPEC_TEMPLATE[heading].rstrip(chr(10))}"
        added.append(heading[3:])
    t["body"] = (body + "\n") if not verlauf else (body.rstrip("\n") + "\n\n" + verlauf + "\n")
    return added


def cmd_spec(a):
    with hub_lock():
        t = load(a.id)
        if t["status"] in ("done", "review") and not getattr(a, "force", False):
            die(f"{a.id}: Ticket ist {t['status']} — Abschnitte nur mit --force ergänzen")
        added = add_spec_sections(t)
        if added:
            write(t)
    print(f"{a.id}: " + (f"ergänzt {', '.join(added)}" if added else "alle Abschnitte vorhanden"))
    for heading in SPEC_SECTIONS:
        print(f"\n{heading}\n\n{section_of(t, heading) or ''}".rstrip())


# ---- Triage: turn a raw signal (title/body) into a startable ticket

TRIAGE_BUG = re.compile(r"(?i)\b(fehler\w*|falsch\w*|absturz\w*|abstürz\w*|regression\w*)\b")
TRIAGE_CHORE = re.compile(r"(?i)\b(aufräum\w*|aufraeum\w*|docs?|doku\w*|ci|chore|refactor\w*)\b")
TRIAGE_P1 = re.compile(r"(?i)\b(absturz\w*|abstürz\w*|datenverlust\w*|sicherheit\w*)\b")
TRIAGE_P3 = re.compile(r"(?i)\b(nice|optional|irgendwann|später)\b")
TRIAGE_BIG = re.compile(r"(?i)\b(umbau\w*|migrier\w*|migration\w*|refactor\w*|integrier\w*|neubau\w*|redesign\w*|überarbeit\w*|komplett\w*|architektur\w*)\b")


def triage_guess(t):
    """type, size and priority from the title/body text plus the labels to set."""
    text = f"{t.get('title') or ''}\n{t.get('body') or ''}"
    what = "bug" if TRIAGE_BUG.search(text) else ("chore" if TRIAGE_CHORE.search(text) else "feature")
    prio = "p1" if TRIAGE_P1.search(text) else ("p3" if TRIAGE_P3.search(text) else "p2")
    # Size: text length in words plus the verbs that mean a broad change. Every such
    # verb pads the score as much as 120 words of prose, so "migration" is not size S
    # just because the ticket is short.
    words = len(re.findall(r"\w+", text))
    score = words + 120 * len(TRIAGE_BIG.findall(text))
    size = "S" if score < 200 else ("M" if score < 1000 else "L")
    labels = names(t.get("labels"))
    for want in (what, f"size-{size.lower()}", prio):
        if want not in labels:
            labels.append(want)
    missing = [h[3:] for h in SPEC_SECTIONS if section_of(t, h) is None]
    return {"type": what, "size": size, "priority": prio, "labels": labels, "missing": missing}


def set_triage(t, g):
    t.update(type=g["type"], size=g["size"], priority=g["priority"],
             labels=", ".join(g["labels"]), triaged=now_stamp())


def cmd_triage(a):
    with hub_lock():
        t = load(a.id)
        g = triage_guess(t)
        if a.apply:
            set_triage(t, g)
            add_spec_sections(t)
            write(t)
    out = {k: g[k] for k in ("type", "size", "priority", "labels", "missing")}
    out.update(id=a.id, applied=bool(a.apply))
    if a.json:
        print(json.dumps(out, ensure_ascii=False))
        return
    print(f"{a.id}: Typ {g['type']} · Größe {g['size']} · Priorität {g['priority']}")
    print(f"Labels: {', '.join(g['labels'])}")
    print("Fehlende Abschnitte: " + (", ".join(g["missing"]) or "keine"))
    print("Übernommen mit --apply." if a.apply else "Nur Vorschlag; schreiben mit --apply.")


# ---- Preflight: the base must pass the repo's check before an agent starts on it

PREFLIGHT = "## Preflight"
PREFLIGHT_TAIL = 10   # lines of output kept in the ticket


def preflight_section(t):
    """The ## Preflight section: its meta line and the captured output lines."""
    m = re.search(r"(?ms)^## Preflight[ \t]*\n(.*?)(?=\n## |\Z)", t.get("body") or "")
    if not m:
        return {"meta": "", "tail": []}
    lines = m.group(1).strip("\n").splitlines()
    meta = lines[0][2:].strip() if lines and lines[0].startswith("- ") else ""
    tail, fenced = [], False
    for line in lines:
        if line.lstrip().startswith("```"):
            fenced = not fenced
            continue
        if fenced:
            tail.append(line)
    return {"meta": meta, "tail": tail}


def set_preflight(t, text):
    """Replace ## Preflight in the body, keeping it just before ## Verlauf."""
    body = re.sub(r"(?ms)^## Preflight[ \t]*\n.*?(?=\n## |\Z)", "", t.get("body") or "").strip("\n")
    block = f"{PREFLIGHT}\n{text}".rstrip("\n")
    m = re.search(r"(?m)^## Verlauf[ \t]*$", body)
    body = (body[:m.start()].rstrip("\n") + "\n\n" + block + "\n\n" + body[m.start():]) if m else \
        (body + "\n\n" + block if body else block)
    t["body"] = body.strip("\n") + "\n"


def run_preflight(t):
    """Check the base out in a throwaway worktree, run the check there, drop the worktree.

    Returns (state, tail, message) with state pass|fail|skip. `skip` means the repo has
    no check at all, so there is nothing a red base could fail: dispatch goes on and
    says so. The record is written for pass and fail only."""
    on = t.get("machine") or None
    repo = t.get("repo") or ""
    if not repo or run(["test", "-d", repo], on, check=False).returncode != 0:
        die(f"{t['id']}: kein Repo: hub ticket set {t['id']} repo=/pfad")
    rev = (t.get("base_head") or t.get("base") or "").strip()
    if not rev:
        die(f"{t['id']}: keine Basis im Ticket (base/base_head); hub dispatch schreibt sie")
    top = run(["git", "rev-parse", "--show-toplevel"], on, repo, check=False)
    if top.returncode != 0:
        die(f"{t['id']}: kein Git-Repository in {repo}: {(top.stderr or top.stdout).strip()}")
    root = top.stdout.strip()
    tmp = run(["mktemp", "-d"], on).stdout.strip()
    if not tmp:
        die(f"{t['id']}: mktemp -d lieferte kein Verzeichnis")
    started = time.monotonic()
    head, label, code, output = "", "", 0, ""
    try:
        add = run(["git", "worktree", "add", "--detach", tmp, rev], on, root, check=False)
        if add.returncode != 0:
            output = f"Basis {rev} nicht auscheckbar: {(add.stderr or add.stdout).strip()}"
            code = add.returncode
        else:
            head = run(["git", "rev-parse", "HEAD"], on, tmp, check=False).stdout.strip()
            script = os.path.join(tmp, ".herdr", "verify.sh")
            fallback = (t.get("verify") or "").strip()
            if run(["test", "-f", script], on, check=False).returncode == 0:
                argv, label = ["sh", script], ".herdr/verify.sh"
            elif fallback:
                argv, label = ["sh", "-c", fallback], " ".join(fallback.split())
            else:
                return "skip", [], "kein Prüfbefehl (.herdr/verify.sh und verify fehlen)"
            r = run(argv, on, tmp, check=False)
            code = r.returncode
            output = "\n".join(p.rstrip("\n") for p in (r.stdout or "", r.stderr or "") if p)
    finally:
        run(["git", "worktree", "remove", "--force", tmp], on, root, check=False)
        run(["rm", "-rf", tmp], on, check=False)
    duration = time.monotonic() - started
    tail = output.splitlines()[-PREFLIGHT_TAIL:]
    ok = code == 0
    at = time.strftime("%Y-%m-%d %H:%M")
    fields = {"preflight": "pass" if ok else "fail", "preflight_at": at,
              "preflight_head": head or rev, "preflight_duration": f"{duration:.1f}"}
    fence = "`" * (max([len(m) for line in tail for m in re.findall(r"`+", line)] + [2]) + 1)
    block = (f"- {at} · {'pass' if ok else 'fail'} · {duration:.1f} s · exit {code} · "
             f"HEAD {(head or rev)[:7]} · {label or '-'}\n\n"
             f"{fence}text\n{chr(10).join(tail)}\n{fence}")

    def saved(fresh):
        fresh.update(fields)
        set_preflight(fresh, block)

    update_ticket(t["id"], saved)
    t.update(fields)  # the caller prints these; the file is written from a fresh copy
    return ("pass" if ok else "fail"), tail, f"Preflight {'pass' if ok else 'fail'} · {duration:.1f} s · exit {code}"


def preflight_gate(t):
    """Refuse a red recorded preflight; run a missing one. Writes the ticket itself."""
    state = (t.get("preflight") or "").strip()
    tail = preflight_section(t)["tail"]
    if state == "fail":
        die(f"{t['id']}: Preflight rot auf {(t.get('preflight_head') or '?')[:7]}: "
            + (" / ".join(tail) or "keine Ausgabe aufgezeichnet")
            + f"; erneut mit hub preflight {t['id']}")
    if state == "pass":
        return
    state, tail, msg = run_preflight(t)
    if state == "skip":
        print("Preflight übersprungen — kein Prüfbefehl")
        return
    print(f"Preflight {state} — gestartet")
    if state != "pass":
        die(f"{t['id']}: Preflight rot: " + (" / ".join(tail) or "keine Ausgabe"))


def cmd_preflight(a):
    t = load(a.id)
    state, tail, msg = run_preflight(t)
    out = {"id": a.id, "preflight": state, "at": t.get("preflight_at"),
           "head": t.get("preflight_head"), "duration": t.get("preflight_duration"), "tail": tail}
    if a.json:
        print(json.dumps(out, ensure_ascii=False))
        return
    print(f"{a.id}: {msg}" + ("" if state == "skip" else f" ({len(tail)} Zeilen Ausgabe unter {PREFLIGHT})"))


# ---- Stalls: tickets that sit in one station too long, and the nudge into the ticket

STALL_STAGES = [("doing", "In Arbeit", 45), ("review", "Prüfung", 120), ("todo", "Geplant", 1440)]


def stall_rows(doing=45, review=120, todo=1440, everyone=False, space=None):
    limits = {"doing": doing, "review": review, "todo": todo}
    labels = {k: label for k, label, _ in STALL_STAGES}
    now = time.time()
    rows = []
    for t in my_tickets(everyone=everyone, space=space):
        stage = t.get("status")
        at = epoch(t.get("status_at"))
        if stage not in limits or at is None:
            continue
        minutes = int((now - at) // 60)
        if minutes < limits[stage]:
            continue
        rows.append({"stage": stage, "stage_label": labels[stage], "id": t["id"],
                     "title": t.get("title") or "",
                     "space": ticket_space(t), "space_name": ticket_space_name(t),
                     "agent": t.get("agent") or t.get("assignee") or "",
                     "age_minutes": minutes, "age": age(t.get("status_at")),
                     "nudge": f"hub nudge {t['id']}", "threshold": limits[stage]})
    order = {k: i for i, (k, _, _) in enumerate(STALL_STAGES)}
    rows.sort(key=lambda r: (order[r["stage"]], -r["age_minutes"], r["id"]))
    return rows


def cmd_stalls(a):
    rows = stall_rows(a.doing, a.review, a.todo, everyone=a.all, space=space_arg(a))
    if a.json:
        print(json.dumps(rows, ensure_ascii=False))
        return
    if not rows:
        print("keine hängenden Tickets")
        return
    for stage, label, default in STALL_STAGES:
        group = [r for r in rows if r["stage"] == stage]
        if not group:
            continue
        print(f"{label} (>{group[0]['threshold']} min)")
        for r in group:
            print(f"  {r['id']:<40} {r['agent'] or '-':<10} seit {r['age']:<8} → {r['nudge']}")


def cmd_nudge(a):
    t = load(a.id)
    me = orchestrator_id()
    mine = my_space()
    owner = (t.get("owner") or "").strip()
    if not owns(t, me) and not a.force:
        foreign = owner or ticket_space(t) or "ein anderer Space"
        die(f"{a.id} gehört {foreign}, nicht dir ({me or mine['name'] or 'unbekannt'}); "
            f"fremde Tickets nur mit --force")
    text = one_line(a.text) or "Bitte kurz den Stand nennen: was ist erledigt, was fehlt, was blockiert?"
    addr = t.get("terminal") or ""
    sent = bool(addr and is_live(addr) and send_agent(addr, f"Stand zu {a.id}: {text}"))
    with hub_lock():
        t = load(a.id)
        add_comment(t, "orchestrator", f"Stand abgefragt: {text}")
        write(t)
        event("nudge", a.id, t.get("agent") or t.get("assignee") or "", author_terminal("orchestrator"), text)
    print(f"{a.id}: " + (f"Nachricht an {addr} gesendet; Kommentar geschrieben"
                         if sent else "Agent nicht lebend; nur Kommentar geschrieben"))


# ---- Night: work the queue while nobody is there, one ticket at a time

NIGHT = "## Nachtschicht"
NIGHT_STEP = max(0, env_int("HUB_NIGHT_STEP", 60))   # seconds between dispatches


def night_rank(t):
    prio = {"p1": 0, "p2": 1, "p3": 2}.get((t.get("priority") or "p2").lower(), 1)
    return (prio, t.get("created") or "", t["id"])


def night_queue(everyone=False, space=None):
    return sorted((t for t in my_tickets(everyone=everyone, space=space) if t.get("status") == "todo"),
                  key=night_rank)


def night_block(t):
    """Why this todo ticket cannot start right now, or "" when it can."""
    blockers = open_blockers(t)
    if blockers:
        return "blockiert durch " + ", ".join(f"{b} ({st})" for b, st in blockers)
    if not criteria(t):
        return f"kein Abnahmekriterium (hub spec {t['id']})"
    gaps = dispatch_gates(t)
    if gaps:
        return " · ".join(gaps)
    who = roster_of(t.get("assignee") or "omp")
    if who:
        limit = int(who.get("wip") or 0)
        running = doing_of(who["name"], skip=t["id"])
        if limit > 0 and len(running) >= limit:
            return f"Agent-WIP {who['name']} {len(running)}/{limit}: " + ", ".join(x["id"] for x in running)
    return ""


def night_deadline(a):
    now = time.time()
    deadline = None
    if a.for_min is not None:
        if a.for_min < 0:
            die("--for erwartet Minuten >= 0")
        deadline = now + a.for_min * 60
    if a.until:
        m = re.fullmatch(r"(\d{1,2}):(\d{2})", a.until.strip())
        if not m or int(m.group(1)) > 23 or int(m.group(2)) > 59:
            die("--until erwartet HH:MM")
        lt = time.localtime(now)
        when = time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday,
                            int(m.group(1)), int(m.group(2)), 0, 0, 0, -1))
        if when <= now:  # the next time that clock shows; tonight or tomorrow
            when += 86400
        deadline = when if deadline is None else min(deadline, when)
    return deadline


def night_dispatch(tid, agent):
    """One dispatch in a child hub: its refusal must not end the whole night."""
    return subprocess.run([sys.executable, os.path.abspath(__file__), "dispatch", tid, "--agent", agent],
                          capture_output=True, text=True)


def add_night_section(t, text):
    """Append one run block to ## Nachtschicht, keeping the section before ## Verlauf."""
    body = t.get("body") or ""
    block = text.rstrip("\n")
    m = re.search(r"(?ms)^## Nachtschicht[ \t]*\n(.*?)(?=\n## |\Z)", body)
    if m:
        body = body[:m.start()] + m.group(0).rstrip("\n") + "\n\n" + block + body[m.end():]
    else:
        v = re.search(r"(?m)^## Verlauf[ \t]*$", body)
        body = (body[:v.start()].rstrip("\n") + "\n\n" + NIGHT + "\n\n" + block + "\n\n" + body[v.start():]) \
            if v else (body.rstrip("\n") + "\n\n" + NIGHT + "\n\n" + block if body.strip() else NIGHT + "\n\n" + block)
    t["body"] = body.strip("\n") + "\n"


def night_record(started, skipped, begin, end):
    lines = [f"- {begin} → {end} · {len(started)} gestartet, {len(skipped)} übersprungen",
             "  - gestartet: " + (", ".join(started) or "—")]
    for tid, why in skipped.items():
        lines.append(f"  - übersprungen {tid}: {why}")
    return "\n".join(lines)


def cmd_night(a):
    deadline = night_deadline(a)
    begin = now_stamp()
    if a.dry_run:
        rows = [(t["id"], night_block(t)) for t in night_queue(everyone=a.all, space=space_arg(a))]
        startable = [(tid, why) for tid, why in rows if not why]
        if not startable:
            print("nichts startbar")
            return
        print("Reihenfolge:")
        for i, (tid, _) in enumerate(startable, 1):
            print(f"  {i}. {tid}")
        skipped = [(tid, why) for tid, why in rows if why]
        if skipped:
            print("übersprungen:")
            for tid, why in skipped:
                print(f"  - {tid}: {why}")
        return
    started, skipped, attempted = [], {}, set()
    while True:
        if a.max is not None and a.max >= 0 and len(started) >= a.max:
            break
        if deadline is not None and time.time() >= deadline:
            break
        candidate, order = None, []
        for t in night_queue(everyone=a.all, space=space_arg(a)):
            if t["id"] in started or t["id"] in attempted:
                continue
            why = night_block(t)
            if why:
                skipped.setdefault(t["id"], why)
                continue
            order.append(t)
            if candidate is None:
                candidate = t
        if candidate is None:
            break
        r = night_dispatch(candidate["id"], candidate.get("assignee") or "omp")
        if r.returncode == 0:
            started.append(candidate["id"])
            event("night", candidate["id"], candidate.get("assignee") or "omp", "", "Start")
            print(f"gestartet: {candidate['id']}")
        else:
            attempted.add(candidate["id"])
            text = (r.stderr or r.stdout).strip()
            why = one_line(text.splitlines()[-1]) if text else "unbekannt"
            skipped[candidate["id"]] = why
            print(f"übersprungen: {candidate['id']} — {why}")
        if a.max is not None and a.max >= 0 and len(started) >= a.max:
            break
        more = [t for t in order if t["id"] not in started and t["id"] not in attempted]
        if not more:
            break
        if deadline is not None and time.time() + NIGHT_STEP > deadline:
            break
        time.sleep(NIGHT_STEP)
    end = now_stamp()
    record = night_record(started, skipped, begin, end)
    for tid in started:
        t = update_ticket(tid, lambda fresh: add_night_section(fresh, record))
        event("night", tid, t.get("agent") or "", t.get("terminal") or "", "Stopp")
    print(f"Nachtschicht: {len(started)} gestartet, {len(skipped)} übersprungen ({begin} → {end})")


# ---- commands

def cmd_new(a):
    if not (a.title or "").strip():
        die("--title darf nicht leer sein")
    body = a.body
    if a.body_file:
        body = open(a.body_file, encoding="utf-8").read()
    elif body == "-":
        body = sys.stdin.read()
    base = slug(a.title) or "ticket"
    sp = space_ref(a.space) if getattr(a, "space", None) else my_space()
    t = {"title": a.title, "repo": a.repo or "", "labels": a.labels or "",
         "machine": a.on or "", "source": a.source or "", "by": "orchestrator",
         "owner": orchestrator_id(), "space": (sp or {}).get("id") or "",
         "space_name": (sp or {}).get("name") or "", "body": (body or "").strip() + "\n"}
    t["created"] = now_stamp()
    set_status(t, "todo", t["created"])
    print(claim_ticket(t, base))


def claim_ticket(t, base):
    """Create one ticket file under a free id and return that id.

    O_CREAT|O_EXCL is the claim: the kernel decides who owns a name, so two parallel
    `hub ticket new` calls can never write the same file, even if the lock is bypassed
    (an old hub, a different home path). A taken id moves on to `-2`, `-3`, … instead of
    failing, so every caller keeps its own ticket. The lock only keeps the numbering
    tidy: without it the losers would still win the next free number."""
    os.makedirs(TICKETS, exist_ok=True)
    with hub_lock():
        n = 1
        while True:
            tid = base if n == 1 else f"{base}-{n}"
            try:
                fd = os.open(path_of(tid), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
            except FileExistsError:
                n += 1
                continue
            os.close(fd)
            break
        t["id"] = tid
        write(t)
    return tid


def cmd_list(a):
    rows = my_tickets(everyone=getattr(a, "all", False), space=space_arg(a))
    rows = [t for t in rows if a.all or t["status"] != "done"]
    if a.agent:
        rows = [t for t in rows if a.agent in (t.get("assignee"), *names(t.get("tags")), *names(t.get("waiting")))]
    if a.json:
        out = []
        for t in rows:
            row = {k: v for k, v in t.items() if k != "body"}
            row["space"] = ticket_space(t)
            row["space_name"] = ticket_space_name(t)
            row["comments"] = len(entries(t))
            out.append(row)
        print(json.dumps(out, ensure_ascii=False, indent=1))
        return
    for t in rows:
        who = agent_display(t.get("assignee")) or agent_display(t.get("agent"))
        print(f"{t['id']:<40} {t['status']:<7} {who:<10} {t.get('terminal', ''):<14} {t['title']}")


def cmd_show(a):
    t = load(a.id)
    for k in FIELDS:
        if t.get(k):
            print(f"{k}: {agent_display(t[k]) if k == 'agent' else t[k]}")
    print()
    print(t["body"].rstrip())


def cmd_comment(a):
    who = re.sub(r"[·\r\n]+", " ", a.role).strip() or "mensch"
    text = " ".join(a.text)
    with hub_lock():
        t = load(a.id)
        add_comment(t, who, text)
        write(t)
        event("comment", a.id, who, author_terminal(who), text)
        count = len(entries(t))
    print(f"{a.id}: Verlauf, {count} Einträge")


def cmd_assign(a):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", a.agent):
        die(f"bad agent name {a.agent!r}")
    with hub_lock():
        t = load(a.id)
        t["assignee"] = a.agent
        write(t)
    print(f"{a.id}: zugewiesen an {a.agent}")


def cmd_link(a):
    with hub_lock():
        t = load(a.id)
        cur = names(t.get("blocked_by"))
        for b in a.blocked_by:
            path_of(b)  # validates the id
            if b == a.id:
                die(f"{a.id} kann sich nicht selbst blockieren")
            if not os.path.exists(path_of(b)):
                die(f"no ticket {b}")
            if b in cur:
                continue
            seen, todo = set(), [b]  # a cycle would block both forever
            while todo:
                x = todo.pop()
                if x == a.id:
                    die(f"{a.id} -> {b} wäre ein Zyklus")
                if x in seen:
                    continue
                seen.add(x)
                p = path_of(x)
                if os.path.exists(p):
                    todo += names((read(x) or {}).get("blocked_by"))
            cur.append(b)
        t["blocked_by"] = ", ".join(cur)
        write(t)
    print(f"{a.id}: blocked_by {t['blocked_by'] or '-'}")


def cmd_next(a):
    for t in my_tickets(space=space_arg(a)):
        if t["status"] == "todo" and t.get("assignee") == a.agent and not open_blockers(t):
            print(f"{t['id']}\t{t['title']}")
            return
    die(f"kein startbares Ticket für {a.agent} (todo, ihm zugewiesen, nicht blockiert)")


def inbox_rows(agent, space=None):
    rows = []
    for t in my_tickets(space=space):
        if t["status"] == "done":
            continue
        reasons, question, stamp = [], "", t.get("updated") or ""
        if t.get("assignee") == agent:
            reasons.append("zugewiesen")
        if agent in names(t.get("waiting")):
            reasons.append("wartet")
        history = entries(t)
        if history and history[-1][1] != agent and agent in mentions(history[-1][2]):
            reasons.append("genannt")
            question, stamp = history[-1][2], history[-1][0]
        if reasons:
            row = {k: v for k, v in t.items() if k != "body"}
            row.update(reasons=reasons, question=question, age=age(stamp), comments=len(history))
            rows.append(row)
    return rows


def cmd_inbox(a):
    rows = inbox_rows(a.agent, space_arg(a))
    if a.json:
        print(json.dumps(rows, ensure_ascii=False, indent=1))
        return
    if not rows:
        print(f"{a.agent}: nichts offen")
        return
    for r in rows:
        print(f"{r['id']:<36} {r['status']:<6} {','.join(r['reasons']):<20} {r['age']:<7} {r['title']}")
        if r["question"]:
            print(f"    ? {r['question']}")


def cmd_watch(a):
    with hub_lock():
        t = load(a.id)
        waiting = names(t.get("waiting"))
        if a.agent in waiting:
            print(f"{a.id}: wartet bereits auf {a.agent}")
            return
        waiting.append(a.agent)
        t["waiting"] = ", ".join(waiting)
        write(t)
    print(f"{a.id}: wartet auf eine Antwort von {a.agent}")


def agent_changes(a):
    """The fields the command line overrides; None keeps the current value."""
    out = {}
    for field in ("name", "role", "program", "model", "repo", "branch_prefix", "notes", "color"):
        value = getattr(a, field, None)
        if value is not None:
            out[field] = str(value).strip()
    for key in ("labels", "skills", "mcp"):
        value = getattr(a, key, None)
        if value is not None:
            out[key] = as_list(value)
    if getattr(a, "prompt_file", None) is not None and getattr(a, "prompt_text", None) is not None:
        die("--prompt und --prompt-file schließen sich aus (Text schreibt die Datei)")
    if getattr(a, "prompt_file", None) is not None:
        out["prompt"] = str(a.prompt_file).strip()
    harness = {}
    for key in ("smol", "slow"):
        value = getattr(a, key, None)
        if value is not None:
            harness[key] = str(value).strip()
    if getattr(a, "approval_mode", None) is not None:
        mode = str(a.approval_mode or "").strip()
        if mode and mode not in APPROVAL_MODES:
            die(f"unbekannter Approval-Modus {mode!r} (erlaubt: {', '.join(APPROVAL_MODES)})")
        harness["approval_mode"] = mode
    if getattr(a, "max_cost", None) is not None:
        try:
            cost = float(a.max_cost)
        except (TypeError, ValueError):
            die(f"Kostenlimit muss eine Zahl sein: {a.max_cost!r}")
        if cost <= 0:
            die("Kostenlimit muss größer als 0 sein (nicht setzen = unbegrenzt)")
        harness["max_cost"] = cost
    if getattr(a, "models", None) is not None:
        harness["models"] = as_list(a.models)
    if getattr(a, "no_lsp", None) is not None:
        harness["no_lsp"] = bool(a.no_lsp)
    if harness:
        out["harness"] = harness
    if getattr(a, "sandbox", None) is not None:
        sandbox = str(a.sandbox or "").strip() or "worktree"
        if sandbox not in SANDBOXES:
            die(f"unbekannte Sandbox {sandbox!r} (erlaubt: {', '.join(SANDBOXES)})")
        out["sandbox"] = sandbox
    if getattr(a, "wip", None) is not None:
        try:
            wip = int(a.wip)
        except (TypeError, ValueError):
            die(f"WIP-Limit muss eine ganze Zahl sein: {a.wip!r}")
        if wip < 0:
            die("WIP-Limit darf nicht negativ sein (0 = unbegrenzt)")
        out["wip"] = wip
    perms = {}
    for key in PERMISSION_FIELDS:
        value = getattr(a, key, None)
        if value is not None:
            perms[key] = bool(value)
    if perms:
        out["permissions"] = perms
    return out


def agent_view(entry):
    """(key, value) rows for `hub agent show`: every field, the nested ones flattened."""
    h, p = entry["harness"], entry["permissions"]
    yes = lambda v: "ja" if v else "nein"
    return [
        ("name", entry["name"]), ("role", entry["role"]), ("color", entry["color"]),
        ("program", entry["program"]), ("model", entry["model"]),
        ("smol", h["smol"]), ("slow", h["slow"]), ("approval_mode", h["approval_mode"]),
        ("max_cost", f"{h['max_cost']:g}" if h["max_cost"] else ""),
        ("models", ", ".join(h["models"])), ("no_lsp", yes(h["no_lsp"])),
        ("prompt", entry["prompt"]), ("repo", entry["repo"]),
        ("branch_prefix", entry["branch_prefix"]), ("labels", ", ".join(entry["labels"])),
        ("skills", ", ".join(entry["skills"])), ("mcp", ", ".join(entry["mcp"])),
        ("sandbox", entry["sandbox"]), ("wip", str(entry["wip"])),
        ("push", yes(p["push"])), ("delete_branches", yes(p["delete_branches"])),
        ("notes", entry["notes"]),
    ]


def cmd_agent_list(a):
    rows = read_roster()
    if a.json:
        print(json.dumps(rows, ensure_ascii=False, indent=1))
        return
    if not rows:
        print("keine Agents")
        return
    print(f"{'Name':<16} {'Rolle':<14} {'Programm':<9} {'Modell':<34} Repo")
    for r in rows:
        print(f"{r['name']:<16} {r['role'] or '-':<14} {r['program']:<9} {r['model'] or '-':<34} {r['repo'] or '-'}")


def cmd_agent_show(a):
    rows = read_roster(required=True)
    _, found = find_agent(rows, a.name)
    if not found:
        die(f"kein Agent {a.name!r} im Roster")
    if a.json:
        print(json.dumps(found, ensure_ascii=False, indent=1))
        return
    for k, v in agent_view(found):
        print(f"{k}: {v or '-'}")


def cmd_agent_add(a):
    name = (getattr(a, "name", None) or getattr(a, "new_name", None) or "").strip()
    if not name:
        die("Name fehlt (hub agent add NAME oder --name NAME)")
    with hub_lock():
        rows = read_roster()
        if find_agent(rows, name)[1]:
            die(f"Agent {name!r} gibt es schon")
        entry = validate_agent(merge_agent(dict(ROSTER_DEFAULTS, name=name), agent_changes(a)))
        rows.append(entry)
        write_roster(rows)
    if a.prompt_text is not None:
        write_prompt(entry, a.prompt_text)
    print(f"Agent {name} angelegt")


def cmd_agent_edit(a):
    with hub_lock():
        rows = read_roster(required=True)
        idx, cur = find_agent(rows, a.current)
        if not cur:
            die(f"kein Agent {a.current!r} im Roster")
        entry = merge_agent(cur, agent_changes(a))
        if not entry["name"]:
            die("Name darf nicht leer sein")
        other, _ = find_agent(rows, entry["name"])
        if other is not None and other != idx:
            die(f"Agent {entry['name']!r} gibt es schon")
        validate_agent(entry)
        rows[idx] = entry
        write_roster(rows)
    if a.prompt_text is not None:
        write_prompt(entry, a.prompt_text)
    name = entry["name"]
    print(f"Agent {name} geändert" if name == a.current else f"Agent {a.current} in {name} umbenannt")


def cmd_agent_command(a):
    _, found = find_agent(read_roster(required=True), a.name)
    if not found:
        die(f"kein Agent {a.name!r} im Roster")
    print(shlex.join(command_argv(found)))


def cmd_agent_prompt(a):
    _, found = find_agent(read_roster(required=True), a.name)
    if not found:
        die(f"kein Agent {a.name!r} im Roster")
    text, _ = read_prompt(found)
    print(text)


def cmd_agent_rm(a):
    with hub_lock():
        rows = read_roster(required=True)
        idx, cur = find_agent(rows, a.name)
        if not cur:
            die(f"kein Agent {a.name!r} im Roster")
        rows.pop(idx)
        write_roster(rows)
    print(f"Agent {cur['name']} gelöscht")


def base_known(base, folder, on=None):
    """True when `base` names a branch or commit in the ticket's repo (no fetch)."""
    r = run(["git", "rev-parse", "--verify", "--quiet", f"{base}^{{commit}}"], on, folder, check=False)
    return r.returncode == 0


def cmd_set(a):
    unknown_base, folder, on = "", None, None
    with hub_lock():
        t = load(a.id)
        moved = None
        for kv in a.pairs:
            if "=" not in kv:
                die(f"expected key=value, got {kv!r}")
            k, v = kv.split("=", 1)
            if k not in FIELDS:
                die(f"unknown field {k} (known: {', '.join(FIELDS)})")
            if k == "status":
                moved = v
            else:
                if k == "base":
                    unknown_base = v.strip()
                t[k] = v
                if k == "space":
                    ref = space_ref(v) if v.strip() else None
                    t["space"] = (ref or {}).get("id") or ""
                    t["space_name"] = (ref or {}).get("name") or ""
                elif k == "space_name" and v.strip() and not (t.get("space") or "").strip():
                    die("space_name ohne space: erst space=<id|name> setzen")
        if moved is not None:
            set_status(t, moved)
        write(t)
        if unknown_base:
            on = t.get("machine") or None
            folder = target_of(t, on)
    # `base` may name a commit, so an unknown value is a warning, not an error. The git
    # check runs after the lock: a slow remote repo must not block another hub command.
    if unknown_base and folder and not base_known(unknown_base, folder, on):
        print(f"Basis '{unknown_base}' ist im Repo nicht bekannt", file=sys.stderr)


def is_live(address):
    try:
        r = subprocess.run(["hc", "get", address, "--json"], capture_output=True, text=True)
        return r.returncode == 0 and json.loads(r.stdout).get("state") == "live"
    except (OSError, ValueError):
        return False


def doing_of(agent_key, skip=""):
    """The agent's tickets in `doing`, except the one being dispatched again."""
    key = (agent_key or "").strip().casefold()
    out = []
    for t in all_tickets():
        if t.get("status") != "doing" or t.get("id") == skip:
            continue
        if agent_display(t.get("agent") or t.get("assignee")).casefold() == key:
            out.append(t)
    return out


def dispatch_gates(t):
    """What keeps this ticket from starting: the spec gate first, then the WIP limit.

    The count leaves the ticket itself out, so re-dispatching a dead `doing` agent is not
    blocked by its own place in the stage. The roster's per-agent WIP gate (`who.wip`) is a
    second, hard limit in cmd_dispatch; this one is the home-wide stage limit."""
    gaps = []
    if (t.get("source") or "").strip() and not (t.get("triaged") or "").strip():
        gaps.append(f"Signal ohne Triage (source gesetzt): hub triage {t['id']} --apply")
    if not criteria(t):
        gaps.append(f"kein Abnahmekriterium unter {ABNAHME} (hub spec {t['id']} legt die Vorlage an)")
    me = orchestrator_id()
    sid = ticket_space(t) or None
    w = read_wip(me, sid)
    use = wip_usage(me, space=sid)
    ids = [x for x in use["arbeit"]["ids"] if x != t["id"]]
    limit = w["arbeit"]
    if len(ids) >= limit:
        gaps.append(f"WIP-Limit für In Arbeit erreicht ({len(ids)}/{limit}): {'; '.join(ids)} "
                    f"— Limit ändern mit `hub wip arbeit={limit + 1}`")
    return gaps


def cmd_dispatch(a):
    t = load(a.id)
    blockers = open_blockers(t)
    if blockers:
        die(f"{a.id} ist blockiert durch {', '.join(f'{b} ({st})' for b, st in blockers)}; "
            f"erst abschließen (hub done <id>)")
    if t["status"] in ("doing", "review") and t.get("terminal") and is_live(t["terminal"]):
        die(f"{a.id} already runs in {t['terminal']} (status {t['status']}); talk to it with hc send")
    gaps = dispatch_gates(t)
    if gaps:
        if not a.force:
            die(f"{a.id}: {' · '.join(gaps)}. Start verweigert; nur mit --force --reason \"…\".")
        if not a.reason.strip():
            die("--force verlangt --reason \"…\": der Grund gehört in den Verlauf")
        note = f"Start-Gate überfahren ({' · '.join(gaps)}): {a.reason.strip()}"
        update_ticket(a.id, lambda fresh: add_comment(fresh, "hub", note))
    # A roster name selects a named agent: its program, model, repo and branch prefix.
    # Anything else is a program (`omp`, `claude`, …) or a full command line. The ticket
    # keeps the display name in `agent` and the exact start command in `agent_cmd`, so
    # Quests, Board and Team say "omp" instead of printing the command.
    who = roster_of(a.agent)
    if who:
        agent_key, program, agent_argv = who["name"], who["program"], command_argv(who)
    else:
        raw = (a.agent or "").strip() or "omp"
        program = agent_display(raw) or "Agent"
        agent_key = program
        agent_argv = list(AGENTS[raw]) if raw in AGENTS else (shlex.split(raw) or [raw])
    repo, on = t.get("repo"), t.get("machine") or None
    if not repo and who:
        repo = os.path.expanduser(who.get("repo") or "")
        if repo:
            t["repo"] = repo
    if not repo:
        die(f"{a.id} has no repo; hub ticket set {a.id} repo=/path/to/checkout")
    # WIP gate: the agent's own limit, counted in tickets it is already working on.
    if who:
        wip = int(who.get("wip") or 0)
        if wip > 0:
            running = doing_of(who["name"], skip=a.id)
            if len(running) >= wip:
                names_ = ", ".join(f"{x['id']} ({x.get('title') or 'ohne Titel'})" for x in running)
                die(f"{who['name']} hat {len(running)}/{wip} Tickets in Arbeit: {names_}; "
                    f"erst abschließen (hub done ID) oder das Limit erhöhen "
                    f"(hub agent edit {who['name']} --wip N)")
    me = os.environ.get("HC_TERMINAL_ID")
    folder, branch = repo, None
    # The base and its commit at the start: the branch lands here later, and `hub review`
    # checks that the base has not moved on under the branch (drift).
    top_r = run(["git", "rev-parse", "--show-toplevel"], on, repo, check=False)
    top = top_r.stdout.strip() if top_r.returncode == 0 else repo
    base = t.get("base") or ""
    if not base and top_r.returncode == 0:
        base = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], on, top).stdout.strip()
    base_head = t.get("base_head") or ""
    if top_r.returncode == 0:
        r = run(["git", "rev-parse", "--verify", "--quiet", f"{base}^{{commit}}"], on, top, check=False)
        base_head = r.stdout.strip() if r.returncode == 0 else \
            run(["git", "rev-parse", "HEAD"], on, top).stdout.strip()
    if base:
        t["base"] = base
    if base_head:
        t["base_head"] = base_head
    # Preflight: a red base refuses the start; a missing preflight is run now.
    preflight_gate(t)
    if not a.no_worktree:
        common = run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], on, repo).stdout.strip()
        main = common[:-5] if common.endswith("/.git") else common
        labels = t.get("labels", "").lower()
        prefix = (who.get("branch_prefix") or "") if who else ""
        if prefix and not prefix.endswith("/"):
            prefix += "/"
        branch = a.branch or t.get("branch") or (
            f"{prefix}{a.id}"[:60] if prefix else f"{'fix' if 'bug' in labels or 'fix' in labels else 'feat'}/{a.id}"[:60])
        if run(["git", "check-ref-format", "--branch", branch], on, top, check=False).returncode:
            die(f"bad branch name {branch!r}")
        folder = f"{home_of(on)}/.herdr/worktrees/{os.path.basename(main)}/{slug(branch.replace('/', '-'), 60)}"
        exists = run(["git", "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"], on, main, check=False).returncode == 0
        if run(["test", "-d", folder], on, check=False).returncode != 0:
            # New branches start on the recorded base commit, not on whatever HEAD is now.
            start = base_head or "HEAD"
            run(["git", "worktree", "add", folder, branch] if exists else ["git", "worktree", "add", "-b", branch, folder, start], on, top)
    report = f"hc send {me} \"…\"" if me else "deine Abschlussnachricht"
    order = t["body"].strip()
    lessons = "" if a.no_lessons else lesson_section(repo, on)
    if lessons:
        order += f"\n\n{lessons}"
    learned = memory_section(agent_key)
    if learned:
        order += f"\n\n{learned}"
    intro = []
    parts = []
    if who:
        intro.append(f"Du bist {who['name']}" + (f" ({who['role']})" if who.get("role") else "") + ".")
        if who.get("notes"):
            intro.append(f"Notizen: {who['notes']}")
        if who.get("model"):
            intro.append(f"Modell: {who['model']}")
        prompt, _ = read_prompt(who, os.path.expanduser(who.get("repo") or "") or repo)
        parts.append("## Deine Rolle\n\n" + prompt)
        perms = who["permissions"]
        env = [
            "Skills: " + (", ".join(who["skills"]) or "—"),
            "MCP: " + (", ".join(who["mcp"]) or "—"),
            "Grenzen: " + ", ".join(
                ["Push erlaubt" if perms["push"] else "kein Push",
                 "Branches löschen erlaubt" if perms["delete_branches"] else "keine Branches löschen"]),
        ]
        parts.append("## Umgebung\n\n" + "\n".join(env))
    task = (
        ("\n".join(intro) + "\n\n" if intro else "") +
        ("\n\n".join(parts) + "\n\n" if parts else "") +
        f"Ticket {a.id}: {t['title']}\n\n{order}\n\n---\n"
        f"Du arbeitest in {folder}" + (f" auf Branch {branch}" if branch else "") + ". "
        "Lies zuerst den relevanten Code, ändere fokussiert, führe die Checks/Tests des Projekts aus, committe in kleinen Schritten, kein Push. "
        "Starte keine weiteren Agents. Das Ticket ist die einzige Quelle und der einzige Weg: Arbeit bekommst du nur über dieses Ticket, "
        "erledigt wird nur, was darin steht. Fragen, Blocker und Übergaben an andere Agents und den Menschen sind Kommentare in diesem Ticket: "
        f"hub ticket comment {a.id} --from <dein-name> \"…\" (andere Agents mit @name taggen; sie antworten im selben Ticket). "
        "Chat an andere Agents ist verboten. Brauchst du Arbeit von einem anderen, lege ein Ticket an und verlinke dein eigenes mit --blocked-by. "
        f"hc send nur für \"fertig\" oder \"blockiert, Ticket {a.id}\": {report}. "
        "Wenn du fertig oder blockiert bist, melde dich genauso mit: was geändert, Testergebnis, was offen ist."
    )
    agent_cmd = shlex.join(agent_argv)
    if on:
        argv = ["sh", "-lc", '"$@"; exec "${SHELL:-sh}" -l', "sh", *agent_argv, task]
    else:
        sh = shell()
        argv = [sh, "-lic", '"$@"; exec "$0" -li', sh, *agent_argv, task]
    name = slug(a.id, 32) or "agent"
    agent_space, tab = f"sp{secrets.token_hex(16)}", f"tb{secrets.token_hex(16)}"
    labels = ["--label", f"herdr.space={agent_space}", "--label", f"herdr.tab={tab}",
              "--label", f"hub.ticket={a.id}"]
    cmd = ["hc", "run", "--bg", "--json", "--keep", "--outlive-parent", "--name", name, "--cwd", folder, *labels]
    if on:
        cmd += ["--on", on]
    r = subprocess.run(cmd + ["--", *argv], capture_output=True, text=True)
    if r.returncode != 0 and "name" in (r.stderr or "").lower():
        name = f"{name[:26]}-{secrets.token_hex(2)}"
        cmd[cmd.index("--name") + 1] = name
        r = subprocess.run(cmd + ["--", *argv], capture_output=True, text=True)
    if r.returncode != 0:
        die(f"hc run: {(r.stderr or r.stdout).strip()}")
    out = json.loads(r.stdout)

    def saved(fresh):
        fresh.update(agent=agent_key, agent_cmd=agent_cmd,
                     harness=short_harness(who) if who else program,
                     branch=branch or "", worktree=folder if branch else "",
                     terminal=out["address"], agent_space=agent_space, tab=tab)
        if not (fresh.get("owner") or "").strip():
            fresh["owner"] = me or orchestrator_id()
        # The agent works in the ticket's factory; an old ticket joins it now.
        if not (fresh.get("space") or "").strip() or not (fresh.get("space_name") or "").strip():
            sid = ticket_space(fresh) or my_space()["id"]
            fresh["space"] = sid
            fresh["space_name"] = (space_name_of(sid) if sid else "") or my_space()["name"]
        set_status(fresh, "doing")

    with hub_lock():
        t = load(a.id)
        saved(t)
        write(t)
        event("dispatch", a.id, agent_key, out["address"], f"{agent_key} in {branch or folder}")
    print(json.dumps({"ticket": a.id, "terminal": out["address"], "name": name, "agent": agent_key,
                      "agent_cmd": agent_cmd, "folder": folder, "branch": branch}, ensure_ascii=False))


REVIEW_AGENTS = ["claude", "codex", "pi", "omp"]


def review_agent(t, choice):
    """(key, argv) of the reviewer: --agent wins, else a different program than the implementer."""
    if choice:
        return choice, (AGENTS.get(choice) or shlex.split(choice))
    impl = program_of(t.get("agent")).lower()
    for k in REVIEW_AGENTS:
        if k != impl:
            return k, AGENTS[k]
    return "claude", AGENTS["claude"]


def cmd_review_start(a):
    t = load(a.id)
    if t["status"] == "done":
        die(f"{a.id} ist bereits fertig")
    g = gate(t)
    if not g["ok"]:
        die(f"{a.id}: {g['reason']}. Prüfstation erst nach grünem hub verify.")
    station = t.get("review_terminal") or ""
    open_round = bool(station) and not (t.get("review") or "").strip()
    if open_round and not a.restart:
        n = int(t.get("review_rounds") or 0) + 1
        die(f"{a.id}: Prüfstation Runde {n} läuft noch in {station}; "
            f"hc send {station} \"…\" oder hub review-start {a.id} --restart "
            f"(beendet den laufenden Reviewer und startet einen neuen)")
    # A closed round's station may still be up: end it before the next one shares its worktree.
    if station and is_live(station):
        subprocess.run(["hc", "kill", station], capture_output=True, text=True)
    repo, on = t.get("repo"), t.get("machine") or None
    if not repo:
        die(f"{a.id} has no repo; hub ticket set {a.id} repo=/path/to/checkout")
    branch = t.get("branch")
    if not branch:
        die(f"{a.id} hat keinen Branch (kein hub dispatch); die Prüfstation braucht den Branch des Umsetzers")
    top = run(["git", "rev-parse", "--show-toplevel"], on, repo).stdout.strip()
    common = run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], on, top).stdout.strip()
    main = common[:-5] if common.endswith("/.git") else common
    base = t.get("base") or ""
    if not base or base == branch:
        base = ""
        for cand in ("main", "master", "origin/main", "origin/master"):
            if cand != branch and run(["git", "rev-parse", "--verify", "--quiet", cand], on, top,
                                      check=False).returncode == 0:
                base = cand
                break
    if not base:
        die(f"{a.id}: Basis unbekannt (Feld base): hub ticket set {a.id} base=main")
    folder = f"{home_of(on)}/.herdr/worktrees/{os.path.basename(main)}/review-{slug(a.id, 48)}"
    if run(["test", "-d", folder], on, check=False).returncode != 0:
        run(["git", "worktree", "add", "--detach", folder, branch], on, top)
    else:
        # The branch may have moved since the last round; the station always judges its tip.
        run(["git", "checkout", "-f", "--detach", branch], on, folder)
    key, agent = review_agent(t, a.agent)
    task = (
        f"Prüfstation Ticket {a.id}: {t['title']}\n\n"
        "Du bist der unabhängige Reviewer: ein zweites Modell prüft die Arbeit des Umsetzers. "
        "Du änderst keinen Code, committest und pushst nicht und startest keine weiteren Agents.\n\n"
        f"Du arbeitest in {folder} (Branch {branch}, Basis {base}). Quelle ist allein das Ticket und der Diff:\n"
        f"  hub ticket show {a.id}  (Spec, Abnahmekriterien, Verlauf)\n"
        f"  git -C {folder} log --oneline {base}..HEAD\n"
        f"  git -C {folder} diff --stat {base}...HEAD\n"
        f"  git -C {folder} diff {base}...HEAD\n\n"
        "Prüfe jedes Abnahmekriterium und jedes berührte Verhalten. Suche echte Fehler (Regression, "
        "fehlender Fall, falsche Semantik), keine Stilfragen. Jeder Befund ist ein Kommentar im Ticket, "
        "Schweregrad voran (blocker|major|minor|nit), mit Datei:Zeile und Beleg:\n"
        f"  hub ticket comment {a.id} --from review \"major: mods/x.js:42 — was falsch ist und warum\"\n"
        "Am Ende genau ein Urteil:\n"
        f"  hub review-verdict {a.id} --verdict pass|fail --summary \"1–2 Sätze: Urteil, Zahl der blocker/major/minor/nit\"\n"
        "pass nur ohne blocker und major. Kein Chat, keine Rückfrage im Terminal; alles ins Ticket."
    )
    name = slug(f"review-{a.id}", 32) or "review"
    labels = ["--label", f"herdr.space=sp{secrets.token_hex(16)}", "--label", f"herdr.tab=tb{secrets.token_hex(16)}",
              "--label", f"hub.ticket={a.id}", "--label", "hub.role=review"]
    cmd = ["hc", "run", "--bg", "--json", "--keep", "--outlive-parent", "--name", name, "--cwd", folder, *labels]
    if on:
        cmd += ["--on", on]
    r = subprocess.run(cmd + ["--", *agent, task], capture_output=True, text=True)
    if r.returncode != 0 and "name" in (r.stderr or "").lower():
        name = f"{name[:26]}-{secrets.token_hex(2)}"
        cmd[cmd.index("--name") + 1] = name
        r = subprocess.run(cmd + ["--", *agent, task], capture_output=True, text=True)
    if r.returncode != 0:
        die(f"hc run: {(r.stderr or r.stdout).strip()}")
    out = json.loads(r.stdout)

    def saved(fresh):
        fresh.update(reviewer=key, reviewer_name=agent_name(key), review_terminal=out["address"])
        if not (fresh.get("space") or "").strip() or not (fresh.get("space_name") or "").strip():
            sid = ticket_space(fresh) or my_space()["id"]
            fresh["space"] = sid
            fresh["space_name"] = (space_name_of(sid) if sid else "") or my_space()["name"]

    t = update_ticket(a.id, saved)
    event("review", a.id, key, out["address"], "Prüfstation gestartet")
    print(json.dumps({"ticket": a.id, "terminal": out["address"], "name": name, "folder": folder,
                      "branch": branch, "base": base, "agent": key, "reviewer_name": t["reviewer_name"]},
                     ensure_ascii=False))


def cmd_review_verdict(a):
    t = load(a.id)
    if t["status"] == "done":
        die(f"{a.id} ist bereits fertig")
    if not t.get("review_terminal"):
        die(f"{a.id}: keine Prüfstation: erst hub review-start {a.id}")
    head, err = head_of(t, t.get("machine") or None)
    if err:
        die(f"{a.id}: {err}")
    summary = " ".join(a.summary.split())
    if not summary:
        die("leere Zusammenfassung")
    # The reviewer often starts with "Urteil: pass"; the comment already names the verdict.
    summary = re.sub(r"(?i)^urteil:\s*", "", summary)
    at = time.strftime("%Y-%m-%d %H:%M")

    def saved(fresh):
        n = int(fresh.get("review_rounds") or 0) + 1
        fresh.update(review=a.verdict, review_head=head, review_at=at, review_summary=summary,
                     review_rounds=str(n))
        set_review(fresh, f"- {at} · {a.verdict} · Runde {n} · HEAD {head[:7]} · "
                          f"{fresh.get('reviewer_name') or fresh.get('reviewer') or 'review'}\n\n{summary}")
        add_comment(fresh, "review", f"Urteil: {a.verdict} (Runde {n}) · {summary}")
        if a.verdict == "fail":
            set_status(fresh, "doing")

    t = update_ticket(a.id, saved)
    n = int(t.get("review_rounds") or 0)
    event("verdict", a.id, t.get("reviewer") or "", t.get("review_terminal") or "",
          f"{a.verdict} · Runde {n}")
    notified = False
    if a.verdict == "fail" and t.get("terminal") and is_live(t["terminal"]):
        notified = send_agent(t["terminal"], f"{a.id}: Review rot — {summary}. Befunde im Verlauf; "
                                            f"beheben, dann hub verify und hub review-start.")
    if a.verdict == "fail":
        print(f"{a.id}: Review fail · Runde {n} · Ticket zurück auf doing"
              + (" · Umsetzer benachrichtigt" if notified else " · Umsetzer nicht erreichbar (kein laufendes Terminal)"))
    else:
        print(f"{a.id}: Review pass · Runde {n} · HEAD {head[:7]} (hub review kann jetzt übergeben)")


def cmd_rebase(a):
    """Rebase the ticket's branch in its worktree onto its base. A conflict leaves the
    worktree mid-rebase (never aborted): the agent resolves it and continues."""
    t = load(a.id)
    on = t.get("machine") or None
    folder, branch = t.get("worktree"), t.get("branch")
    if not (folder and branch):
        die(f"{a.id} hat keinen Worktree (kein hub dispatch); hub rebase braucht den Branch des Umsetzers")
    if run(["test", "-d", folder], on, check=False).returncode != 0:
        die(f"{a.id}: Worktree {folder} fehlt")
    base = t.get("base") or ""
    if not base:
        die(f"{a.id}: Basis unbekannt (Feld base): hub ticket set {a.id} base=main")
    if run(["git", "status", "--porcelain"], on, folder).stdout.strip():
        die(f"{a.id}: {folder} hat uncommittete Änderungen; der Agent muss sie erst committen, "
            f"dann hub rebase {a.id}")
    r = run(["git", "rev-parse", "--verify", "--quiet", f"{base}^{{commit}}"], on, folder, check=False)
    if r.returncode != 0:
        die(f"{a.id}: Basis {base} nicht gefunden in {folder}: git fetch, dann hub rebase {a.id}")
    tip = r.stdout.strip()
    if run(["git", "merge-base", "--is-ancestor", tip, "HEAD"], on, folder, check=False).returncode == 0:
        print(f"{a.id}: Basis aktuell ({base} {tip[:7]})")
        return
    r = run(["git", "rebase", base], on, folder, check=False)
    if r.returncode != 0:
        files = run(["git", "diff", "--name-only", "--diff-filter=U"], on, folder, check=False).stdout.split()
        where = ", ".join(files) if files else "(git status im Worktree)"
        die(f"{a.id}: Rebase auf {base} gestoppt — Konflikt in {where}. "
            f"Der Worktree {folder} bleibt im Rebase: Konflikte auflösen, git add, git rebase --continue "
            f"(oder --abort); danach hub verify {a.id} und hub review {a.id}.")
    update_ticket(a.id, lambda fresh: fresh.update(base_head=tip))
    print(f"{a.id}: rebased auf {base} ({tip[:7]})")


def save_check(tid, fields, block):
    """Write one check result onto the ticket as it is now, not on a stale copy.

    `hub verify` runs a whole suite between its read and its write; carrying only the
    check fields onto the fresh file keeps a parallel comment or spec change."""
    def saved(fresh):
        fresh.update(fields)
        set_prufung(fresh, block)
    return update_ticket(tid, saved)


def cmd_verify(a):
    t = load(a.id)
    on = t.get("machine") or None
    folder = target_of(t, on)
    if not folder:
        die(f"{a.id}: weder Worktree noch Repo vorhanden; hub ticket set {a.id} repo=/pfad")
    top = run(["git", "rev-parse", "--show-toplevel"], on, folder, check=False)
    if top.returncode != 0:
        # The person reads one German line; the raw git text belongs in the check log.
        detail = (top.stderr or top.stdout).strip()
        at = time.strftime("%Y-%m-%d %H:%M")
        fence = "`" * (max([len(m) for m in re.findall(r"`+", detail)] + [2]) + 1)
        saved = save_check(a.id, {"checks": "fail", "checks_head": "", "checks_at": at,
                                  "checks_duration": "0.0", "checks_exit": str(top.returncode),
                                  "checks_cmd": "git rev-parse --show-toplevel"},
                           f"- {at} · fail · 0.0 s · exit {top.returncode} · HEAD ? · "
                           f"git rev-parse --show-toplevel\n\n{fence}text\n{detail}\n{fence}")
        event("verify", a.id, saved.get("agent") or "", saved.get("terminal") or "",
              f"fail · kein Git-Repository in {folder}")
        die(f"{a.id}: kein Git-Repository in {folder}; hub verify braucht ein Repo "
            f"(hub ticket set {a.id} repo=/pfad)")
    root = top.stdout.strip()
    script = f"{root}/.herdr/verify.sh"
    fallback = (a.or_command or t.get("verify") or "").strip()
    if run(["test", "-f", script], on, check=False).returncode == 0:
        argv, label = ["sh", script], ".herdr/verify.sh"
    elif fallback:
        argv, label = ["sh", "-c", fallback], " ".join(fallback.split())
    else:
        die(f"{a.id}: kein Prüfbefehl: {script} fehlt. Der Agent legt es beim ersten Ticket an und committet es; "
            f"ersatzweise hub ticket set {a.id} verify=\"<befehl>\".")
    started = time.monotonic()
    r = run(argv, on, root, check=False)
    duration = time.monotonic() - started
    output = "\n".join(part.rstrip("\n") for part in (r.stdout or "", r.stderr or "") if part)
    tail = output.splitlines()[-20:]
    head, _ = head_of(t, on)
    ok = r.returncode == 0
    at = time.strftime("%Y-%m-%d %H:%M")
    fields = {"checks": "pass" if ok else "fail", "checks_head": head or "",
              "checks_at": at, "checks_duration": f"{duration:.1f}",
              "checks_exit": str(r.returncode), "checks_cmd": label}
    fence = "`" * (max([len(m) for line in tail for m in re.findall(r"`+", line)] + [2]) + 1)
    saved = save_check(a.id, fields,
                       f"- {at} · {'pass' if ok else 'fail'} · {duration:.1f} s · exit {r.returncode} · "
                       f"HEAD {(head or '?')[:7]} · {label}\n\n{fence}text\n{chr(10).join(tail)}\n{fence}")
    event("verify", a.id, saved.get("agent") or "", saved.get("terminal") or "",
          f"{'pass' if ok else 'fail'} · {duration:.1f} s · {label}")
    print(f"{a.id}: Checks {'pass' if ok else 'fail'} · {duration:.1f} s · exit {r.returncode} · "
          f"HEAD {(head or '?')[:7]} ({len(tail)} Zeilen Ausgabe unter ## Prüfung)")


def cmd_gate(a):
    g = gate(load(a.id))
    if a.json:
        print(json.dumps(g, ensure_ascii=False))
        return
    r = g["review"]
    b = g["base"]
    print(f"{a.id}: {'frei' if g['ok'] else 'gesperrt'} · "
          f"{g['reason'] or ('aufgezeichnete Prüfung (Ticket ist fertig)' if g.get('landed') else 'Checks grün auf dem HEAD des Worktrees')}")
    if r.get("landed"):
        print(f"{a.id}: Review {'grün' if r['ok'] else 'offen'} · aufgezeichnetes Urteil (Ticket ist fertig)")
    else:
        print(f"{a.id}: Review {'grün' if r['ok'] else 'offen'} · {r['reason'] or 'Urteil pass auf dem HEAD des Worktrees'}")
    if b.get("ok") is not None:
        what = b["reason"] or f"setzt auf {b['base']} auf"
        print(f"{a.id}: Basis {'aktuell' if b['ok'] else 'veraltet'} · {what}")


def cmd_gates(a):
    """Every open ticket's gate, for the Team panel (without the output tail)."""
    rows = []
    for t in my_tickets(everyone=getattr(a, "all", False), space=space_arg(a)):
        if t["status"] == "done":
            continue
        g = gate(t)
        g.pop("tail", None)
        rows.append(g)
    print(json.dumps(rows, ensure_ascii=False))


def review_points(t, g):
    """[(label, command)] for the one thing each missing point needs, in DoD order.

    The gate's own reasons repeat what the DoD already says; this list is the single
    source for the compact refusal and for the --force note."""
    tid = t["id"]
    commands = {
        "kriterien": f"hub spec {tid}",
        "verify": f"hub verify {tid}",
        "pruefung": f"hub review-start {tid}",
        "ci": f"hub ci {tid}",
        "nachweise": f"hub review {tid} --evidence PATH",
        "abschluss": f"hub ticket comment {tid} --from <Agent> \"fertig\"",
    }
    labels = {"kriterien": "Abnahmekriterien", "verify": "Checks", "pruefung": "Prüfstation",
              "ci": "CI", "nachweise": "Nachweise", "abschluss": "Abnahme im Verlauf"}
    points = []
    if (g.get("base") or {}).get("ok") is False:
        points.append(("Basis", f"hub rebase {tid}"))
    for x in g.get("dod") or []:
        if x["ok"]:
            continue
        points.append((labels.get(x["key"], x["label"]), commands.get(x["key"], x["why"])))
    return points


def refuse_review(t, points):
    """The short refusal: one summary line, then exactly one command line per gap."""
    sys.stderr.write(f"hub: {t['id']}: Verweigert: {', '.join(label for label, _cmd in points)}\n")
    for label, cmd in points:
        sys.stderr.write(f"  {label}: {cmd}\n")
    sys.exit(1)


def cmd_review(a):
    t = load(a.id)
    # --evidence replaces the list before the gate reads it: the files handed over here are
    # the ticket's proof, so the Definition of Done must judge them, not the old list.
    if a.evidence:
        t["evidence"] = ", ".join(e.strip() for e in a.evidence if e.strip())
    g = gate(t)
    points = review_points(t, g)
    if a.force:
        if not a.reason.strip():
            die("--force verlangt --reason \"…\": der Grund gehört in den Verlauf")
        gaps = [f"{label}: {cmd}" for label, cmd in points]
        add_comment(t, "hub", f"Gate überfahren ({' · '.join(gaps) or 'frei'}): {a.reason.strip()}")
    elif points:
        refuse_review(t, points)
    body, verlauf = split_verlauf(t["body"])
    # Only the old summary goes; the check and review records keep their place right after it.
    m = re.search(r"(?ms)^## Prüfung[ \t]*\n.*?(?=\n## |\Z)", body)
    pru = m.group(0).rstrip("\n") if m else ""
    if m:
        body = (body[:m.start()] + body[m.end():]).strip("\n")
    m = re.search(r"(?ms)^## Review[ \t]*\n.*?(?=\n## |\Z)", body)
    rev = m.group(0).rstrip("\n") if m else ""
    if m:
        body = (body[:m.start()] + body[m.end():]).strip("\n")
    body = re.sub(r"(?ms)^## Zusammenfassung \(Orchestrator\)\n.*?(?=\n## |\Z)", "", body).strip("\n")
    t["body"] = (f"{body}\n\n" if body else "") + f"## Zusammenfassung (Orchestrator)\n{a.summary.strip()}\n"
    if pru:
        t["body"] += f"\n{pru}\n"
    if rev:
        t["body"] += f"\n{rev}\n"
    if verlauf:
        t["body"] += f"\n{verlauf}\n"

    def saved(fresh):
        fresh["body"] = t["body"]
        if a.evidence:
            fresh["evidence"] = t["evidence"]
        set_status(fresh, "review")

    t = update_ticket(a.id, saved)
    event("review", a.id, t.get("agent") or "", t.get("terminal") or "", "Übergabe an den Menschen")
    print(f"{a.id}: review")


def cmd_done(a):
    t = load(a.id)
    res = cleanup_ticket(t, keep_worktree=a.keep_worktree, keep_space=a.keep_space)

    def saved(fresh):
        # cleanup_ticket cleared what it ended/closed in memory; carry only those changes.
        for k in ("terminal", "agent_space", "tab"):
            if t.get(k) == "" and fresh.get(k):
                fresh[k] = ""
        set_status(fresh, "done")

    update_ticket(a.id, saved)
    event("done", a.id, t.get("agent") or "", t.get("terminal") or "", "abgeschlossen")
    print(f"{a.id}: done")
    for n in res["notes"]:
        print(f"  {n}")
    for n in res["skipped"]:
        sys.stderr.write(f"hub: {n}\n")


# ---- Aufräumen: the agent, a clean own worktree and the ticket's own space/tab go; the branch stays

HOUR_MS = 60 * 60 * 1000


def hc_term(addr):
    """One terminal as `hc get` sees it; {} when it is unknown.

    Cached per process: identity, space and orchestrator lookups ask repeatedly, and a
    hub command must not spawn `hc get` for the same terminal twice."""
    if not addr:
        return {}
    if addr in _term_values:
        return _term_values[addr]
    try:
        r = subprocess.run(["hc", "get", str(addr), "--json"], capture_output=True, text=True)
        info = json.loads(r.stdout) if r.returncode == 0 else {}
    except (OSError, ValueError):
        info = {}
    _term_values[addr] = info
    return info


def app_spaces():
    """The window's spaces, or None when herdr-app cannot answer."""
    try:
        r = subprocess.run(["herdr-app", "ls"], capture_output=True, text=True)
        return json.loads(r.stdout).get("spaces", []) if r.returncode == 0 else None
    except (OSError, ValueError):
        return None


def app_do(command, **args):
    """Run one window command; an error text, or None on success."""
    try:
        r = subprocess.run(["herdr-app", "do", command, json.dumps(args)], capture_output=True, text=True)
        return None if r.returncode == 0 else ((r.stderr or r.stdout).strip() or f"{command} fehlgeschlagen")
    except OSError as e:
        return str(e)


def space_terminals(space):
    return [t.get("terminal") for tab in space.get("tabs") or [] for t in tab.get("terminals") or [] if t.get("terminal")]


def terminal_labels(info):
    return (info.get("labels") or {}) if info else {}


def same_path(a, b, on=None):
    if not a or not b:
        return False
    return a == b if on else os.path.realpath(a) == os.path.realpath(b)


def ui_ids(t):
    """The space/tab the ticket's agent was dispatched into (fields, else terminal labels)."""
    space, tab = t.get("agent_space") or "", t.get("tab") or ""
    if space and tab:
        return space, tab
    labels = terminal_labels(hc_term(t.get("terminal")))
    return space or labels.get("herdr.space", ""), tab or labels.get("herdr.tab", "")


def space_of_ticket(t, spaces):
    """The Herdr space the ticket's agent runs in: `agent_space`, or the one holding its
    `hub.ticket` labels (never the ticket's workspace space)."""
    sid, _tab = ui_ids(t)
    found = next((s for s in spaces if s.get("id") == sid), None) if sid else None
    if found:
        return found
    for s in spaces:
        for addr in space_terminals(s):
            if terminal_labels(hc_term(addr)).get("hub.ticket") == t["id"]:
                return s
    return None


def worktree_state(t, tickets, on=None):
    """(main checkout, None) when the ticket's own worktree may go; else (None, reason)."""
    wt = t.get("worktree")
    if not wt:
        return None, "kein Worktree"
    if run(["test", "-d", wt], on, check=False).returncode != 0:
        return None, f"{wt} ist schon weg"
    for other in tickets:
        if other["id"] != t["id"] and other.get("worktree") and same_path(other["worktree"], wt, on):
            return None, f"{wt} gehört Ticket {other['id']}"
    common = run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], on, wt, check=False)
    if common.returncode != 0:
        return None, f"{wt} ist kein Git-Worktree"
    main = common.stdout.strip()
    if main.endswith("/.git"):
        main = main[:-5]
    listed = run(["git", "worktree", "list", "--porcelain"], on, main, check=False).stdout
    paths = [line[len("worktree "):].strip() for line in listed.splitlines() if line.startswith("worktree ")]
    if not any(same_path(p, wt, on) for p in paths):
        return None, f"{wt} ist kein eingetragener Worktree"
    if run(["git", "status", "--porcelain"], on, wt, check=False).stdout.strip():
        return None, f"{wt} hat uncommittete Änderungen"
    return main, None


def worktrees_root(value=None, on=None):
    """The own world's worktree root: --root, else the home's ~/.herdr/worktrees."""
    if value:
        return os.path.abspath(os.path.expanduser(value))
    return os.path.join(home_of(on), ".herdr", "worktrees")


def repo_key(t, on=None):
    """The directory `hub dispatch` gives a repo's worktrees: basename of its main checkout."""
    repo = t.get("repo") or ""
    if not repo:
        return None
    r = run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], on, repo, check=False)
    if r.returncode == 0 and r.stdout.strip():
        main = r.stdout.strip()
        if main.endswith("/.git"):
            main = main[:-5]
        return os.path.basename(main)
    return os.path.basename(os.path.normpath(repo))


def worktree_path(t, root, on=None):
    """The worktree `hub dispatch` made for this ticket: <root>/<repo>/<branch slug>."""
    key, branch = repo_key(t, on), t.get("branch") or ""
    if not key or not branch:
        return None
    return os.path.join(root, key, slug(branch.replace("/", "-"), 60))


def review_worktree_path(t, root, on=None):
    """The ticket's Prüfstation checkout, named exactly like `hub review-start` does."""
    key = repo_key(t, on)
    return os.path.join(root, key, f"review-{slug(t['id'], 48)}") if key else None


def inside(path, folder):
    path, folder = os.path.realpath(path), os.path.realpath(folder)
    return path == folder or path.startswith(folder + os.sep)


def close_space(t, space):
    """Close the ticket's own space (or just its tab) if no foreign live terminal is in it."""
    sid = space.get("id")
    name = space.get("name") or sid
    terms = {addr: hc_term(addr) for addr in space_terminals(space)}

    def ours(addr):
        return addr == (t.get("terminal") or "") or terminal_labels(terms.get(addr)).get("hub.ticket") == t["id"]

    def live(addr):
        info = terms.get(addr) or {}
        return info.get("state") == "live" or not info

    def clean(tab):
        return all(ours(x.get("terminal")) or not live(x.get("terminal")) for x in tab.get("terminals") or [])

    tabs = space.get("tabs") or []
    our_tabs = [tab for tab in tabs if tab.get("id") == t.get("tab")
                or any(ours(x.get("terminal")) for x in tab.get("terminals") or [])]
    other_live = [a for a in terms if not ours(a) and live(a)]
    if not other_live and all(ours(a) for a in terms):
        err = app_do("space.close", id=sid, confirmed=True)
        if err:
            return False, f"Space {name} bleibt: {err}"
        t["agent_space"] = t["tab"] = ""
        return True, f"Space {name} geschlossen"
    closable = [tab for tab in our_tabs if clean(tab)]
    if not closable:
        why = f"fremdes lebendes Terminal {other_live[0]}" if other_live else "kein eigenes Tab gefunden"
        return False, f"Space {name} bleibt: {why}"
    for tab in closable:
        err = app_do("tab.close", id=tab.get("id"), confirmed=True)
        if err:
            return False, f"Tab {tab.get('id')} bleibt: {err}"
    t["tab"] = ""
    if len(closable) == len(tabs):
        t["agent_space"] = ""
    return True, f"Tab {', '.join(tab.get('id') for tab in closable)} geschlossen; Space {name} bleibt"


def cleanup_ticket(t, tickets=None, keep_worktree=False, keep_space=False):
    """End the agent, remove the ticket's clean worktree and close its own space/tab.

    Uncommitted changes abort everything: nothing is ended or removed, and the caller says why.
    A worktree another ticket claims is never touched. The branch always stays.
    """
    on = t.get("machine") or None
    tickets = all_tickets() if tickets is None else tickets
    notes, skipped = [], []
    wt = t.get("worktree") or ""
    ended = False
    foreign = None
    if wt and not keep_worktree and run(["test", "-d", wt], on, check=False).returncode == 0:
        foreign = next((o["id"] for o in tickets if o["id"] != t["id"] and o.get("worktree")
                        and same_path(o["worktree"], wt, on)), None)
        if foreign:
            skipped.append(f"Worktree {wt} gehört Ticket {foreign}; nicht angefasst")
        else:
            dirty = run(["git", "status", "--porcelain"], on, wt, check=False)
            if dirty.returncode == 0 and dirty.stdout.strip():
                return {"notes": [], "skipped": [f"nichts aufgeräumt: {wt} hat uncommittete Änderungen"],
                        "aborted": True, "worktree_removed": False}
    term = t.get("terminal") or ""
    if term and keep_space:
        notes.append(f"Agent {term} bleibt (--keep-space)")
    elif term:
        if hc_term(term).get("state") == "live":
            r = subprocess.run(["hc", "kill", term], capture_output=True, text=True)
            if r.returncode == 0:
                notes.append(f"Agent {term} beendet")
                ended = True
            else:
                skipped.append(f"Agent {term} läuft weiter: {(r.stderr or r.stdout).strip()}")
        else:
            ended = True
    removed = False
    if wt and not keep_worktree and not foreign:
        main, why = worktree_state(t, tickets, on)
        if why:
            skipped.append(f"Worktree bleibt: {why}")
        else:
            r = run(["git", "worktree", "remove", wt], on, main, check=False)
            if r.returncode == 0:
                notes.append(f"Worktree {wt} entfernt")
                removed = True
            else:
                skipped.append(f"Worktree {wt} bleibt: {(r.stderr or r.stdout).strip()}")
    if not keep_space:
        spaces = app_spaces()
        if spaces is None:
            skipped.append("Space bleibt: herdr-app antwortet nicht")
        else:
            space = space_of_ticket(t, spaces)
            if not space:
                if t.get("agent_space"):
                    notes.append(f"Space {t['agent_space']} ist schon weg")
                t["agent_space"] = t["tab"] = ""
            else:
                ok, message = close_space(t, space)
                (notes if ok else skipped).append(message)
    if ended and term:
        t["terminal"] = ""
    return {"notes": notes, "skipped": skipped, "aborted": False, "worktree_removed": removed}


def expired_at(info, now_ms):
    """A finished agent older than an hour: exited, or reporting done/idle/error for that long."""
    if info.get("state") == "finished":
        ts = info.get("finished_ms")
    else:
        st = (info.get("status") or {}).get("state")
        ts = info.get("status_ms") if st in ("done", "idle", "error") else None
    try:
        return ts is not None and now_ms - int(ts) >= HOUR_MS
    except (TypeError, ValueError):
        return False


def own_worktrees(tickets, root, on=None):
    """(ticket, path, kind) for this home's tickets only: paths derived from repo + branch.

    The root is never searched; a checkout only exists here if a ticket of this home
    names the repo and branch that produce it. kind is "worktree" or "review".
    """
    out = []
    for t in tickets:
        if t.get("machine"):
            continue  # another machine's home: its paths are not ours to judge here
        path = worktree_path(t, root, on)
        if path:
            out.append((t, path, "worktree"))
        path = review_worktree_path(t, root, on)
        if path:
            out.append((t, path, "review"))
    return out


def cmd_cleanup(a):
    tickets = my_tickets(everyone=getattr(a, "all", False), space=space_arg(a))
    now = int(time.time() * 1000)
    root = worktrees_root(a.root)
    dry = not a.yes
    done_actions, skipped, changed = [], [], {}

    term_rows = []
    infos = {}
    try:
        listed = json.loads(subprocess.run(["hc", "ls", "--all", "--json"], capture_output=True, text=True).stdout)
        term_rows = listed.get("terminals", [])
        for x in term_rows:
            addr = x.get("address")
            if addr:
                info = dict(hc_term(addr) or {})
                info.setdefault("address", addr)
                infos[addr] = info
    except (OSError, ValueError):
        skipped.append("Agents: hc ls nicht lesbar")

    expired = [info for info in infos.values()
               if terminal_labels(info).get("hub.ticket") and expired_at(info, now)]
    expired_addrs = {info["address"] for info in expired}

    def info_of(addr):
        if addr not in infos:
            infos[addr] = dict(hc_term(addr) or {})
            infos[addr].setdefault("address", addr)
        return infos[addr]

    spaces = app_spaces()
    closeable = []
    if spaces is None:
        skipped.append("Spaces: herdr-app antwortet nicht")
    else:
        ticket_spaces = {t.get("agent_space") for t in tickets if t.get("agent_space")}
        for sp in spaces:
            addrs = space_terminals(sp)
            terms = [info_of(addr) for addr in addrs]
            owns = any(terminal_labels(x).get("hub.ticket") for x in terms) or sp.get("id") in ticket_spaces
            if not owns:
                continue
            blocking = [x["address"] for x in terms
                        if x["address"] not in expired_addrs and x.get("state") in (None, "live")]
            if blocking:
                skipped.append(f"Space {sp.get('name') or sp.get('id')}: {blocking[0]} lebt noch")
                continue
            closeable.append(sp)

    for info in expired:
        addr, tid = info["address"], terminal_labels(info).get("hub.ticket", "")
        kill = info.get("state") == "live"
        action = f"Agent {addr} beenden (Ticket {tid})" if kill else f"Terminal {addr} entfernen (Ticket {tid})"
        if dry:
            done_actions.append(action)
            continue
        r = subprocess.run(["hc", "kill" if kill else "rm", addr], capture_output=True, text=True)
        if r.returncode != 0:
            skipped.append(f"{action}: {(r.stderr or r.stdout).strip()}")
            continue
        done_actions.append(action)
        for t in tickets:
            if t.get("terminal") == addr:
                t["terminal"] = ""
                changed[t["id"]] = t

    for sp in closeable:
        action = f"Space {sp.get('name') or sp.get('id')} schließen"
        if dry:
            done_actions.append(action)
            continue
        err = app_do("space.close", id=sp.get("id"), confirmed=True)
        if err:
            skipped.append(f"{action}: {err}")
            continue
        done_actions.append(action)
        for t in tickets:
            if t.get("agent_space") == sp.get("id"):
                t["agent_space"] = t["tab"] = ""
                changed[t["id"]] = t

    live_cwds = [(x.get("address") or "?", x.get("cwd") or "") for x in term_rows
                 if x.get("state") == "live" and x.get("cwd")]
    by_path = {}
    for t, path, kind in own_worktrees(tickets, root):
        by_path.setdefault(os.path.realpath(path), []).append((t, path, kind))
    for group in by_path.values():
        t, path, kind = group[0]
        if not os.path.isdir(path):
            continue
        what = "Prüf-Worktree" if kind == "review" else "Worktree"
        owners = sorted({x[0]["id"] for x in group})
        branch = t.get("branch") or "—"
        where = (f"Prüfstation von {t['id']}, Branch {branch}" if kind == "review"
                 else f"Ticket {t['id']}, Branch {branch}")
        label = f"{what} {path} ({where})"
        if len(owners) > 1:
            skipped.append(f"{what} {path}: von mehreren Tickets genannt ({', '.join(owners)}); bleibt")
            continue
        if t.get("status") != "done":
            skipped.append(f"{label}: Ticket ist {t.get('status', '?')}; bleibt")
            continue
        if kind == "worktree" and t.get("worktree") and not same_path(t["worktree"], path):
            skipped.append(f"{label}: Ticket trägt {t['worktree']}; bleibt")
            continue
        if kind == "worktree":
            actual = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], None, path, check=False).stdout.strip()
            if actual != (t.get("branch") or ""):
                skipped.append(f"{label}: Branch {actual or '?'} gehört nicht diesem Ticket; bleibt")
                continue
        if kind == "review":
            rv = t.get("review_terminal") or ""
            if rv and is_live(rv):
                skipped.append(f"{label}: Reviewer {rv} läuft; bleibt")
                continue
        busy = next(((addr, cwd) for addr, cwd in live_cwds if inside(cwd, path)), None)
        if busy:
            skipped.append(f"{label}: Terminal {busy[0]} mit cwd {busy[1]} lebt; bleibt")
            continue
        main, why = worktree_state({"id": "", "worktree": path}, [], None)
        if why:
            skipped.append(f"{label}: {why}")
            continue
        action = f"{label} entfernen"
        if dry:
            done_actions.append(action)
            continue
        r = run(["git", "worktree", "remove", path], None, main, check=False)
        if r.returncode != 0:
            skipped.append(f"{action}: {(r.stderr or r.stdout).strip()}")
            continue
        done_actions.append(action)

    if not dry:
        with hub_lock():
            for t in changed.values():
                write(t)
    print(f"Aufräumen{' (dry run)' if dry else ''} in {root} "
          f"(nur Tickets dieses Homes; ohne --yes ändert sich nichts):")
    if not done_actions and not skipped:
        print("  Nichts zu tun.")
    for line in done_actions:
        print(f"  {line}")
    for line in skipped:
        print(f"  bleibt: {line}")


# ---- CI: the PR's checks decide whether a delivered ticket is done

def ci_bucket(c):
    """pass | fail | running for one `gh pr checks` row (bucket is newer than state)."""
    b = (c.get("bucket") or "").lower()
    if b:
        return "fail" if b in ("fail", "cancel") else "running" if b == "pending" else "pass"
    s = (c.get("state") or "").lower()
    if s in ("failure", "error", "cancelled", "timed_out", "action_required"):
        return "fail"
    if s in ("pending", "queued", "in_progress", "requested", "waiting"):
        return "running"
    return "pass"


def last_line(text, n=300):
    lines = (text or "").strip().splitlines()
    return lines[-1][:n] if lines else ""


def gh(args, cwd=None):
    """gh without check=True (pr checks exits 1 on red checks); no gh is data, not a crash."""
    try:
        return subprocess.run(["gh", *args], capture_output=True, text=True, cwd=cwd)
    except FileNotFoundError:
        return None


def ci_log(failed, cwd):
    """The tail of `gh run view --log-failed` for the first failed check that links a run."""
    for c in failed:
        m = re.search(r"https?://[^/]+/([^/]+/[^/]+)/actions/runs/(\d+)", c.get("link") or "")
        if not m:
            continue
        r = gh(["run", "view", m.group(2), "--repo", m.group(1), "--log-failed"], cwd)
        if r and r.returncode == 0 and r.stdout.strip():
            return "\n".join(r.stdout.strip().splitlines()[-12:])
        if r and r.stderr.strip():
            return f"(Log nicht abrufbar: {last_line(r.stderr)})"
    return ""


def ci_collect(t):
    """Ask gh for the ticket's PR checks. Never raises; an unreachable CI is `unknown`."""
    cwd = t.get("worktree") if t.get("worktree") and os.path.isdir(t["worktree"]) else t.get("repo")
    if cwd and not os.path.isdir(cwd):
        cwd = None  # a remote machine's checkout: gh works on the PR URL
    sel = t.get("pr") or t.get("branch")
    url = t.get("pr") or ""
    out = {"state": "unknown", "checks": [], "log": "", "url": url, "open": 0, "total": 0}
    if not sel:
        return {**out, "error": "kein PR und kein Branch am Ticket"}
    view = gh(["pr", "view", sel, "--json", "url,state"], cwd)
    if view and view.returncode == 0:
        try:
            url = json.loads(view.stdout).get("url") or url
        except ValueError:
            pass
    r = gh(["pr", "checks", sel, "--json", "name,state,bucket,link"], cwd)
    if r is None:
        return {**out, "error": "gh ist nicht installiert"}
    try:
        checks = json.loads(r.stdout) if r.stdout.strip() else None
    except ValueError:
        checks = None
    if checks is None:
        # `gh pr checks` exits 1 without checks; that is a pass, not an outage.
        if "no checks reported" in (r.stderr or "").lower():
            checks = []
        else:
            return {**out, "url": url, "error": f"gh pr checks: {last_line(r.stderr or r.stdout) or f'exit {r.returncode}'}"}
    failed = [c for c in checks if ci_bucket(c) == "fail"]
    running = [c for c in checks if ci_bucket(c) == "running"]
    state = "fail" if failed else "running" if running else "pass"
    log = ci_log(failed, cwd) if failed else ""
    names = ", ".join(c.get("name") or "?" for c in failed)
    if state == "fail":
        comment = f"CI rot: {names}"
        if log:
            comment += ". Log: " + " | ".join(line.strip() for line in log.splitlines()[-6:] if line.strip())
    elif state == "running":
        comment = f"CI läuft: {len(running)} offen"
    else:
        comment = "CI grün" + (f" ({len(checks)} Checks)" if checks else " (keine Checks)")
    return {"state": state, "checks": failed, "log": log, "url": url, "comment": comment[:1500],
            "open": len(running), "total": len(checks)}


def send_agent(address, text):
    """hc send; a blocked agent waits on a question, so the second try forces it."""
    try:
        r = subprocess.run(["hc", "send", address, text], capture_output=True, text=True)
        if r.returncode != 0:
            r = subprocess.run(["hc", "send", address, text, "--force"], capture_output=True, text=True)
        return r.returncode == 0
    except OSError:
        return False


def apply_ci(t, res, feedback=True):
    """Write the result into the ticket, bound to the worktree's HEAD. Red reopens it and
    goes back to its live agent. A result without a readable HEAD binds to nothing, so it
    can never count as current."""
    state = res["state"]
    head = worktree_head(t, t.get("machine") or None)
    t["ci"] = state
    t["ci_at"] = time.strftime("%Y-%m-%d %H:%M")
    if head:
        t["ci_head"] = head
    else:
        t.pop("ci_head", None)
    if res.get("url"):
        t["ci_url"] = res["url"]
    if state == "fail":
        t["ci_details"] = json.dumps({
            "checks": [{"name": c.get("name") or "?", "state": c.get("state") or "", "link": c.get("link") or ""}
                       for c in res["checks"]],
            "log": res.get("log") or "",
        }, ensure_ascii=False)[:8000]
        text = " ".join((res.get("comment") or "CI rot").split())
        history = entries(t)
        if not (history and history[-1][1] == "ci" and history[-1][2] == text):
            add_comment(t, "ci", text)
        if feedback and t.get("terminal") and is_live(t["terminal"]):
            send_agent(t["terminal"], f"{t['id']}: CI rot, siehe Kommentar")
        set_status(t, "doing")
    else:
        t.pop("ci_details", None)
    return state


def wait_ci(t):
    """Poll until pass/fail/unknown or CI_TIMEOUT; each poll writes `ci`, `ci_at`.

    Every poll is its own short locked write: the minutes between polls must not hold the
    home's write lock. The caller's `t` receives the CI fields so `hub land` sees them."""
    deadline = time.time() + CI_TIMEOUT
    while True:
        res = ci_collect(t)
        holder = {}

        def saved(fresh):
            apply_ci(fresh, res, feedback=False)
            holder["terminal"] = fresh.get("terminal") or ""
            for k in ("ci", "ci_head", "ci_at", "ci_details", "ci_url"):
                if k in fresh:
                    t[k] = fresh[k]
                else:
                    t.pop(k, None)

        update_ticket(t["id"], saved)
        if res["state"] == "fail" and holder["terminal"] and is_live(holder["terminal"]):
            send_agent(holder["terminal"], f"{t['id']}: CI rot, siehe Kommentar")
        if res["state"] in ("pass", "fail", "unknown"):
            return res
        sys.stderr.write(f"hub: CI läuft ({res['open']} offen, {res['state']}) …\n")
        if time.time() >= deadline:
            res["timeout"] = True
            return res
        time.sleep(max(0, min(CI_POLL, deadline - time.time())))


def cmd_ci(a):
    t = load(a.id)
    res = ci_collect(t)
    holder = {}

    def saved(fresh):
        apply_ci(fresh, res, feedback=False)
        holder["terminal"] = fresh.get("terminal") or ""

    t = update_ticket(a.id, saved)
    state = res["state"]
    notified = state == "fail" and bool(holder["terminal"]) and is_live(holder["terminal"])
    if notified:
        send_agent(holder["terminal"], f"{a.id}: CI rot, siehe Kommentar")
    event("ci", a.id, t.get("agent") or "", t.get("terminal") or "", state)
    head = (t.get("ci_head") or "")[:7]
    where = (f" · {t['ci_url']}" if t.get("ci_url") else "") + (
        f" · Commit {head}" if head else " · Commit nicht lesbar (Ergebnis zählt nicht)")
    if state == "unknown":
        print(f"{a.id}: CI unbekannt: {res.get('error') or 'keine Antwort'}")
    elif state == "fail":
        names = ", ".join(c.get("name") or "?" for c in res["checks"]) or "Check"
        print(f"{a.id}: CI rot: {names}{where}")
        print(f"{a.id}: Ticket auf doing, Namen und Log-Auszug im Verlauf"
              + ("; Agent benachrichtigt" if notified else ""))
    elif state == "running":
        print(f"{a.id}: CI läuft: {res['open']} offen{where}")
    else:
        print(f"{a.id}: CI grün ({res['total']} Checks){where}")


def cmd_lesson_add(a):
    target = a.target
    tid = (a.ticket or "").strip()
    if not tid and re.fullmatch(r"[a-z0-9][a-z0-9-]*", target or "") and os.path.exists(path_of(target)):
        tid = target
    on = a.on or None
    if tid:
        t = load(tid)
        on = on or t.get("machine") or None
        if target == tid:
            target = t.get("repo") or ""
        if not target:
            die(f"{tid} hat kein Repo; hub ticket set {tid} repo=/pfad")
    repo = target if on else os.path.abspath(target or "")
    if not repo or (not on and not os.path.isdir(repo)):
        die(f"kein Repo: {target}")
    if not on:
        folder = lesson_dir(repo)
        writable = folder if os.path.isdir(folder) else repo
        if not os.access(writable, os.W_OK):
            die(f"Lehren nicht schreibbar: {repo} (kein Schreibrecht für {writable})")
    l = add_lesson(repo, tid or "-", a.source, " ".join(a.text), on)
    print(lesson_line(l))


def cmd_lesson_list(a):
    repo, tid, on = repo_of(a.target, a.on or None)
    items = read_lessons(repo, on, "lessons-pending.md") if a.pending else read_lessons(repo, on)
    if tid:
        items = [l for l in items if l["ticket"] == tid]
    if a.last:
        items = items[-a.last:]
    if a.json:
        print(json.dumps(items, ensure_ascii=False, indent=1))
        return
    for l in items:
        print(lesson_line(l))
    if not items:
        print(f"{repo}: keine Lehren")


def cmd_lesson_propose(a):
    t = load(a.id)
    repo = t.get("repo")
    if not repo:
        die(f"{a.id} hat kein Repo; hub ticket set {a.id} repo=/pfad")
    on = t.get("machine") or None
    text = one_line(" ".join(a.text))
    if not text:
        die("leere Lehre")
    with lesson_guard(on):
        items = [l for l in read_lessons(repo, on, "lessons-pending.md") if l["ticket"] != a.id]
        l = {"date": time.strftime("%Y-%m-%d"), "ticket": a.id, "source": "vorschlag", "text": text}
        items.append(l)
        write_lessons(repo, items, on, "lessons-pending.md")
    update_ticket(a.id, lambda fresh: add_comment(fresh, "orchestrator", f"Vorschlag für eine Lehre: {text}"))
    print(lesson_line(l))


def cmd_lesson_confirm(a):
    t = load(a.id)
    repo = t.get("repo")
    if not repo:
        die(f"{a.id} hat kein Repo; hub ticket set {a.id} repo=/pfad")
    on = t.get("machine") or None
    with lesson_guard(on):
        pending = [l for l in read_lessons(repo, on, "lessons-pending.md") if l["ticket"] == a.id]
        if not pending:
            die(f"kein Lehren-Vorschlag für {a.id}")
        l = add_lesson(repo, a.id, "review", pending[-1]["text"], on)
        write_lessons(repo, [x for x in read_lessons(repo, on, "lessons-pending.md") if x["ticket"] != a.id], on,
                      "lessons-pending.md")
    update_ticket(a.id, lambda fresh: add_comment(fresh, "mensch", f"Lehre übernommen: {l['text']}"))
    print(lesson_line(l))


def main_checkout(t, on):
    common = run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], on, t.get("worktree") or t["repo"]).stdout.strip()
    return common[:-5] if common.endswith("/.git") else common


def cmd_land(a):
    t = load(a.id)
    if a.wait_ci and not a.pr:
        die("--wait-ci gilt nur mit --pr")
    on, wt, branch = t.get("machine") or None, t.get("worktree"), t.get("branch")
    if a.lesson and not t.get("repo"):
        die(f"{a.id} has no repo; hub ticket set {a.id} repo=/path")
    if not (wt and branch):
        die(f"{a.id} has no worktree branch to land")
    if run(["test", "-d", wt], on, check=False).returncode != 0:
        die(f"worktree {wt} is gone")
    if run(["git", "status", "--porcelain"], on, wt).stdout.strip():
        die(f"{wt} has uncommitted changes; the agent must commit first")
    main = main_checkout(t, on)
    base = t.get("base") or run(["git", "rev-parse", "--abbrev-ref", "HEAD"], on, main).stdout.strip()
    result = {"ticket": a.id, "merged": None, "pr": None, "ci": None}
    if a.merge:
        head = run(["git", "rev-parse", "HEAD"], on, wt).stdout.strip()
        ci = t.get("ci") or ""
        ci_head = t.get("ci_head") or ""
        stale = bool(ci) and ci_head != head
        if ci == "fail" or stale:
            if not ci_head:
                why = f"noch keine CI gelaufen (hub ci {a.id})"
            elif ci == "fail":
                why = f"CI rot ({t.get('ci_at') or 'Zeit unbekannt'})"
            else:
                why = f"CI {ci} gilt für {ci_head[:7]}, HEAD ist {head[:7]}"
            if a.force:
                if not a.reason.strip():
                    die("--force verlangt --reason \"…\": der Grund gehört in den Verlauf")
                note = f"CI-Gate überfahren ({why}): {a.reason.strip()}"
                update_ticket(a.id, lambda fresh: add_comment(fresh, "hub", note))
            else:
                die(f"{a.id}: {why}. Landen verweigert: hub ci {a.id} erneut ausführen "
                    f"oder --force --reason \"…\".")
        here = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], on, main).stdout.strip()
        if here != base:
            die(f"the main checkout {main} is on {here}, not on {base}; switch it to {base} first")
        if run(["git", "status", "--porcelain", "--untracked-files=no"], on, main).stdout.strip():
            die(f"the main checkout {main} has uncommitted changes; commit or stash them first")
        r = run(["git", "merge", "--no-ff", "-m", f"Merge {branch}: {t['title']}", branch], on, main, check=False)
        if r.returncode != 0:
            run(["git", "merge", "--abort"], on, main, check=False)
            die(f"merge conflict between {branch} and {base}; have the agent rebase {branch} onto {base}")
        t["merged"] = f"{base}@{run(['git', 'rev-parse', '--short', 'HEAD'], on, main).stdout.strip()}"
        result["merged"] = t["merged"]
    else:
        if run(["git", "remote", "get-url", "origin"], on, wt, check=False).returncode != 0:
            die("no remote 'origin' to push to")
        run(["git", "push", "-u", "origin", branch], on, wt)
        # A pushed branch starts a new check round: the old red is stale until `hub ci` says otherwise.
        for k in ("ci", "ci_head", "ci_at", "ci_details", "ci_url"):
            t.pop(k, None)
        if not t.get("pr"):
            summary = re.search(r"(?ms)^## Zusammenfassung \(Orchestrator\)\n(.*?)(?=\n## |\Z)", t["body"])
            body = (summary.group(1).strip() if summary else t["body"].strip()) + f"\n\n---\nTicket `{a.id}`, über den Herdr-Orchestrator umgesetzt."
            r = run(["gh", "pr", "create", "--base", base, "--head", branch, "--title", t["title"], "--body", body], on, wt, check=False)
            if r.returncode != 0:
                die(f"gh pr create: {(r.stderr or r.stdout).strip()}")
            t["pr"] = r.stdout.strip().splitlines()[-1]
        result["pr"] = t["pr"]
        if a.wait_ci:
            res = wait_ci(t)
            result.update(ci=t["ci"], ci_at=t.get("ci_at"))
            if res["state"] != "pass":
                # Not green: the agent and its checkout stay, so the failure can be fixed.
                do_fields = {k: t[k] for k in ("ci", "ci_head", "ci_at", "ci_details", "ci_url", "pr", "merged")
                             if k in t}
                do_status = "review" if not t.get("status") else None

                def saved(fresh):
                    for k in ("ci", "ci_head", "ci_at", "ci_details", "ci_url"):
                        fresh.pop(k, None)
                    fresh.update(do_fields)
                    if do_status:
                        set_status(fresh, do_status)

                update_ticket(a.id, saved)
                why = {"fail": f"CI rot: {', '.join(c.get('name') or '?' for c in res['checks'])}",
                       "unknown": f"CI nicht prüfbar: {res.get('error') or 'keine Antwort'}",
                       "running": f"CI nach {CI_TIMEOUT // 60} Minuten noch nicht fertig"}.get(res["state"], res["state"])
                result["message"] = f"{why}; Ticket bleibt offen, Agent und Worktree bleiben"
                print(json.dumps(result, ensure_ascii=False))
                return
    # The work is landed (and green, when waited for): its agent, checkout and space are no longer needed.
    res = cleanup_ticket(t, keep_worktree=a.keep_worktree, keep_space=a.keep_space)
    result["cleanup"] = res["notes"] + res["skipped"]
    if a.merge and not a.keep_worktree and not res.get("aborted"):
        run(["git", "branch", "-d", branch], on, main, check=False)
    landed_fields = {k: t[k] for k in ("merged", "pr", "ci", "ci_head", "ci_at", "ci_details", "ci_url")
                     if k in t}

    def saved(fresh):
        for k in ("terminal", "agent_space", "tab"):
            if t.get(k) == "" and fresh.get(k):
                fresh[k] = ""
        fresh.update(landed_fields)
        set_status(fresh, "done")

    update_ticket(a.id, saved)
    event("land", a.id, t.get("agent") or "", t.get("terminal") or "",
          t.get("merged") or t.get("pr") or "gelandet")
    # The lesson comes last: the work is landed even when writing the file fails (it is
    # reported then, but the ticket stays accepted and its Verlauf is not half-written).
    learned = [add_lesson(t.get("repo") if on else os.path.abspath(t["repo"]), a.id, "human", text, on) for text in (a.lesson or [])]
    if learned:
        def noted(fresh):
            for l in learned:
                add_comment(fresh, "mensch", f"Lehre notiert: {l['text']}")
        update_ticket(a.id, noted)
    result.update(merged=t.get("merged"), pr=t.get("pr"), ci=t.get("ci"), ci_at=t.get("ci_at"),
                  lessons=[l["text"] for l in learned])
    print(json.dumps(result, ensure_ascii=False))


def costs():
    try:
        return json.load(open(COSTS, encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def orchestrator_cost(cost_rows, sid):
    """One orchestrator's own share, never the home's total (cf. costs.js orchestratorCost).

    `orchestrators[space]` when the watcher split the rows; a home without a split keeps
    the legacy single `orchestrator` number. A space the split does not name costs 0."""
    cost_rows = cost_rows or {}
    per = cost_rows.get("orchestrators") or {}
    if not per or not sid:
        return cost_rows.get("orchestrator")
    return per.get(sid) or 0


def report_invalid(ids):
    """One stderr line for all files `hub status` had to skip; the rest still prints."""
    if ids:
        print(f"übersprungen: {len(ids)} ungültige Datei(en): {', '.join(ids)}", file=sys.stderr)


def cmd_status(a):
    live = {}
    for addr, x in terminals_all().items():
        live[addr] = x.get("status") or x.get("state")
    me = orchestrator_id()
    mine = my_space()
    selected = space_arg(a)
    c = costs()
    per = c.get("tickets", {})
    rows_all = all_tickets()
    tickets = my_tickets(rows=rows_all, everyone=getattr(a, "all", False), me=me, space=selected)
    unassigned = [t for t in rows_all if ticket_space(t) == ""]
    bad = invalid_tickets()
    open = [t for t in tickets if t["status"] != "done"]
    if getattr(a, "json", False):
        rows = []
        for t in tickets:
            term = t.get("terminal", "")
            sid = ticket_space(t)
            rows.append({"id": t["id"], "title": t["title"], "status": t["status"],
                         "space": sid, "space_name": ticket_space_name(t),
                         "owner": t.get("owner") or "", "agent": t.get("agent") or t.get("assignee") or "",
                         "terminal": term, "live": live.get(term, "") if term else "",
                         "review": t.get("review") or "", "review_rounds": t.get("review_rounds") or "",
                         "ci": t.get("ci") or "", "done": t["status"] == "done",
                         "cost": round(float(per.get(t["id"]) or 0), 2),
                         "age": age(t.get("status_at") or t.get("updated") or ""),
                         "comments": len(entries(t))})
        rows.extend({"id": tid, "invalid": True} for tid in bad)
        print(json.dumps({"space": selected or mine["id"], "space_name": space_name_of(selected or mine["id"]),
                          "tickets": rows, "invalid": bad,
                          "unassigned": len(unassigned),
                          "unassigned_hint": f"hub spaces --adopt --to <space> ({len(unassigned)} Tickets)" if unassigned else ""},
                         ensure_ascii=False))
        report_invalid(bad)
        return
    if open:
        print(f"{'Ticket':<40} {'Status':<7} {'Besitzer':<12} {'Basis':<17} {'Urteil':<7} {'Runden':>6} {'CI':<5} {'Terminal':<16} {'Live':<9} {'Alter':>6} {'Kosten':>7} {'Verlauf':>7}  Titel")
    for t in open:
        term = t.get("terminal", "")
        owner = (t.get("owner") or "").strip()
        # Only a foreign owner is worth a column: this orchestrator's own work and
        # ownerless old tickets read `–`; `mensch` stays visible as the person.
        who = "–" if owner in ("", me) else owner
        ci = f"CI {CI_MARK.get(t.get('ci'), '–')}"
        cost = f"${per[t['id']]:.2f}" if t["id"] in per else "-"
        # Age since the last status change (tickets from before the log fall back to `updated`).
        age_t = age(t.get("status_at") or t.get("updated") or "")
        bg = base_gate(t)
        basis = "⚠ Basis veraltet" if bg["ok"] is False else "ok" if bg["ok"] else "–"
        print(f"{t['id']:<40} {t['status']:<7} {who:<12} {basis:<17} {(t.get('review') or '–'):<7} {(t.get('review_rounds') or '–'):>6} "
              f"{ci:<5} {term:<16} {live.get(term, '-' if not term else 'beendet'):<9} {age_t:>6} {cost:>7} "
              f"{len(entries(t)):>7}  {t['title']}")
    rests, spaces = [], None
    for t in (x for x in tickets if x["status"] == "done"):
        left = []
        term = t.get("terminal", "")
        if term and term in live:
            left.append(f"Terminal {term}")
        wt = t.get("worktree", "")
        if wt and not t.get("machine") and os.path.isdir(wt):
            left.append(f"Worktree {wt}")
        if t.get("agent_space"):
            if spaces is None:
                spaces = app_spaces() or []
            if any(s.get("id") == t["agent_space"] for s in spaces):
                left.append("Space")
        if left:
            rests.append((t, left))
    if rests:
        print("\nReste (hub cleanup):")
        for t, left in rests:
            print(f"  {t['id']}: {', '.join(left)}")
    if c:
        print(f"\nBudget pro Ticket ${c.get('ticketBudget', 0):.0f}, Team ${c.get('teamBudget', 0):.0f}; offen bisher ${c.get('teamCost', 0):.2f}")
    if unassigned and selected != "":
        print(f"\n{len(unassigned)} Tickets ohne Workspace (hub spaces --adopt --to <space>)")
    report_invalid(bad)


# ---- Messwerte: throughput, rework and cost, per ticket, station and repo

STATIONS = [("todo", "Geplant"), ("doing", "In Arbeit"), ("review", "Prüfung")]


def median(values):
    vals = sorted(v for v in values if v is not None)
    if not vals:
        return None
    mid = len(vals) // 2
    return vals[mid] if len(vals) % 2 else (vals[mid - 1] + vals[mid]) / 2


def dur(minutes):
    if minutes is None:
        return "—"
    m = int(round(minutes))
    return f"{m} min" if m < 60 else f"{m // 60} h {m % 60:02d}"


def measure(t, now, spent):
    """One ticket: minutes per station, lead time (todo→done), review rounds, rework, cost."""
    ev = timeline(t)
    stages = {}
    for (ts, state), (nts, _nxt) in zip(ev, ev[1:]):
        stages.setdefault(state, []).append(max(0.0, (nts - ts) / 60))
    if ev and ev[-1][1] != "done":
        stages.setdefault(ev[-1][1], []).append(max(0.0, (now - ev[-1][0]) / 60))
    done_ts = next((ts for ts, state in reversed(ev) if state == "done"), None)
    # Rework: back in work after it had been in review (a fail sends it there too).
    rework = [ts for i, (ts, state) in enumerate(ev) if i and state == "doing" and ev[i - 1][1] == "review"]
    # Rounds: entries into review from the log, plus the Prüfstation's own counter.
    try:
        recorded = int(t.get("review_rounds") or 0)
    except (TypeError, ValueError):
        recorded = 0
    rounds = max(sum(1 for _ts, state in ev if state == "review"), recorded)
    return {"id": t["id"], "title": t.get("title") or "", "repo": t.get("repo") or "",
            "status": t.get("status") or "todo",
            "created": int(ev[0][0]) if ev else None, "done_at": int(done_ts) if done_ts else None,
            "lead_min": round((done_ts - ev[0][0]) / 60, 1) if done_ts and ev else None,
            "stages": {k: [round(x, 1) for x in v] for k, v in stages.items()},
            "rounds": rounds,
            "rework": len(rework), "rework_at": [int(x) for x in rework],
            "cost": round(float(spent or 0), 2)}


def aggregate(rows):
    """The same numbers for a set of tickets: done, median lead, rounds, rework, cost, per station."""
    done = [r for r in rows if r["status"] == "done"]
    leads = [r["lead_min"] for r in done if r["lead_min"] is not None]
    stations = []
    for key, label in STATIONS:
        vals = [x for r in rows for x in r["stages"].get(key, [])]
        stations.append({"key": key, "label": label, "count": len(vals), "sum_min": round(sum(vals), 1),
                         "median_min": round(median(vals), 1) if vals else None})
    return {"tickets": len(rows), "done": len(done),
            "median_min": round(median(leads), 1) if leads else None,
            "rounds": sum(r["rounds"] for r in rows), "rework": sum(r["rework"] for r in rows),
            "cost": round(sum(r["cost"] for r in rows), 2), "stations": stations}


def agent_rows(tickets, per_ticket):
    """Einsätze and cost per named agent, roster entries first, then every other agent key."""
    roster = read_roster()
    seen, rows = {}, []
    for r in roster:
        row = {"name": r["name"], "role": r["role"], "program": r["program"], "model": r["model"],
               "tickets": 0, "open": 0, "cost": 0.0}
        seen[r["name"].casefold()] = row
        rows.append(row)
    for tk in tickets:
        key = agent_display(tk.get("agent"))
        if not key:
            continue
        row = seen.get(key.casefold())
        if not row:
            row = {"name": AGENT_NAMES.get(key, key), "role": "", "program": key if key in AGENTS else "",
                   "model": "", "tickets": 0, "open": 0, "cost": 0.0}
            seen[key.casefold()] = row
            rows.append(row)
        row["tickets"] += 1
        if tk.get("status") != "done":
            row["open"] += 1
        row["cost"] += float(per_ticket.get(tk["id"]) or 0)
    for row in rows:
        row["cost"] = round(row["cost"], 2)
    extra = sorted(rows[len(roster):], key=lambda r: (-r["cost"], -r["tickets"], r["name"].casefold()))
    return rows[:len(roster)] + extra


def day_of(ts):
    return datetime.datetime.fromtimestamp(ts).strftime("%Y-%m-%d")


def cmd_stats(a):
    days = max(1, a.days)
    now = time.time()
    per_ticket = costs().get("tickets", {})
    mine = my_space()
    selected = space_arg(a)
    tickets = my_tickets(everyone=getattr(a, "all", False), space=selected)
    rows = [measure(t, now, per_ticket.get(t["id"])) for t in tickets]
    for row, t in zip(rows, tickets):
        row["space"], row["space_name"] = ticket_space(t), ticket_space_name(t)
    events = {t["id"]: timeline(t) for t in tickets}
    # The days a ticket moved: its transitions plus the day it was created or done.
    touched = {r["id"]: {day_of(ts) for ts, _state in events[r["id"]]}
                      | ({day_of(r["done_at"])} if r["done_at"] else set()) for r in rows}
    today = datetime.date.today()
    today_s = today.isoformat()
    start = epoch((today - datetime.timedelta(days=days - 1)).isoformat() + " 00:00") or 0
    # Active in the window by its last recorded move; a ticket without a log by its last write.
    last_seen = {r["id"]: (events[r["id"]][-1][0] if events[r["id"]] else epoch((t or {}).get("updated")) or 0)
                 for r, t in zip(rows, tickets)}
    active = [r for r in rows if last_seen[r["id"]] >= start]
    agg = aggregate(active)
    done_today = [r for r in rows if r["done_at"] and day_of(r["done_at"]) == today_s]
    today_row = {"date": today_s, "done": len(done_today),
                 "median_min": round(median([r["lead_min"] for r in done_today]), 1) if done_today else None,
                 "rework": sum(1 for r in rows for ts in r["rework_at"] if day_of(ts) == today_s),
                 "cost": round(sum(r["cost"] for r in rows if today_s in touched[r["id"]]), 2)}
    history = []
    for i in range(6, -1, -1):
        d = (today - datetime.timedelta(days=i)).isoformat()
        done_d = [r for r in rows if r["done_at"] and day_of(r["done_at"]) == d]
        history.append({"date": d, "done": len(done_d),
                        "median_min": round(median([r["lead_min"] for r in done_d]), 1) if done_d else None,
                        "rework": sum(1 for r in rows for ts in r["rework_at"] if day_of(ts) == d),
                        "cost": round(sum(r["cost"] for r in rows if d in touched[r["id"]]), 2)})
    repos = []
    for repo in sorted({r["repo"] or "ohne Repo" for r in active}):
        repos.append({"repo": repo, **aggregate([r for r in active if (r["repo"] or "ohne Repo") == repo])})
    out = {"days": days, "at": int(now * 1000), "space": selected or mine["id"],
           "space_name": space_name_of(selected or mine["id"]),
           "today": today_row, "history": history,
           "summary": {k: agg[k] for k in ("tickets", "done", "median_min", "rounds", "rework", "cost")},
           "stations": agg["stations"], "repos": repos, "agents": agent_rows(tickets, per_ticket),
           "tickets": active}
    if a.json:
        print(json.dumps(out, ensure_ascii=False))
        return
    print(f"Fenster: letzte {days} Tage · {agg['tickets']} Tickets · Stand {time.strftime('%d.%m. %H:%M')}")
    print(f"{'Ticket':<40} {'Status':<7} {'Durchlauf':>9} {'Runden':>6} {'Nacharbeit':>10} {'Kosten':>7}  Titel")
    for r in active:
        print(f"{r['id']:<40} {r['status']:<7} {dur(r['lead_min']):>9} {r['rounds']:>6} {r['rework']:>10} "
              f"{'$%.2f' % r['cost']:>7}  {r['title']}")
    print("\nStationen (Zeit in der Station)")
    for s in agg["stations"]:
        print(f"  {s['label']:<10} {s['count']:>4}×  Summe {dur(s['sum_min']):>8}  Median {dur(s['median_min'])}")
    print("\nRepos")
    for r in repos:
        print(f"  {r['repo']}")
        print(f"    {r['tickets']} Tickets · {r['done']} erledigt · Median {dur(r['median_min'])} · "
              f"{r['rounds']} Prüfrunden · {r['rework']} Nacharbeit · ${r['cost']:.2f}")
        stations = " · ".join(f"{s['label']} Σ {dur(s['sum_min'])} / Median {dur(s['median_min'])}"
                              for s in r["stations"] if s["count"])
        print(f"    {stations or 'keine Station belegt'}")
    if not repos:
        print("  keine")
    print("\nAgents")
    for r in out["agents"]:
        role = f" ({r['role']})" if r["role"] else ""
        uses = f"{r['tickets']} Einsatz" if r["tickets"] == 1 else f"{r['tickets']} Einsätze"
        print(f"  {r['name']}{role} · {uses} ({r['open']} offen) · ${r['cost']:.2f}")
    if not out["agents"]:
        print("  keine")
    print(f"\nHeute: {today_row['done']} erledigt · Median {dur(today_row['median_min'])} · "
          f"{today_row['rework']} Nacharbeit · ${today_row['cost']:.2f}")
    print("Letzte 7 Tage: " + " · ".join(f"{h['date'][5:]} {h['done']}/{h['rework']}" for h in history)
          + " (erledigt/Nacharbeit)")


# ---- timeline: lanes over time, the data behind the workflow visualiser

SUBAGENTS = os.path.join(APP, "data", "agent-cards", "subagents.jsonl")
CARD_STORE = os.path.join(APP, "data", "agent-cards", "store.json")
TIMELINE_HTML = os.path.join(APP, "data", "orchestra", "timeline.html")
SINCE_UNITS = {"m": 60 * 1000, "h": 60 * 60 * 1000, "d": 24 * 60 * 60 * 1000}


def num_ms(value):
    """Milliseconds from a number or a numeric string, None when it is neither."""
    try:
        return int(float(value))
    except (TypeError, ValueError):
        return None


def since_ms(value):
    """Epoch milliseconds a window starts at (`24h`, `7d`, `1h`, `30m`), None for all."""
    v = (value or "all").strip().lower()
    if v in ("", "all"):
        return None
    m = re.fullmatch(r"(\d+)([mhd])", v)
    if not m or int(m.group(1)) <= 0:
        die("--since erwartet 1h, 30m, 7d oder all")
    return now_ms() - int(m.group(1)) * SINCE_UNITS[m.group(2)]


def identities():
    """The names agent-cards published in shared("agents.identity"), as it persists them."""
    try:
        with open(CARD_STORE, encoding="utf-8") as f:
            raw = json.load(f).get("avatars") or {}
        if isinstance(raw, str):
            raw = json.loads(raw)
        return {str(k): v for k, v in raw.items() if isinstance(v, dict)}
    except (OSError, ValueError, TypeError):
        return {}


def read_subagents():
    """The subagents agent-cards recorded, one JSON object per line; missing is no error."""
    rows = []
    try:
        with open(SUBAGENTS, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return rows
    for line in text.splitlines():
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if not isinstance(row, dict):
            continue
        rows.append({"id": str(row.get("id") or row.get("name") or ""),
                     "title": str(row.get("title") or ""),
                     "started": num_ms(row.get("started")),
                     "ended": num_ms(row.get("ended")),
                     "terminal": str(row.get("terminal") or row.get("parent") or ""),
                     "agent": str(row.get("agent") or "")})
    return rows


def lane_status(info):
    """`working`, `waiting`, `done`, … from hc's status object, else its state."""
    st = (info or {}).get("status")
    if isinstance(st, dict) and st.get("state"):
        return str(st["state"])
    return str((info or {}).get("state") or "")


def ticket_marks(t):
    """The ticket's own status moves as timeline entries (derived, kind `status`).

    They are not written to events.jsonl: the status_log already holds them, and
    copying them would duplicate every move."""
    agent = t.get("agent") or t.get("assignee") or ""
    term = t.get("terminal") or ""
    sid, sname = ticket_space(t), ticket_space_name(t)
    return [{"at": int(sec * 1000), "kind": "status", "ticket": t["id"], "agent": agent,
             "terminal": term, "text": state, "space": sid, "space_name": sname}
            for sec, state in timeline(t)]


def lane(parent_of, ticket, terminal, kind, label, start, end, status, cost, space="", space_name=""):
    return {"id": terminal or kind, "label": label or "—", "kind": kind, "parent": parent_of or "",
            "ticket": ticket or "", "terminal": terminal or "", "start": start, "end": end,
            "status": status or "", "cost": round(float(cost or 0), 2), "events": [], "subagents": [],
            "space": space or "", "space_name": space_name or ""}


def build_timeline(ticket="", since="all", space=None, everyone=False):
    """The lanes and events `hub timeline` prints: one per terminal plus each orchestrator.

    Filtered like every other view: this factory by default, one space with `--space`,
    everything with `--all`. Every lane and event carries its `space`/`space_name`."""
    now, floor = now_ms(), since_ms(since)
    mine = my_space() if space is None else (space_ref(space) or dict(NO_SPACE))
    mine_id = mine["id"]
    all_rows = all_tickets()
    by_id = {t["id"]: t for t in all_rows}
    if ticket:
        tickets = [t for t in all_rows if t["id"] == ticket]
    elif everyone:
        tickets = all_rows
    else:
        tickets = [t for t in all_rows if owns(t, orchestrator_id(), mine_id)]
    events = read_events()
    derived = [m for t in tickets for m in ticket_marks(t)]

    def esp(e):
        """The factory of an event: its own field, else the space its ticket belongs to."""
        sid = e.get("space") or ""
        t = by_id.get(e.get("ticket") or "")
        if not sid and t is not None:
            sid = ticket_space(t)
        sname = e.get("space_name") or (ticket_space_name(t) if t is not None else "") or ""
        if sid and not sname:
            sname = space_name_of(sid)
        return sid, sname

    addresses = []
    for t in tickets:
        for addr in (t.get("terminal"), t.get("review_terminal")):
            if addr and addr not in addresses:
                addresses.append(addr)
    # One `hc ls --all` snapshot feeds every lane; never one `hc get` per ticket.
    snapshot = terminals_all()
    infos = {addr: snapshot.get(addr) or {} for addr in addresses[:100]}
    cost_rows = costs()
    per_ticket, per_terminal = cost_rows.get("tickets") or {}, cost_rows.get("perTerminal") or {}
    ident = identities()
    subagents = read_subagents()
    first = min((e["at"] for e in events + derived), default=now)

    # The orchestrators: one lane per factory that has one. A home without space labels
    # keeps the single lane that carries every entry without a terminal.
    wanted = []
    if not ticket:
        if everyone:
            for s in spaces_of_window():
                addr, info = orchestrator_of(norm_space(s))
                if addr:
                    wanted.append((addr, info, s.get("id") or "", space_name_of(s.get("id") or "")))
        elif mine_id:
            addr, info = orchestrator_of(mine)
            if addr:
                wanted.append((addr, info, mine_id, mine["name"]))
        if not wanted and not any(s.get("id") for s in spaces_of_window()):
            addr = orchestrator_id()
            wanted.append((addr, hc_term(addr) if addr else {}, "", ""))
    lanes, by_terminal, orch_lanes = [], {}, []
    for addr, info, sid, sname in wanted:
        # `hc ls` rows carry no created_ms/finished_ms; one cached `hc get` per
        # orchestrator (at most two lanes) dates the lane instead of the first event.
        got = hc_term(addr) if addr else {}
        state = info.get("state") or got.get("state") or ""
        l = lane("", "", addr, "orchestrator",
                 ((ident.get(addr) or {}).get("name") or info.get("name") or
                  ("Orchestrator" + (f" · {sname}" if sname else ""))),
                 num_ms(info.get("created_ms")) or num_ms(got.get("created_ms")) or first,
                 now if (not info and not got) or state == "live" else
                 (num_ms(info.get("finished_ms")) or num_ms(got.get("finished_ms")) or now),
                 lane_status(got) or lane_status(info) or ("live" if (info or got) else ""),
                 orchestrator_cost(cost_rows, sid), sid, sname)
        lanes.append(l)
        orch_lanes.append(l)
        if addr:
            by_terminal[addr] = l

    for t in tickets:
        marks = ticket_marks(t)
        first_mark = min((m["at"] for m in marks), default=None)
        sid, sname = ticket_space(t), ticket_space_name(t)
        for addr, kind, agent_key in ((t.get("terminal") or "", "agent", t.get("agent") or t.get("assignee") or ""),
                                      (t.get("review_terminal") or "", "reviewer", t.get("reviewer") or "")):
            if not addr or addr in by_terminal:
                continue
            info = infos.get(addr) or {}
            live = info.get("state") == "live"
            start = num_ms(info.get("created_ms")) or first_mark
            end = now if live else (num_ms(info.get("finished_ms")) or
                                    (marks[-1]["at"] if marks else start))
            cost_key = f"{t['id']}|{addr}"
            cost = per_terminal.get(cost_key)
            if cost is None:
                cost = per_ticket.get(t["id"]) if kind == "agent" else 0
            by_terminal[addr] = lane(info.get("parent"), t["id"], addr, kind,
                                     (ident.get(addr) or {}).get("name") or info.get("name") or
                                     agent_name(agent_key) or ("Prüfer" if kind == "reviewer" else "Agent"),
                                     start, end, lane_status(info) or ("" if info else "beendet"), cost,
                                     sid, sname)
            lanes.append(by_terminal[addr])

    # A terminal only the log knows (an agent whose ticket field was cleared) still shows.
    for e in events:
        addr = e["terminal"]
        if not addr or addr in by_terminal or (ticket and e["ticket"] != ticket):
            continue
        sid, sname = esp(e)
        if not everyone and not ticket and mine_id and sid and sid != mine_id:
            continue
        by_terminal[addr] = lane("", e["ticket"], addr, "reviewer" if e["kind"] == "verdict" else "agent",
                                 (ident.get(addr) or {}).get("name") or agent_name(e["agent"]) or addr,
                                 e["at"], e["at"], "", per_ticket.get(e["ticket"]) if e["ticket"] else 0,
                                 sid, sname)
        lanes.append(by_terminal[addr])

    # Parents point at lane ids, not at raw terminal addresses.
    ids = {l["terminal"]: l["id"] for l in lanes if l["terminal"]}
    for l in lanes:
        if l["parent"] in by_terminal:
            l["parent"] = by_terminal[l["parent"]]["id"]
        elif l["parent"] in ids:
            l["parent"] = ids[l["parent"]]

    everything = sorted(events + derived, key=lambda e: e["at"])
    for e in everything:
        e["space"], e["space_name"] = esp(e)
    if floor is not None:
        everything = [e for e in everything if e["at"] >= floor]
    if ticket:
        everything = [e for e in everything if e["ticket"] == ticket]
    elif not everyone and mine_id:
        everything = [e for e in everything if not e["space"] or e["space"] == mine_id]
    kept = []
    for l in lanes:
        if ticket and l["ticket"] != ticket and l["kind"] != "orchestrator":
            continue
        if ticket and l in orch_lanes:
            continue
        if floor is not None and l not in orch_lanes and (l["end"] or l["start"] or 0) < floor:
            continue
        # The window starts at `since`: a lane that began earlier is cut there, so no bar
        # reaches left of the window. Events and subagents outside it are dropped.
        if floor is not None:
            l["start"] = max(l["start"] or floor, floor)
            if l["end"] is not None:
                l["end"] = max(l["end"], floor)
        if l["kind"] == "orchestrator":
            l["events"] = [e for e in everything
                           if (not e["terminal"] or e["terminal"] == l["terminal"])
                           and (not l["space"] or not e["space"] or e["space"] == l["space"])]
        else:
            l["events"] = [e for e in everything if l["terminal"] and e["terminal"] == l["terminal"]]
        l["subagents"] = []
        for s in subagents:
            if not (l["terminal"] and s["terminal"] == l["terminal"]):
                continue
            if floor is not None and (s["ended"] or s["started"] or 0) < floor:
                continue
            started = s["started"]
            if floor is not None and started is not None:
                started = max(started, floor)
            l["subagents"].append({"id": s["id"], "title": s["title"], "started": started,
                                   "ended": s["ended"]})
        kept.append(l)
    kept.sort(key=lambda l: (l["kind"] != "orchestrator", l["space"].casefold(),
                             l["start"] is None, l["start"] or 0, l["label"].casefold()))
    return {"now": now, "since": floor or 0, "space": mine_id,
            "space_name": space_name_of(mine_id), "lanes": kept, "events": everything}


def stamp_ms(ms):
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(ms / 1000)) if ms else "—"


def timeline_html(report):
    """A self-contained table with a bar per lane; no script, no external resource."""
    lanes = report["lanes"]
    now = report["now"]
    starts = [l["start"] for l in lanes if l["start"]]
    ends = [l["end"] for l in lanes if l["end"]] + [now]
    t0, t1 = (min(starts) if starts else now), max(ends)
    span = max(1, t1 - t0)
    rows = []
    for l in lanes:
        start, end = l["start"] or t0, l["end"] or now
        left = max(0.0, (start - t0) / span * 100)
        width = min(100.0 - left, max(1.0, (end - start) / span * 100))
        minutes = max(0.0, (end - start) / 60000)
        rows.append(
            f"<tr class=\"{html.escape(l['kind'])}\"><td>{html.escape(l['label'])}</td>"
            f"<td>{html.escape(l['ticket'] or '—')}</td>"
            f"<td>{html.escape(stamp_ms(l['start']))}</td>"
            f"<td>{html.escape(stamp_ms(l['end']))}</td>"
            f"<td class=\"num\">{html.escape(dur(minutes))}</td>"
            f"<td>{html.escape(l['status'] or '—')}</td>"
            f"<td>{html.escape(l['parent'] or '—')}</td>"
            f"<td class=\"num\">${l['cost']:.2f}</td>"
            f"<td class=\"bar\"><span style=\"left:{left:.2f}%;width:{width:.2f}%\"></span></td></tr>")
    return (
        "<!doctype html>\n<html lang=\"de\"><meta charset=\"utf-8\">\n"
        "<title>Herdr Timeline</title>\n<style>\n"
        "body{font:14px/1.45 system-ui,sans-serif;margin:24px;color:#222;background:#fff}\n"
        "h1{font-size:18px;margin:0 0 4px}p{color:#666;margin:0 0 18px}\n"
        "table{border-collapse:collapse;width:100%}\n"
        "th,td{text-align:left;padding:5px 8px;border-bottom:1px solid #e6e6e6;white-space:nowrap}\n"
        "th{font-size:12px;text-transform:uppercase;color:#666}\n"
        ".num{text-align:right}\n"
        "td.bar{width:32%;min-width:160px}\n"
        "td.bar span{display:block;height:10px;border-radius:5px;position:relative;min-width:2px}\n"
        ".orchestrator td.bar span{background:#8b5cf6}\n"
        ".agent td.bar span{background:#3b82f6}\n"
        ".reviewer td.bar span{background:#f59e0b}\n"
        ".subagent td.bar span{background:#10b981}\n"
        "</style>\n<h1>Timeline</h1>\n"
        f"<p>{len(lanes)} Lanes · {html.escape(stamp_ms(t0))} bis {html.escape(stamp_ms(t1))}</p>\n"
        "<table><thead><tr><th>Lane</th><th>Ticket</th><th>Start</th><th>Ende</th><th>Dauer</th>"
        "<th>Status</th><th>Parent</th><th>Kosten</th><th>Verlauf</th></tr></thead><tbody>\n"
        + "\n".join(rows) + "\n</tbody></table>\n</html>\n")


def cmd_timeline(a):
    if a.ticket:
        load(a.ticket)  # an unknown or broken id dies here, with a readable message
    selected = space_arg(a)
    report = build_timeline(a.ticket, a.since, space=selected, everyone=a.all)
    path = ""
    if a.write:
        os.makedirs(os.path.dirname(TIMELINE_HTML), exist_ok=True)
        tmp = TIMELINE_HTML + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(timeline_html(report))
        os.replace(tmp, TIMELINE_HTML)
        path = TIMELINE_HTML
    if a.json:
        print(json.dumps(report, ensure_ascii=False))
        if path:
            sys.stderr.write(f"{path}\n")
        return
    for l in report["lanes"]:
        minutes = max(0.0, ((l["end"] or report["now"]) - (l["start"] or report["now"])) / 60000)
        print(f"{stamp_ms(l['start'])}–{stamp_ms(l['end'])}  {dur(minutes):>8}  "
              f"{l['ticket'] or '—':<40} {l['label']:<22} {l['status'] or '—':<9} {l['parent'] or '—'}")
    if path:
        print(path)


