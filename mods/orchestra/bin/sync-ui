#!/usr/bin/env bash
# Kopiert mods/orchestra/ui.js in alle anderen `mods/*/ui.js`. Herdr kennt kein Modul
# über Mod-Ordner hinweg, deshalb hält jeder Mod eine byte-identische Kopie; geändert
# wird nur die Quelle, danach dieses Skript. Mods ohne Kopie bleiben unberührt.
#
#   mods/orchestra/bin/sync-ui
#   .herdr/verify.sh              prüft, dass alle Kopien gleich sind
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
SRC="$ROOT/mods/orchestra/ui.js"
[ -f "$SRC" ] || { echo "sync-ui: $SRC fehlt" >&2; exit 1; }

copied=0
for dst in "$ROOT"/mods/*/ui.js; do
  [ "$dst" = "$SRC" ] && continue
  cp "$SRC" "$dst"
  copied=$((copied + 1))
done
echo "sync-ui: $copied Kopien aus mods/orchestra/ui.js"
