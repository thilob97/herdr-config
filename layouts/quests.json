{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "toast": "toast-review",
  "theme": { "light": "paper", "dark": "elric" },
  "traffic_lights": [12, 16],
  "preview": "layouts/quests.svg",
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 268 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        { "id": "brand", "type": "block", "content": { "mod": "workspace-chrome" }, "size": { "px": 46 }, "window_drag": true },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            { "id": "spaces", "type": "block", "content": { "mod": "space-folders" }, "size": { "weight": 1 }, "min": 90 },
            { "id": "agents", "type": "block", "content": { "mod": "agent-cards" }, "size": { "weight": 1 }, "min": 90 }
          ]
        },
        { "id": "sidebar-footer", "type": "block", "content": { "mod": "sidebar-footer", "props": { "footer": true } }, "size": { "px": 125 } }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        { "id": "quests-bar", "type": "block", "content": { "mod": "quests", "props": { "view": "bar" } }, "size": { "px": 42 }, "window_drag": true },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "children": [
            { "id": "quests-page", "type": "block", "content": { "mod": "quests", "props": { "view": "page" } } }
          ]
        },
        {
          "id": "status-row",
          "type": "row",
          "size": { "px": 28 },
          "resizable": false,
          "children": [
            { "id": "status", "type": "block", "size": { "weight": 1 }, "content": { "mod": "status-bar" } }
          ]
        }
      ]
    }
  ]
}
