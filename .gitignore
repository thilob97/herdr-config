# Nur eigene Config tracken; alles von Herdr Geschriebene ignorieren.
/*
!/README.md
!/.gitignore
!/programs.json
!/settings.json
!/keys.json
!/themes/
!/layouts/
/layouts/.state/
!/mods/

# Von Herdr ausgeliefert, wird bei jedem Start ueberschrieben
/layouts/main.json
/layouts/terminals.json
/layouts/win98.*
/themes/atom-one-dark.json
/themes/win98.json
/mods/agents/
/mods/changes/
/mods/confirm/
/mods/files/
/mods/help/
/mods/machine-add/
/mods/menu/
/mods/new-menu/
/mods/pane/
/mods/peek/
/mods/picker/
/mods/prompt/
/mods/spaces/
/mods/tabs/
/mods/terminals-bar/
/mods/terminals-pane/
/mods/toast/
/mods/win98/
/mods/workspace-chrome/
/mods/workspace-status/
/mods/worktree/
/layouts/*.old-*
*.reset-*
*.error
